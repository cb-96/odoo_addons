<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_federation" model="ir.module.category">
        <field name="name">Sports Federation</field>
        <field name="description">Sports Federation Management</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_federation_user" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_federation_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_federation_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!--
        The normal manager group owns day-to-day federation work.  Advanced
        navigation is deliberately opt-in so installing another domain addon
        does not put its raw records in every operator's menu.  ACLs and model
        actions remain unchanged: this group controls discoverability only.
    -->
    <record id="group_federation_advanced_operator" model="res.groups">
        <field name="name">Advanced Federation Tools</field>
        <field name="implied_ids" eval="[(4, ref('group_federation_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>