<odoo>
  <record id="view_federation_retention_policy_list" model="ir.ui.view"><field name="name">federation.retention.policy.list</field><field name="model">federation.retention.policy</field><field name="arch" type="xml"><list decoration-success="health == 'healthy'" decoration-warning="health in ('attention','overdue')" decoration-danger="health == 'never_run'"><field name="name"/><field name="source_model"/><field name="expected_interval_hours"/><field name="policy_version"/><field name="health" widget="badge"/><field name="latest_success_on"/><field name="health_message"/><button name="action_open_evidence" type="object" string="Evidence"/></list></field></record>
  <record id="view_federation_retention_policy_search" model="ir.ui.view"><field name="name">federation.retention.policy.search</field><field name="model">federation.retention.policy</field><field name="arch" type="xml"><search><field name="name"/><field name="code"/><filter name="needs_attention" string="Needs Attention" domain="[('health','in',('attention','overdue','never_run'))]"/></search></field></record>
  <record id="action_federation_retention_policy" model="ir.actions.act_window"><field name="name">Retention and Recovery</field><field name="res_model">federation.retention.policy</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_federation_retention_policy_search"/></record>
  <record id="view_federation_retention_evidence_list" model="ir.ui.view"><field name="name">federation.retention.evidence.list</field><field name="model">federation.retention.evidence</field><field name="arch" type="xml"><list decoration-danger="status == 'failed'" decoration-warning="skipped_count or failure_count"><field name="policy"/><field name="status" widget="badge"/><field name="completed_on"/><field name="duration_seconds"/><field name="candidate_count"/><field name="deleted_count"/><field name="skipped_count"/><field name="attachment_count"/><field name="failure_count"/><field name="dry_run"/><field name="correlation_id"/></list></field></record>
  <record id="view_federation_retention_evidence_search" model="ir.ui.view"><field name="name">federation.retention.evidence.search</field><field name="model">federation.retention.evidence</field><field name="arch" type="xml"><search><field name="policy"/><field name="correlation_id"/><filter name="failed" string="Failed" domain="[('status','=','failed')]"/><filter name="exceptions" string="Skipped or Failed Records" domain="['|',('skipped_count','>',0),('failure_count','>',0)]"/></search></field></record>
  <record id="action_federation_retention_evidence" model="ir.actions.act_window"><field name="name">Retention Evidence</field><field name="res_model">federation.retention.evidence</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_federation_retention_evidence_search"/></record>
  <menuitem id="menu_federation_retention_policy" name="Retention and Recovery" parent="sports_federation_base.menu_federation_administration" action="action_federation_retention_policy" sequence="80" groups="sports_federation_base.group_federation_manager"/>
  <menuitem id="menu_federation_retention_evidence" name="Retention Evidence" parent="sports_federation_base.menu_federation_administration" action="action_federation_retention_evidence" sequence="81" groups="sports_federation_base.group_federation_manager"/>
</odoo>
