#. The sport. Do not translate; in Dutch 'trefbal' is a different game.
msgid "dodgeball"
msgstr "dodgeball"

#. The organisation that runs the competitions.
msgid "federation"
msgstr "federatie"

#. A member club of the federation.
msgid "club"
msgstr "club"

#. A person who acts for a club in the portal.
msgid "club representative"
msgstr "clubvertegenwoordiger"

#. A person responsible for one team of a club.
msgid "team manager"
msgstr "ploegverantwoordelijke"

#. A club's team that enters competitions.
msgid "team"
msgstr "ploeg"

#. A licensed member who plays for a team.
msgid "player"
msgstr "speler"

#. A recurring competition, for example a national league.
msgid "competition"
msgstr "competitie"

#. One season's run of a competition.
msgid "edition"
msgstr "editie"

#. A group within a competition, for example men, women or mixed.
msgid "division"
msgstr "reeks"

#. The sporting year that registrations and rosters belong to.
msgid "season"
msgstr "seizoen"

#. A team's registration with the federation for a season.
msgid "season registration"
msgstr "seizoensinschrijving"

#. A team's entry into a competition division.
msgid "competition entry"
msgstr "inschrijving (voor een competitie)"

#. A team's group of players for the season. Not the players of one game day.
msgid "roster"
msgstr "selectie"

#. The players a team brings to one game day, chosen from the roster.
msgid "line-up"
msgstr "opstelling"

#. A day at one venue on which several matches are played.
msgid "game day"
msgstr "speeldag"

#. One game between two teams.
msgid "match"
msgstr "wedstrijd"

#. A part of a match; sets can be won, lost or drawn.
msgid "set"
msgstr "set"

#. The playing area at a venue where a match is played.
msgid "court"
msgstr "veld"

#. The sports hall or location of a game day.
msgid "venue"
msgstr "locatie"

#. Which match is played when and on which court.
msgid "schedule"
msgstr "kalender"

#. The official, approved version of a game day's schedule.
msgid "published schedule"
msgstr "gepubliceerde kalender"

#. The final score of a match.
msgid "result"
msgstr "uitslag"

#. The ranking table of a division.
msgid "standings"
msgstr "klassement"

#. The printed or digital form on which a match is recorded.
msgid "score sheet"
msgstr "wedstrijdblad"

#. A person who officiates a match: referee, line judge, table official.
msgid "official"
msgstr "official"

#. The official in charge of a match.
msgid "referee"
msgstr "scheidsrechter"

#. An official's task that a club must staff with its own people.
msgid "club duty"
msgstr "clubdienst"

#. Whether a player may play, by licence, age, suspension and rules.
msgid "eligibility"
msgstr "speelgerechtigdheid"

#. A guardian's signed consent for a player under the age limit.
msgid "parental approval"
msgstr "ouderlijke toestemming"

#. A player's answer whether they can play on a game day.
msgid "player availability"
msgstr "beschikbaarheid"

#. A bill from the federation to a club.
msgid "invoice"
msgstr "factuur"

#. The website where clubs, players and officials do their work.
msgid "portal"
msgstr "portaal"

#. The portal home page.
msgid "overview"
msgstr "overzicht"
