<odoo>
  <record id="ir_cron_communication_dispatch" model="ir.cron"><field name="name">Federation: Dispatch participant communications</field><field name="model_id" ref="model_federation_communication_delivery"/><field name="state">code</field><field name="code">model._cron_dispatch()</field><field name="user_id" ref="base.user_root"/><field name="interval_number">1</field><field name="interval_type">minutes</field><field name="active" eval="True"/></record>
  <record id="ir_cron_communication_digests" model="ir.cron"><field name="name">Federation: Due-soon work and participant digests</field><field name="model_id" ref="model_federation_notification_log"/><field name="state">code</field><field name="code">model.env['federation.notification.service']._cron_action_digests()</field><field name="user_id" ref="base.user_root"/><field name="interval_number">1</field><field name="interval_type">hours</field><field name="active" eval="True"/></record>
</odoo>
