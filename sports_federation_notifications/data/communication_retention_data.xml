<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="retention_policy_participant_inbox" model="federation.retention.policy">
    <field name="name">Participant Inbox</field>
    <field name="code">participant_inbox</field>
    <field name="source_model">federation.communication.receipt</field>
    <field name="expected_interval_hours">24</field>
  </record>
  <record id="ir_cron_participant_inbox_retention" model="ir.cron">
    <field name="name">Federation: Participant inbox retention</field>
    <field name="model_id" ref="model_federation_communication_receipt"/>
    <field name="state">code</field>
    <field name="code">model._cron_purge_inbox()</field>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="active" eval="True"/>
  </record>
</odoo>
