<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="communication_receipt_outcome_list" model="ir.ui.view">
    <field name="name">communication.receipt.outcome.list</field>
    <field name="model">federation.communication.receipt</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0"
            decoration-danger="lifecycle_state == 'failed'"
            decoration-warning="lifecycle_state == 'seen'"
            decoration-success="lifecycle_state == 'acted'"
            decoration-muted="lifecycle_state in ('expired', 'superseded')">
        <field name="name"/>
        <field name="kind"/>
        <field name="recipient_id"/>
        <field name="available_on"/>
        <field name="lifecycle_state" widget="badge"/>
        <field name="seen_on" optional="show"/>
        <field name="acted_on" optional="show"/>
        <field name="expired_on" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="communication_receipt_outcome_search" model="ir.ui.view">
    <field name="name">communication.receipt.outcome.search</field>
    <field name="model">federation.communication.receipt</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="recipient_id"/>
        <filter name="open" string="Still open" domain="[('lifecycle_state', 'not in', ('acted', 'expired', 'superseded'))]"/>
        <filter name="seen_unresolved" string="Seen, not resolved" domain="[('lifecycle_state', '=', 'seen')]"/>
        <filter name="failed" string="Delivery failed" domain="[('lifecycle_state', '=', 'failed')]"/>
        <filter name="acted" string="Acted upon" domain="[('lifecycle_state', '=', 'acted')]"/>
        <filter name="expired" string="Expired" domain="[('lifecycle_state', '=', 'expired')]"/>
        <group>
          <filter name="group_state" string="Outcome" context="{'group_by': 'lifecycle_state'}"/>
          <filter name="group_kind" string="Kind" context="{'group_by': 'kind'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="communication_receipt_outcome_pivot" model="ir.ui.view">
    <field name="name">communication.receipt.outcome.pivot</field>
    <field name="model">federation.communication.receipt</field>
    <field name="arch" type="xml">
      <pivot>
        <field name="kind" type="row"/>
        <field name="lifecycle_state" type="col"/>
      </pivot>
    </field>
  </record>
  <record id="action_communication_receipt_outcome" model="ir.actions.act_window">
    <field name="name">Notification outcomes</field>
    <field name="res_model">federation.communication.receipt</field>
    <field name="view_mode">list,pivot</field>
    <field name="search_view_id" ref="communication_receipt_outcome_search"/>
    <field name="context">{'search_default_open': 1}</field>
  </record>
  <menuitem id="menu_communication_receipt_outcome" name="Notification outcomes"
            parent="menu_federation_notifications" action="action_communication_receipt_outcome"
            groups="sports_federation_base.group_federation_manager" sequence="20"/>
</odoo>
