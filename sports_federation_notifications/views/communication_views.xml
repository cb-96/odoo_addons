<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="communication_status" name="Notification status">
    <dl class="row"><dt class="col-sm-3">Inbox available</dt><dd class="col-sm-9"><span t-field="receipt.available_on"/></dd>
      <dt class="col-sm-3">Email delivery</dt><dd class="col-sm-9"><t t-if="not deliveries">Awaiting digest or inbox only</t><p t-foreach="deliveries" t-as="delivery" class="mb-1"><t t-esc="delivery[1]"/></p></dd>
      <dt class="col-sm-3">Acknowledgement</dt><dd class="col-sm-9"><span t-if="receipt.acknowledged_on" t-field="receipt.acknowledged_on"/><t t-else="">Not acknowledged</t></dd>
      <dt class="col-sm-3">Underlying task</dt><dd class="col-sm-9"><t t-esc="info['task_state']"/></dd>
      <dt t-if="info.get('deadline')" class="col-sm-3">Deadline (UTC)</dt><dd t-if="info.get('deadline')" class="col-sm-9"><t t-esc="info['deadline']"/></dd><dt class="col-sm-3">Next owner</dt><dd class="col-sm-9"><t t-esc="info['owner']"/></dd>
    </dl><p class="small text-muted">Email acceptance is not proof of external-provider delivery or reading. Acknowledgement does not approve evidence, fill a coverage gap or complete the task.</p>
  </template>
  <template id="communication_inbox" name="Participant notification inbox"><t t-call="portal.portal_layout"><main class="container py-4">
    <h1>Notifications</h1><p>Changes, deadlines and corrections for your current responsibilities.</p>
    <nav class="d-flex gap-2 flex-wrap mb-3" aria-label="Notification filters"><a href="/my/notifications?status=all" class="btn btn-outline-primary">All</a><a href="/my/notifications?status=unacknowledged" class="btn btn-outline-primary">Not acknowledged</a><a href="/my/notifications?status=acknowledged" class="btn btn-outline-primary">Acknowledged</a><a href="/my/notifications/preferences" class="btn btn-outline-secondary">Preferences</a><a href="/my/work" class="btn btn-outline-secondary">My work</a></nav>
    <p t-if="not items" class="alert alert-info">No notifications are visible in this filter. This does not certify that all tasks are complete.</p>
    <article t-foreach="items" t-as="item" class="card mb-3" t-att-data-notification="item['receipt'].id"><div class="card-body"><h2 class="h5"><t t-esc="item['info']['title']"/> <span t-if="item['receipt'].urgent" class="badge text-bg-warning">Urgent change</span></h2><p style="white-space: pre-line"><t t-esc="item['info']['detail']"/></p><p><strong>Next action:</strong> <t t-esc="item['info']['next_action']"/></p><p><strong>Next owner:</strong> <t t-esc="item['info']['owner']"/></p><a t-attf-href="/my/notifications/#{item['receipt'].id}/open" class="btn btn-primary">Open relevant task</a><a t-attf-href="/my/notifications/#{item['receipt'].id}" class="btn btn-outline-secondary ms-2">Delivery and acknowledgement</a></div></article>
    <t t-call="portal.pager"/>
  </main></t></template>
  <template id="communication_detail" name="Participant notification detail"><t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/notifications" class="btn btn-outline-secondary mb-3">Back to notifications</a><h1><t t-esc="info['title']"/></h1><p style="white-space: pre-line"><t t-esc="info['detail']"/></p><p><strong>Next action:</strong> <t t-esc="info['next_action']"/></p><t t-call="sports_federation_notifications.communication_status"/><a t-attf-href="/my/notifications/#{receipt.id}/open" class="btn btn-primary mb-3">Open relevant task</a><form t-if="not receipt.acknowledged_on" t-attf-action="/my/notifications/#{receipt.id}/acknowledge" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button class="btn btn-outline-primary" type="submit">Acknowledge receipt, not task completion</button></form></main></t></template>
  <template id="communication_preferences" name="Participant notification preferences"><t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/notifications" class="btn btn-outline-secondary mb-3">Back to notifications</a><h1>Notification preferences</h1><p>Every authorised notification remains available in your inbox. Choose email promptly, one daily digest after 08:00 in your account timezone, or inbox only. Urgent changes remain immediate in the inbox even when email is disabled.</p><p t-if="saved" role="status" class="alert alert-success">Preferences saved. Queued email is rechecked before sending. Previously sent email cannot be recalled.</p><p t-if="error" role="alert" class="alert alert-danger"><t t-esc="error"/></p><form method="post" action="/my/notifications/preferences"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div t-foreach="rows" t-as="row" class="mb-3"><label t-att-for="row['kind']" class="form-label"><t t-esc="row['label']"/></label><select t-att-id="row['kind']" t-att-name="row['kind']" class="form-select"><option value="immediate" t-att-selected="row['mode'] == 'immediate'">Email promptly</option><option value="digest" t-att-selected="row['mode'] == 'digest'">Daily digest</option><option value="inbox" t-att-selected="row['mode'] == 'inbox'">Inbox only</option></select></div><button type="submit" class="btn btn-primary">Save preferences</button></form></main></t></template>
  <template id="communication_schedule" name="Current notified schedule"><t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/notifications" class="btn btn-outline-secondary mb-3">Back to notifications</a><h1><t t-esc="day.name"/></h1><p><t t-esc="info['detail']"/></p><div class="table-responsive"><table class="table"><thead><tr><th>Match</th><th>Court</th><th>Start (UTC)</th><th>End (UTC)</th></tr></thead><tbody><tr t-foreach="rows" t-as="row"><td><t t-esc="row['match']"/></td><td><t t-esc="row['court']"/></td><td><t t-esc="row['start']"/></td><td><t t-esc="row['end']"/></td></tr></tbody></table></div></main></t></template>
  <template id="communication_portal_entry" inherit_id="portal.portal_my_home"><xpath expr="//div[hasclass('o_portal_docs')]" position="before"><a href="/my/notifications" class="btn btn-outline-primary my-3">Federation notifications</a></xpath></template>
  <template id="communication_work_entry" inherit_id="sports_federation_portal.role_home"><xpath expr="//h1" position="after"><a href="/my/notifications" class="btn btn-outline-primary mb-3">Notifications and preferences</a></xpath></template>
  <record id="communication_delivery_list" model="ir.ui.view"><field name="name">communication.delivery.list</field><field name="model">federation.communication.delivery</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="name"/><field name="recipient_id"/><field name="state"/><field name="attempts"/><field name="escalated_on"/><field name="accepted_on"/></list></field></record>
  <record id="communication_delivery_form" model="ir.ui.view"><field name="name">communication.delivery.form</field><field name="model">federation.communication.delivery</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_retry_delivery" type="object" string="Retry delivery only" class="btn-primary" invisible="state != 'failed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="recipient_id"/><field name="delivery_key"/><field name="attempts"/><field name="next_attempt_on"/><field name="accepted_on"/><field name="escalated_on"/><field name="mail_id"/><field name="log_id"/><field name="failure_note"/><field name="receipt_ids" widget="many2many_tags"/></group><p>Recovery reuses the outbound delivery. Never repeat the business action to resend a notification.</p></sheet><chatter/></form></field></record>
  <record id="communication_delivery_action" model="ir.actions.act_window"><field name="name">Participant delivery recovery</field><field name="res_model">federation.communication.delivery</field><field name="view_mode">list,form</field></record>
  <menuitem id="communication_delivery_menu" name="Participant delivery recovery" action="communication_delivery_action" groups="sports_federation_base.group_federation_manager"/>
</odoo>
