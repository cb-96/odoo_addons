<odoo>
  <record id="communication_receipt_own" model="ir.rule"><field name="name">Own participant notifications</field><field name="model_id" ref="model_federation_communication_receipt"/><field name="domain_force">[(1, "=", 1)] if user.has_group("sports_federation_base.group_federation_manager") else [("recipient_id", "=", user.id)]</field></record>
  <record id="communication_preference_own" model="ir.rule"><field name="name">Own notification preferences</field><field name="model_id" ref="model_federation_communication_preference"/><field name="domain_force">[("user_id", "=", user.id)]</field></record>
  <record id="communication_delivery_own" model="ir.rule"><field name="name">Own delivery status or authorised manager recovery</field><field name="model_id" ref="model_federation_communication_delivery"/><field name="domain_force">[(1, "=", 1)] if user.has_group("sports_federation_base.group_federation_manager") else [("recipient_id", "=", user.id)]</field></record>
<record id="communication_log_visibility" model="ir.rule"><field name="name">Participant delivery logs respect recipient scope</field><field name="model_id" ref="model_federation_notification_log"/><field name="domain_force">[(1, "=", 1)] if user.has_group("sports_federation_base.group_federation_manager") else [("recipient_partner_id", "=", user.partner_id.id)]</field></record>
</odoo>
