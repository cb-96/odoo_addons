<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_club_duty_live_run_list" model="ir.ui.view">
        <field name="name">federation.club.duty.live.run.list</field>
        <field name="model">federation.club.duty.live.run</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="applied_on"/>
                <field name="matchday_id"/>
                <field name="schedule_id"/>
                <field name="duty_count"/>
                <field name="policy_id"/>
                <field name="applied_by_id"/>
                <field name="state" widget="badge" decoration-muted="state == 'rolled_back'"/>
            </list>
        </field>
    </record>

    <record id="view_club_duty_live_run_form" model="ir.ui.view">
        <field name="name">federation.club.duty.live.run.form</field>
        <field name="model">federation.club.duty.live.run</field>
        <field name="arch" type="xml">
            <form string="Live Club-Duty Allocation" create="0" edit="0" delete="0">
                <header>
                    <button name="action_rollback" type="object" string="Roll back"
                            invisible="state != 'applied'"
                            confirm="Remove the open duties this allocation created? Clubs that were already notified are not informed automatically."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="state != 'applied' or not rollback_blockers">
                        <field name="rollback_blockers"/>
                    </div>
                    <group>
                        <group>
                            <field name="schedule_id"/>
                            <field name="matchday_id"/>
                            <field name="publication_ref"/>
                            <field name="policy_id"/>
                            <field name="policy_version"/>
                        </group>
                        <group>
                            <field name="applied_by_id"/>
                            <field name="applied_on"/>
                            <field name="rolled_back_by_id" invisible="state != 'rolled_back'"/>
                            <field name="rolled_back_on" invisible="state != 'rolled_back'"/>
                        </group>
                    </group>
                    <field name="duty_ids">
                        <list>
                            <field name="match_id"/>
                            <field name="club_id"/>
                            <field name="role"/>
                            <field name="state"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_club_duty_live_run" model="ir.actions.act_window">
        <field name="name">Live Club-Duty Allocations</field>
        <field name="res_model">federation.club.duty.live.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_club_duty_live_run"
              name="Live Duty Allocations"
              parent="sports_federation_officiating.menu_federation_officiating"
              action="action_club_duty_live_run"
              groups="sports_federation_base.group_federation_manager"
              sequence="37"/>

    <record id="view_schedule_form_planning_history" model="ir.ui.view">
        <field name="name">federation.schedule.form.planning.history</field>
        <field name="model">federation.schedule</field>
        <field name="inherit_id" ref="sports_federation_scheduling.schedule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Planning history" name="club_duty_planning_history" groups="sports_federation_base.group_federation_manager">
                    <separator string="Planning runs"/>
                    <field name="club_duty_plan_run_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="create_date" string="Prepared"/>
                            <field name="plan_type"/>
                            <field name="state"/>
                            <field name="create_uid" string="By"/>
                        </list>
                    </field>
                    <separator string="Duties added to the published schedule"/>
                    <field name="club_duty_live_run_ids" readonly="1">
                        <list create="0" delete="0">
                            <field name="applied_on"/>
                            <field name="duty_count"/>
                            <field name="policy_id"/>
                            <field name="applied_by_id"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
