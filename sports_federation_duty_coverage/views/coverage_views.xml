<odoo>
 <record id="coverage_list" model="ir.ui.view"><field name="name">federation.match.duty.coverage.list</field><field name="model">federation.match</field><field name="arch" type="xml">
  <list create="0" edit="0" delete="0" default_order="date_scheduled,id" decoration-danger="coverage_state == 'uncovered'" decoration-warning="coverage_state in ('unchecked','needs_action')" decoration-success="coverage_state == 'ready'">
   <field name="coverage_kickoff"/><field name="name"/><field name="tournament_id"/><field name="coverage_state" widget="badge"/><field name="coverage_required"/><field name="coverage_assigned"/><field name="coverage_accepted"/><field name="coverage_eligible"/><field name="coverage_present"/><field name="coverage_completed"/><field name="coverage_owner_id"/><field name="coverage_response_deadline"/>
   <button name="action_open_coverage" type="object" string="Resolve coverage" groups="sports_federation_base.group_federation_manager"/>
  </list>
 </field></record>
 <record id="coverage_search" model="ir.ui.view"><field name="name">federation.match.duty.coverage.search</field><field name="model">federation.match</field><field name="arch" type="xml"><search><field name="name"/><field name="tournament_id"/><field name="coverage_owner_id"/>
  <filter name="uncovered" string="Uncovered" domain="[('coverage_state','=','uncovered')]"/><filter name="needs_action" string="Needs action" domain="[('coverage_state','=','needs_action')]"/><filter name="unchecked" string="Not checked" domain="[('coverage_state','=','unchecked')]"/>
  <filter name="no_owner" string="No coordinator" domain="[('coverage_owner_id','=',False)]"/>
  <group><filter name="by_division" string="Division" context="{'group_by':'tournament_id'}"/><filter name="by_day" string="Day" context="{'group_by':'date_scheduled:day'}"/></group>
 </search></field></record>
 <record id="coverage_form" model="ir.ui.view"><field name="name">federation.match.duty.coverage.form</field><field name="model">federation.match</field><field name="priority">90</field><field name="arch" type="xml">
  <form create="0" delete="0"><header><button name="action_resolve_coverage" type="object" string="Resolve / replace" class="oe_highlight" groups="sports_federation_base.group_federation_manager"/><button name="action_refresh_coverage" type="object" string="Refresh and reconcile reminders" groups="sports_federation_base.group_federation_manager"/></header><sheet>
   <h1><field name="name" readonly="1"/></h1><group><field name="coverage_kickoff" readonly="1"/><field name="tournament_id" readonly="1"/><field name="schedule_publication_id" readonly="1"/><field name="operational_slot_id" readonly="1"/><field name="coverage_state" readonly="1"/><field name="coverage_owner_id"/></group>
   <div class="alert alert-info">Assigned, accepted, eligible, present and completed are separate facts. Accepted and eligible does not mean present.</div>
   <group col="6"><field name="coverage_required"/><field name="coverage_assigned"/><field name="coverage_accepted"/><field name="coverage_eligible"/><field name="coverage_present"/><field name="coverage_completed"/></group><field name="coverage_blockers" readonly="1"/>
   <notebook><page string="Assignments"><field name="referee_assignment_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="referee_id"/><field name="role"/><field name="state"/><field name="coverage_accepted"/><field name="coverage_eligible"/><field name="coverage_present"/><field name="coverage_feedback"/><field name="replaces_id"/>
    <button name="action_mark_present" type="object" string="Present" invisible="state not in ('confirmed','done') or coverage_present" groups="sports_federation_base.group_federation_manager"/><button name="action_done" type="object" string="Complete" invisible="state != 'confirmed' or not coverage_present" groups="sports_federation_base.group_federation_manager"/>
   </list></field></page>
   <page string="Club nominations"><field name="club_referee_duty_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="club_id"/><field name="role"/><field name="state"/><field name="nominated_player_id"/><field name="assignment_id"/><field name="coverage_deadline"/><field name="coverage_feedback"/></list></field></page>
   <page string="Requirements and deadlines"><group><field name="coverage_override"/><field name="coverage_head_required" invisible="not coverage_override"/><field name="coverage_assistant_1_required" invisible="not coverage_override"/><field name="coverage_assistant_2_required" invisible="not coverage_override"/><field name="coverage_fourth_required" invisible="not coverage_override"/><field name="coverage_table_required" invisible="not coverage_override"/><field name="coverage_nomination_hours"/><field name="coverage_response_hours"/><field name="coverage_nomination_deadline"/><field name="coverage_response_deadline"/><field name="coverage_escalated_on"/></group></page></notebook>
  </sheet><chatter/></form>
 </field></record>
 <record id="coverage_action" model="ir.actions.act_window"><field name="name">Duty coverage board</field><field name="res_model">federation.match</field><field name="view_mode">list,form</field><field name="view_id" ref="coverage_list"/><field name="search_view_id" ref="coverage_search"/><field name="domain">[('state','!=','cancelled')]</field><field name="help" type="html"><p>Every match is included, even when it has no assignments. Open a match to resolve coverage.</p></field></record>
 <record id="coverage_action_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="coverage_form"/><field name="act_window_id" ref="coverage_action"/></record>
 <menuitem id="coverage_menu" name="Duty coverage board" parent="sports_federation_officiating.menu_federation_officiating" action="coverage_action" sequence="1" groups="sports_federation_base.group_federation_manager"/>
 <record id="coverage_matchday_link" model="ir.ui.view"><field name="name">federation.matchday.coverage.link</field><field name="model">federation.matchday</field><field name="inherit_id" ref="sports_federation_calendar.matchday_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_open_duty_coverage" type="object" string="Duty coverage" groups="sports_federation_base.group_federation_manager"/></xpath></field></record>
 <record id="coverage_edition_link" model="ir.ui.view"><field name="name">federation.edition.coverage.link</field><field name="model">federation.competition.edition</field><field name="inherit_id" ref="sports_federation_tournament.view_federation_competition_edition_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><button name="action_open_duty_coverage" type="object" string="Duty coverage board" groups="sports_federation_base.group_federation_manager"/></xpath></field></record>
 <record id="coverage_referee_identity" model="ir.ui.view"><field name="name">federation.referee.coverage.identity</field><field name="model">federation.referee</field><field name="inherit_id" ref="sports_federation_officiating.view_federation_referee_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Playing identity"><field name="coverage_playing_checked" groups="sports_federation_base.group_federation_manager"/><field name="coverage_player_id" groups="sports_federation_base.group_federation_manager"/></group></xpath></field></record>
 <record id="resolve_form" model="ir.ui.view"><field name="name">federation.coverage.resolve.form</field><field name="model">federation.coverage.resolve.wizard</field><field name="arch" type="xml"><form><group><field name="match_id" readonly="1"/><field name="operation"/><field name="selected_role" invisible="operation not in ('assign','club')"/><field name="assignment_id" domain="[('match_id','=',match_id)]" invisible="operation != 'replace'"/><field name="referee_id" invisible="operation not in ('assign','replace')"/><field name="club_id" invisible="operation != 'club'"/><field name="duty_id" domain="[('match_id','=',match_id)]" invisible="operation not in ('link','reopen')"/><field name="reason" invisible="operation not in ('replace','reopen')"/><field name="expected_signature" invisible="1"/><field name="preview" readonly="1"/></group><footer><button name="action_apply" type="object" string="Apply and return to coverage" class="oe_highlight"/><button string="Cancel" special="cancel"/></footer></form></field></record>
</odoo>
