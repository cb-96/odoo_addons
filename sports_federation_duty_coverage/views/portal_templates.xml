<odoo>
 <template id="coverage_portal_home" inherit_id="portal.portal_my_home" priority="60"><xpath expr="//div[hasclass('o_portal_docs')]" position="inside"><a t-if="request.env['federation.referee']._portal_get_for_user()" href="/my/duty-assignments" class="btn btn-outline-primary my-2">My assignments: responses and readiness</a></xpath></template>
 <template id="my_assignments" name="My duty assignments"><t t-call="portal.portal_layout"><div class="container py-3"><h1>My assignments</h1><p>Acceptance, eligibility, attendance and completion are checked separately.</p><nav class="d-flex gap-2 mb-3" aria-label="Assignment filters"><a href="/my/duty-assignments?filterby=current">Current</a><a href="/my/duty-assignments?filterby=history">History</a><a href="/my">My work</a></nav>
  <p t-if="not assignments">No assignments in this view. This is not a competition-readiness assessment.</p>
  <div class="row g-3"><t t-foreach="assignments" t-as="a"><article class="col-12 col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h5"><a t-att-href="'/my/duty-assignments/%s?filterby=%s' % (a.id,filterby)"><span t-field="a.match_id.name"/></a></h2><p><span t-field="a.match_id.coverage_kickoff"/> | <span t-field="a.role"/></p><p><span t-field="a.operational_slot_id"/></p><dl><dt>Assigned</dt><dd t-esc="'Yes' if a.state != 'cancelled' else 'Cancelled'"/><dt>Accepted</dt><dd t-esc="'Yes' if a.coverage_accepted else 'Outstanding or stale'"/><dt>Eligible</dt><dd t-esc="'Yes' if a.coverage_eligible else 'Needs action'"/><dt>Present</dt><dd t-esc="'Yes' if a.coverage_present else 'Not recorded'"/><dt>Completed</dt><dd t-esc="'Yes' if a.state == 'done' else 'No'"/></dl><p t-esc="a.coverage_feedback"/></div></div></article></t></div>
  <nav class="d-flex gap-3 mt-3" aria-label="Assignment pages"><a t-if="page &gt; 1" t-att-href="'/my/duty-assignments?page=%s&amp;filterby=%s' % (page-1,filterby)">Previous</a><a t-if="more" t-att-href="'/my/duty-assignments?page=%s&amp;filterby=%s' % (page+1,filterby)">Next</a></nav>
 </div></t></template>
 <template id="assignment_detail" name="Duty assignment response"><t t-call="portal.portal_layout"><div class="container py-3"><a t-att-href="'/my/duty-assignments?filterby=%s' % filterby">Back to my assignments</a><h1 t-field="assignment.match_id.name"/><p><span t-field="assignment.match_id.coverage_kickoff"/> | <span t-field="assignment.role"/></p><p t-field="assignment.operational_slot_id"/><p>Response deadline: <span t-field="assignment.match_id.coverage_response_deadline"/></p>
  <div t-if="error" class="alert alert-danger" role="alert" t-esc="error"/><div t-if="success" class="alert alert-success" role="status" t-esc="success"/>
  <dl><dt>Accepted</dt><dd t-esc="'Yes' if assignment.coverage_accepted else 'Outstanding or stale'"/><dt>Eligible</dt><dd t-esc="'Yes' if assignment.coverage_eligible else 'Needs action'"/><dt>Present</dt><dd t-esc="'Yes' if assignment.coverage_present else 'Not recorded'"/><dt>Completed</dt><dd t-esc="'Yes' if assignment.state == 'done' else 'No'"/></dl><p t-esc="assignment.coverage_feedback"/>
  <form t-if="assignment.state in ('draft','confirmed') and not assignment.coverage_accepted" t-att-action="'/my/duty-assignments/%s/respond' % assignment.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="signature" t-att-value="signature"/><input type="hidden" name="filterby" t-att-value="filterby"/><label for="response_note">Response note (required when declining)</label><textarea id="response_note" name="response_note" class="form-control mb-3" maxlength="2000"/><div class="d-flex gap-2"><button type="submit" name="action" value="confirm" class="btn btn-primary">Accept assignment</button><button type="submit" name="action" value="decline" class="btn btn-outline-danger">Decline</button></div></form>
  <p t-if="assignment.coverage_accepted">Contact the coordinator if you need a replacement. Attendance is recorded separately on match day.</p>
 </div></t></template>
</odoo>
