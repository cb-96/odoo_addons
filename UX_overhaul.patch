+    --dbb-focus: #2563eb;
+    --dbb-success: #16803c;
+    --dbb-warning: #9a6700;
+    --dbb-radius: 14px;
+    --dbb-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 12px 32px rgba(16, 24, 40, .06);
+}
+
+.o_portal_wrap,
+.o_portal_my_home {
+    background: var(--dbb-canvas);
+}
+
+.o_fed_portal_shell {
+    color: var(--dbb-ink);
+    max-width: 1180px;
+    margin-inline: auto;
+}
+
+.o_fed_portal_hero {
+    position: relative;
+    overflow: hidden;
+    padding: clamp(1.35rem, 3vw, 2.25rem);
+    border-radius: 20px;
+    color: #fff;
+    background:
+        linear-gradient(120deg, rgba(16, 24, 40, .98), rgba(16, 24, 40, .86)),
+        linear-gradient(90deg, var(--dbb-red), var(--dbb-yellow));
+    box-shadow: var(--dbb-shadow);
+}
+
+.o_fed_portal_hero::after {
+    content: "";
+    position: absolute;
+    inset: auto -4rem -7rem auto;
+    width: 18rem;
+    height: 18rem;
+    border: 2.5rem solid rgba(255, 205, 0, .16);
+    border-radius: 50%;
+}
+
+.o_fed_portal_eyebrow {
+    color: var(--dbb-yellow);
+    font-size: .75rem;
+    font-weight: 800;
+    letter-spacing: .09em;
+    text-transform: uppercase;
+}
+
+.o_fed_portal_hero h2 { font-weight: 800; letter-spacing: -.025em; }
+.o_fed_portal_hero p { color: rgba(255, 255, 255, .76); max-width: 46rem; }
+
+.o_fed_portal_task {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) auto;
+    gap: 1rem;
+    align-items: center;
+    padding: 1.15rem 1.25rem;
+    margin-top: 1rem;
+    color: var(--dbb-ink);
+    background: #fff;
+    border: 1px solid rgba(255, 255, 255, .45);
+    border-radius: var(--dbb-radius);
+}
+
+.o_fed_portal_task .btn-primary,
+.o_fed_portal_shell .btn-primary {
+    --bs-btn-bg: var(--dbb-red);
+    --bs-btn-border-color: var(--dbb-red);
+    --bs-btn-hover-bg: var(--dbb-red-dark);
+    --bs-btn-hover-border-color: var(--dbb-red-dark);
+    font-weight: 700;
+}
+
+.o_fed_portal_quicknav {
+    display: grid;
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+    gap: .75rem;
+    margin-block: 1rem;
+}
+
+.o_fed_portal_quicklink {
+    display: flex;
+    gap: .75rem;
+    align-items: center;
+    min-height: 4.25rem;
+    padding: .9rem 1rem;
+    color: var(--dbb-ink);
+    text-decoration: none;
+    background: var(--dbb-surface);
+    border: 1px solid var(--dbb-line);
+    border-radius: var(--dbb-radius);
+    transition: border-color 140ms ease, box-shadow 140ms ease, transform 140ms ease;
+}
+
+.o_fed_portal_quicklink:hover {
+    color: var(--dbb-ink);
+    border-color: rgba(215, 25, 32, .45);
+    box-shadow: var(--dbb-shadow);
+    transform: translateY(-1px);
+}
+
+.o_fed_portal_quicklink i {
+    display: grid;
+    width: 2.25rem;
+    height: 2.25rem;
+    place-items: center;
+    color: var(--dbb-red);
+    background: rgba(215, 25, 32, .08);
+    border-radius: 10px;
+}
+
+.o_fed_portal_section-title { font-weight: 800; letter-spacing: -.015em; }
+
+.o_fed_portal_grid {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 1rem;
+}
+
+.o_fed_portal_group {
+    background: var(--dbb-surface);
+    border: 1px solid var(--dbb-line);
+    border-radius: var(--dbb-radius);
+    box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
+    overflow: hidden;
+}
+
+.o_fed_portal_group-header { padding: 1rem 1rem .65rem; }
+.o_fed_portal_group-header h3 { margin: 0; font-size: 1rem; font-weight: 800; }
+.o_fed_portal_group-header p { margin: .25rem 0 0; color: var(--dbb-muted); font-size: .82rem; }
+
+.o_fed_portal_link {
+    display: flex;
+    gap: .75rem;
+    align-items: center;
+    min-height: 3.75rem;
+    padding: .8rem 1rem;
+    color: var(--dbb-ink);
+    text-decoration: none;
+    border-top: 1px solid var(--dbb-line);
+}
+.o_fed_portal_link:hover { color: var(--dbb-red-dark); background: #fff9f9; }
+.o_fed_portal_link > i { width: 1.25rem; color: var(--dbb-muted); text-align: center; }
+.o_fed_portal_link .badge { margin-left: auto; }
+
+/* Bring all federation portal records onto the same visual language. */
+.o_fed_portal_home ~ *,
+.o_fed_portal_shell ~ * { --bs-primary: var(--dbb-red); }
+
+.o_portal .card,
+.o_portal_wrap .card {
+    border-color: var(--dbb-line);
+    border-radius: var(--dbb-radius);
+    box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
+}
+.o_portal .table-responsive,
+.o_portal_wrap .table-responsive {
+    border: 1px solid var(--dbb-line);
+    border-radius: var(--dbb-radius);
+    background: #fff;
+}
+.o_portal table thead th,
+.o_portal_wrap table thead th {
+    color: #475467;
+    font-size: .75rem;
+    letter-spacing: .04em;
+    text-transform: uppercase;
+    background: #f9fafb;
+    border-bottom-color: var(--dbb-line);
+}
+.o_portal .form-control,
+.o_portal .form-select,
+.o_portal_wrap .form-control,
+.o_portal_wrap .form-select {
+    min-height: 2.75rem;
+    border-color: #d0d5dd;
+    border-radius: 10px;
+}
+.o_portal .form-control:focus,
+.o_portal .form-select:focus,
+.o_portal_wrap .form-control:focus,
+.o_portal_wrap .form-select:focus {
+    border-color: var(--dbb-focus);
+    box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .15);
+}
+
+@media (max-width: 991.98px) {
+    .o_fed_portal_quicknav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+    .o_fed_portal_grid { grid-template-columns: 1fr; }
+}
+@media (max-width: 575.98px) {
+    .o_fed_portal_hero { border-radius: 0; margin-inline: -12px; }
+    .o_fed_portal_task { grid-template-columns: 1fr; }
+    .o_fed_portal_task .btn { width: 100%; }
+    .o_fed_portal_quicknav { grid-template-columns: 1fr 1fr; }
+    .o_fed_portal_quicklink { align-items: flex-start; min-height: 4.8rem; padding: .8rem; flex-direction: column; }
+}
+@media (prefers-reduced-motion: reduce) {
+    .o_fed_portal_quicklink { transition: none; }
+}
