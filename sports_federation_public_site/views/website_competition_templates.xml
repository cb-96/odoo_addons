<odoo>
  <template id="public_competition_competition_card" name="Competition card">
    <article class="sf-competition-card card h-100 shadow-sm border-0">
      <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between gap-2 mb-2">
          <span class="badge text-bg-primary"><t t-esc="edition.get_public_site_state_label()"/></span>
          <small class="text-muted"><t t-esc="edition.season_id.display_name"/></small>
        </div>
        <h2 class="h5"><t t-esc="edition.name"/></h2>
        <p class="text-muted flex-grow-1"><t t-esc="edition.public_summary or 'Competition details, schedules and results.'"/></p>
        <div class="d-flex flex-wrap gap-1 mb-3">
          <span class="badge rounded-pill text-bg-light" t-foreach="edition.tournament_ids.filtered(lambda d: d.website_published and d.edition_id == edition)" t-as="division"><t t-esc="division.name"/></span>
        </div>
        <a class="btn btn-outline-primary stretched-link" t-att-href="'/competitions/%s' % edition.public_slug">View competition</a>
      </div>
    </article>
  </template>

  <template id="public_competition_match_card" name="Public match card">
    <article class="sf-match-card" t-att-data-match-id="row['match'].id">
      <div class="d-flex justify-content-between gap-2 small text-muted mb-1">
        <span t-if="row['slot']"><t t-esc="row['slot'].court_id.display_name"/></span>
        <span t-if="row['status'] != 'as_published'" class="sf-match-status"><t t-esc="row['match'].get_public_operational_status_label()"/></span>
      </div>
      <div t-if="row['division_label']" class="small text-primary fw-semibold mb-1"><t t-esc="row['division_label']"/></div>
      <div class="sf-team-line"><strong><t t-esc="row['match'].home_team_id.name or 'TBD'"/></strong><span t-if="row['match'].result_state in ('submitted','verified','approved')"><t t-esc="row['match'].home_score"/></span></div>
      <div class="sf-team-line"><strong><t t-esc="row['match'].away_team_id.name or 'TBD'"/></strong><span t-if="row['match'].result_state in ('submitted','verified','approved')"><t t-esc="row['match'].away_score"/></span></div>
    </article>
  </template>

  <template id="public_competition_result_card" name="Public result card">
    <article class="card h-100 border-0 shadow-sm sf-result-card">
      <div class="card-body">
        <div class="d-flex justify-content-between gap-2 small text-muted mb-2"><span t-if="row['match'].date_scheduled"><t t-esc="row['match'].date_scheduled.strftime('%a %d %b · %H:%M')"/></span><span class="badge text-bg-success">Final</span></div>
        <div t-if="row['division_label']" class="small text-primary fw-semibold mb-2"><t t-esc="row['division_label']"/></div>
        <div class="sf-team-line"><strong><t t-esc="row['match'].home_team_id.name or 'TBD'"/></strong><strong><t t-esc="row['match'].home_score"/></strong></div>
        <div class="sf-team-line"><strong><t t-esc="row['match'].away_team_id.name or 'TBD'"/></strong><strong><t t-esc="row['match'].away_score"/></strong></div>
      </div>
    </article>
  </template>

  <template id="public_competition_competition_hub" name="Competitions">
    <t t-call="website.layout"><main class="container py-5">
      <header class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4">
        <div><p class="text-primary text-uppercase fw-semibold mb-1">Competition centre</p><h1><t t-esc="'Competition archive' if archive else 'Current competitions'"/></h1><p class="lead text-muted">Follow schedules, live match days, results, standings and brackets.</p></div>
        <a class="btn btn-outline-secondary" t-att-href="'/competitions' if archive else '/competitions/archive'"><t t-esc="'Current competitions' if archive else 'Archive'"/></a>
      </header>
      <form class="row g-2 mb-4" method="get">
        <div class="col-md-8"><label class="visually-hidden" for="competition-search">Search</label><input id="competition-search" class="form-control" name="search" t-att-value="search" placeholder="Search by competition name" autocomplete="off"/></div>
        <div class="col-md-3"><select class="form-select" name="season_id" aria-label="Season"><option value="">All seasons</option><option t-foreach="seasons" t-as="season" t-att-value="season.id"><t t-esc="season.display_name"/></option></select></div>
        <div class="col-md-1"><button class="btn btn-primary w-100">Search</button></div>
      </form>
      <div class="row g-4" t-if="editions"><div class="col-md-6 col-xl-4" t-foreach="editions" t-as="edition"><t t-call="sports_federation_public_site.public_competition_competition_card"/></div></div>
      <div class="sf-empty-state" t-else=""><h2 class="h4">No competitions found</h2><p class="text-muted">Published competitions will appear here.</p></div>
    </main></t>
  </template>

  <template id="public_competition_competition_nav" name="Competition navigation">
    <nav class="nav nav-pills flex-nowrap overflow-auto mb-4 sf-competition-nav" aria-label="Competition sections">
      <a t-att-class="'nav-link ' + ('active' if page_name == 'overview' else '')" t-att-aria-current="'page' if page_name == 'overview' else None" t-att-href="'/competitions/%s' % edition.public_slug">Overview</a>
      <a t-att-class="'nav-link ' + ('active' if page_name == 'schedule' else '')" t-att-aria-current="'page' if page_name == 'schedule' else None" t-att-href="'/competitions/%s/schedule' % edition.public_slug">Schedule</a>
      <a t-att-class="'nav-link ' + ('active' if page_name == 'results' else '')" t-att-aria-current="'page' if page_name == 'results' else None" t-att-href="'/competitions/%s/results' % edition.public_slug">Results</a>
      <a t-att-class="'nav-link ' + ('active' if page_name == 'standings' else '')" t-att-aria-current="'page' if page_name == 'standings' else None" t-att-href="'/competitions/%s/standings' % edition.public_slug">Standings</a>
    </nav>
  </template>

  <template id="public_competition_competition_detail" name="Competition detail">
    <t t-call="website.layout"><main>
      <section class="sf-competition-hero"><div class="container py-5"><span class="badge text-bg-light mb-2"><t t-esc="edition.get_public_site_state_label()"/></span><h1><t t-esc="edition.name"/></h1><p class="lead mb-0"><t t-esc="edition.public_summary or edition.season_id.display_name"/></p></div></section>
      <div class="container py-4"><t t-call="sports_federation_public_site.public_competition_competition_nav"/>
        <div class="d-flex flex-wrap gap-2 mb-4"><a t-foreach="divisions" t-as="item" t-att-class="'btn ' + ('btn-primary' if division == item else 'btn-outline-primary')" t-att-href="'/competitions/%s?division_id=%s' % (edition.public_slug, item.id)"><t t-esc="item.name"/></a></div>
        <section aria-labelledby="upcoming-matches-heading">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div><h2 class="h3 mb-1" id="upcoming-matches-heading">Upcoming matches</h2><p class="text-muted mb-0">The next matches from the published schedule.</p></div>
            <a class="btn btn-outline-primary" t-att-href="'/competitions/%s/schedule' % edition.public_slug">View full schedule</a>
          </div>
          <div class="row g-3" t-if="upcoming_matches">
            <div class="col-md-6 col-xl-4" t-foreach="upcoming_matches" t-as="row">
              <article class="card h-100 border-0 shadow-sm sf-upcoming-match">
                <div class="card-body">
                  <p class="text-primary fw-semibold mb-1"><t t-esc="row['start_local'].strftime('%a %d %b · %H:%M')"/></p>
                  <p class="small text-muted mb-3"><t t-esc="row['matchday'].venue_id.display_name"/><t t-if="row['slot']"> · <t t-esc="row['slot'].court_id.display_name"/></t></p>
                  <div class="sf-team-line"><strong><t t-esc="row['match'].home_team_id.display_name"/></strong></div>
                  <div class="sf-team-line"><strong><t t-esc="row['match'].away_team_id.display_name"/></strong></div>
                  <p class="small text-muted mt-3 mb-0" t-if="row['division_label']"><t t-esc="row['division_label']"/></p>
                </div>
              </article>
            </div>
          </div>
          <div class="sf-empty-state" t-else=""><h3 class="h4">No upcoming matches</h3><p class="mb-0">New matches will appear here when the schedule is available.</p></div>
        </section>
        <section class="mt-5" aria-labelledby="recent-results-heading">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><div><h2 class="h3 mb-1" id="recent-results-heading">Latest results</h2><p class="text-muted mb-0">The latest official scores.</p></div><a class="btn btn-outline-primary" t-att-href="'/competitions/%s/results' % edition.public_slug">View all results</a></div>
          <div class="row g-3" t-if="recent_results"><div class="col-md-6" t-foreach="recent_results" t-as="row"><t t-call="sports_federation_public_site.public_competition_result_card"/></div></div>
          <p class="text-muted" t-else="">No official results are available yet.</p>
        </section>
      </div>
    </main></t>
  </template>

  <template id="public_competition_competition_schedule" name="Competition schedule">
    <t t-call="website.layout"><main class="container py-5"><h1><t t-esc="edition.name"/> schedule</h1><t t-call="sports_federation_public_site.public_competition_competition_nav"/>
      <div class="row g-3" t-if="matchdays"><div class="col-md-6" t-foreach="matchdays" t-as="matchday"><article class="card h-100 shadow-sm"><div class="card-body"><p class="text-primary fw-semibold"><t t-esc="matchday.date"/></p><h2 class="h5"><t t-esc="matchday.name"/></h2><p class="text-muted"><t t-esc="matchday.venue_id.display_name"/></p><a class="btn btn-outline-primary" t-att-href="'/competitions/%s/gamedays/%s' % (edition.public_slug, matchday.id)">View match day</a></div></article></div></div>
      <div class="sf-empty-state" t-else=""><h2 class="h4">Schedule not available yet</h2><p>Match dates and times will appear here when they are available.</p></div>
    </main></t>
  </template>

  <template id="public_competition_competition_results" name="Competition results">
    <t t-call="website.layout"><main class="container py-5"><h1><t t-esc="edition.name"/> results</h1><t t-call="sports_federation_public_site.public_competition_competition_nav"/>
      <div class="d-flex flex-wrap gap-2 mb-4" t-if="len(divisions) &gt; 1"><a t-foreach="divisions" t-as="item" t-att-class="'btn ' + ('btn-primary' if division == item else 'btn-outline-primary')" t-att-href="'/competitions/%s/results?division_id=%s' % (edition.public_slug, item.id)"><t t-esc="item.name"/></a></div>
      <div class="row g-3" t-if="results"><div class="col-md-6 col-xl-4" t-foreach="results" t-as="row"><t t-call="sports_federation_public_site.public_competition_result_card"/></div></div>
      <div class="sf-empty-state" t-else=""><h2 class="h4">No official results yet</h2><p class="mb-0">Final scores will appear here after they are confirmed.</p></div>
    </main></t>
  </template>

  <template id="public_competition_competition_standings" name="Competition standings">
    <t t-call="website.layout"><main class="container py-5"><h1><t t-esc="edition.name"/> standings</h1><t t-call="sports_federation_public_site.public_competition_competition_nav"/>
      <div class="d-flex flex-wrap gap-2 mb-4" t-if="len(divisions) &gt; 1"><a t-foreach="divisions" t-as="item" t-att-class="'btn ' + ('btn-primary' if division == item else 'btn-outline-primary')" t-att-href="'/competitions/%s/standings?division_id=%s' % (edition.public_slug, item.id)"><t t-esc="item.name"/></a></div>
      <section class="mb-5" t-foreach="standing_cards" t-as="card">
        <h2 class="h3" t-if="len(standing_cards) &gt; 1"><t t-esc="card['stage'].name"/></h2>
        <div class="table-responsive"><table class="table table-hover align-middle sf-standings-table"><caption>Current standings</caption><thead><tr><th scope="col">Position</th><th scope="col">Team</th><th scope="col"><abbr title="Played">P</abbr></th><th class="sf-standing-secondary" scope="col"><abbr title="Won">W</abbr></th><th class="sf-standing-secondary" scope="col"><abbr title="Drawn">D</abbr></th><th class="sf-standing-secondary" scope="col"><abbr title="Lost">L</abbr></th><th class="sf-standing-secondary" scope="col">For</th><th class="sf-standing-secondary" scope="col">Against</th><th class="sf-standing-secondary" scope="col">Diff</th><th scope="col">Pts</th></tr></thead><tbody><tr t-foreach="card['standings']" t-as="line"><td><strong><t t-esc="line.rank"/></strong></td><td><t t-esc="line.team_id.display_name"/></td><td><t t-esc="line.played"/></td><td class="sf-standing-secondary"><t t-esc="line.won"/></td><td class="sf-standing-secondary"><t t-esc="line.drawn"/></td><td class="sf-standing-secondary"><t t-esc="line.lost"/></td><td class="sf-standing-secondary"><t t-esc="line.score_for"/></td><td class="sf-standing-secondary"><t t-esc="line.score_against"/></td><td class="sf-standing-secondary"><t t-esc="line.score_for - line.score_against"/></td><td><strong><t t-esc="line.points"/></strong></td></tr></tbody></table></div>
      </section>
      <div class="sf-empty-state" t-if="not standing_cards"><h2 class="h4">Standings not available yet</h2><p class="mb-0">The table will appear here when official standings are available.</p></div>
    </main></t>
  </template>

  <template id="public_competition_gameday" name="current gameday board">
    <t t-call="website.layout"><main class="container-fluid px-lg-5 py-4 sf-live-board" t-att-data-status-url="'/competitions/%s/gamedays/%s/status.json' % (edition.public_slug, matchday.id)">
      <header class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4"><div><a t-att-href="'/competitions/%s/schedule' % edition.public_slug">← Schedule</a><h1 class="mt-2"><t t-esc="matchday.name"/></h1><p class="text-muted"><t t-esc="matchday.date"/> · <t t-esc="matchday.venue_id.display_name"/></p></div><div class="d-flex gap-2 align-items-start"><button type="button" class="btn btn-outline-primary sf-jump-now">Jump to now</button><a class="btn btn-outline-secondary" t-att-href="'/competitions/%s/gamedays/%s?display=1' % (edition.public_slug, matchday.id)">Display mode</a></div></header>
      <form class="row g-2 mb-3"><div class="col-md-5"><select name="team_id" class="form-select" aria-label="Filter by team"><option value="">All teams</option><option t-foreach="edition.tournament_ids.mapped('participant_ids').mapped('team_id')" t-as="team" t-att-value="team.id" t-att-selected="team_id == team.id"><t t-esc="team.display_name"/></option></select></div><div class="col-md-5"><select name="court_id" class="form-select" aria-label="Filter by court"><option value="">All courts</option><option t-foreach="courts" t-as="court" t-att-value="court.id" t-att-selected="court_id == court.id"><t t-esc="court.display_name"/></option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filter</button></div></form>
      <div class="d-none d-lg-block table-responsive sf-gameday-grid-wrap" t-if="times and courts"><table class="table sf-gameday-grid"><caption class="visually-hidden">Matches by time and court</caption><thead><tr><th class="sf-time-column">Time</th><th t-foreach="courts" t-as="court"><t t-esc="court.display_name"/></th></tr></thead><tbody><tr t-foreach="times" t-as="time"><th class="sf-time-column" scope="row"><t t-esc="time.strftime('%H:%M')"/></th><td t-foreach="courts" t-as="court"><t t-set="row" t-value="grid.get((time, court.id))"/><t t-if="row" t-call="sports_federation_public_site.public_competition_match_card"/></td></tr></tbody></table></div>
      <div class="d-lg-none sf-mobile-agenda" t-if="by_time"><section class="mb-4" t-foreach="by_time" t-as="time_rows"><h2 class="h5 sticky-top bg-white py-2"><t t-esc="time_rows[0].strftime('%H:%M') if time_rows[0] else 'Unscheduled'"/></h2><div class="mb-2" t-foreach="time_rows[1]" t-as="row"><t t-call="sports_federation_public_site.public_competition_match_card"/></div></section></div>
      <div class="sf-empty-state" t-if="not matches"><h2 class="h4">No published matches</h2><p>Change the filters or return after the schedule is published.</p></div>
    </main></t>
  </template>

  <template id="public_competition_gameday_display" name="current gameday display">
    <t t-call="website.layout"><main class="container-fluid p-4 sf-display-board sf-live-board" t-att-data-status-url="'/competitions/%s/gamedays/%s/status.json' % (edition.public_slug, matchday.id)"><header class="d-flex justify-content-between align-items-center mb-4"><div><h1><t t-esc="matchday.name"/></h1><p class="lead"><t t-esc="matchday.venue_id.display_name"/></p></div><div class="display-6" id="sf-display-clock"></div></header><div class="row g-3"><div class="col-md-6 col-xl-4" t-foreach="matches" t-as="row"><t t-call="sports_federation_public_site.public_competition_match_card"/></div></div></main></t>
  </template>
</odoo>
