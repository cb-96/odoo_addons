<odoo>
 <record id="matchday_list" model="ir.ui.view"><field name="name">federation.matchday.list</field><field name="model">federation.matchday</field><field name="arch" type="xml"><list decoration-success="state in ('scheduled','closed')" decoration-warning="spare_capacity &lt; 0"><field name="date"/><field name="name"/><field name="edition_id"/><field name="venue_id"/><field name="fixture_count"/><field name="playable_slot_count"/><field name="spare_capacity"/><field name="state" widget="badge"/></list></field></record>
 <record id="matchday_form" model="ir.ui.view"><field name="name">federation.matchday.form</field><field name="model">federation.matchday</field><field name="arch" type="xml"><form><header><button name="action_capacity_ready" type="object" string="Mark Capacity Ready" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar" statusbar_visible="draft,capacity_ready,scheduled,open,closed"/></header><sheet><div class="oe_button_box" name="button_box"/><group><field name="name"/><field name="edition_id"/><field name="date"/><field name="venue_id"/></group><group string="Capacity" col="6"><field name="fixture_count"/><field name="playable_slot_count"/><field name="spare_capacity"/></group><notebook><page string="Round Allocations"><field name="allocation_ids"><list editable="bottom"><field name="structure_id" domain="[('edition_id','=',parent.edition_id),('state','=','frozen')]"/><field name="stage_id" domain="[('structure_id','=',structure_id)]"/><field name="round_number"/><field name="manual_fixture_ids" widget="many2many_tags"/><field name="fixture_ids" widget="many2many_tags" readonly="1"/></list></field></page><page string="Physical Slots"><field name="slot_ids"><list editable="bottom"><field name="court_id"/><field name="start_datetime"/><field name="end_datetime"/><field name="state"/><field name="note"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_calendar_planner" model="ir.actions.act_window"><field name="name">Calendar Planner</field><field name="res_model">federation.matchday</field><field name="view_mode">calendar,list,form</field></record>
 <record id="matchday_calendar" model="ir.ui.view"><field name="name">federation.matchday.calendar</field><field name="model">federation.matchday</field><field name="arch" type="xml"><calendar date_start="date" color="venue_id"><field name="name"/><field name="venue_id"/><field name="state"/></calendar></field></record>
</odoo>
