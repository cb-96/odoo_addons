<odoo>
  <record id="view_federation_schedule_amend_wizard_form" model="ir.ui.view">
    <field name="name">federation.schedule.amend.wizard.form</field>
    <field name="model">federation.schedule.amend.wizard</field>
    <field name="arch" type="xml">
      <form string="Amend Published Schedule">
        <div class="alert alert-warning" role="alert">
          If this game day is open, close live operations first. The live publication remains immutable while the replacement is edited and independently reviewed. Publishing the approved amendment supersedes the current version; reopen operations against the new publication afterwards.
        </div>
        <group string="Before the change">
          <field name="schedule_id"/>
          <field name="matchday_state"/>
          <field name="published_assignment_count"/>
          <field name="recovery_summary" nolabel="1"/>
        </group>
        <group string="Amendment">
          <field name="reason" placeholder="Describe the fixture or planning change..."/>
        </group>
        <footer>
          <button name="action_amend" type="object" string="Create Amendment" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
