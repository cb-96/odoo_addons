<odoo>
  <record id="view_federation_schedule_amend_wizard_form" model="ir.ui.view">
    <field name="name">federation.schedule.amend.wizard.form</field>
    <field name="model">federation.schedule.amend.wizard</field>
    <field name="arch" type="xml">
      <form string="Amend Published Schedule">
        <div class="alert alert-warning" role="alert">
          The live publication remains active while this replacement revision is edited and reviewed.
          Publishing the approved amendment will supersede the current live publication.
        </div>
        <group>
          <field name="schedule_id"/>
          <field name="reason" placeholder="Describe the fixture or planning change..."/>
        </group>
        <footer>
          <button name="action_amend" type="object" string="Create Amendment" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
