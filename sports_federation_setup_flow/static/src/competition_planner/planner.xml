<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
  <t t-name="sports_federation_setup_flow.CompetitionPlanner">
    <div class="o_competition_planner h-100 overflow-auto">
      <section t-if="state.error" class="alert alert-danger m-3" role="alert"><h2 class="h5">Could not refresh competition</h2><p t-esc="state.error"/><p t-if="state.data">Showing previously loaded information. Actions are paused until refresh succeeds.</p><button class="btn btn-outline-danger" t-on-click="load" t-att-disabled="state.loading">Retry</button></section><div t-if="state.loading" class="o_competition_planner_loading" role="status">
        <i class="fa fa-spinner fa-spin" aria-hidden="true"/><span>Loading competition planner…</span>
      </div>
      <div t-elif="!state.data" class="o_competition_planner_empty">
        <h2 t-if="!state.error">Competition planner</h2><p t-if="!state.error">Open a season competition to start or resume its setup.</p>
      </div>
      <main t-else="" class="container-fluid py-4" aria-labelledby="planner-title">
        <a href="/my" class="btn btn-outline-secondary mb-3">Back to portal overview</a><header class="o_competition_planner_header">
          <div><div class="text-muted small">Competition Planner</div>
            <h1 id="planner-title" class="h2 mb-1" t-esc="state.data.edition.name"/>
            <p class="text-muted mb-0"><span t-esc="state.data.edition.season"/></p>
          </div>
          <details class="sf-disclosure"><summary>More</summary><div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" t-on-click="load"><i class="fa fa-refresh me-1" aria-hidden="true"/>Refresh</button>
             <button class="btn btn-outline-secondary" t-on-click="openBasics" t-att-disabled="state.busy || state.loading || !!state.error">Competition details</button>
             <button t-if="state.data.can_use_advanced_tools" class="btn btn-outline-secondary" t-on-click="openAdvanced" t-att-disabled="state.busy || state.loading || !!state.error">Advanced tools</button>
             <button t-if="state.data.can_use_advanced_tools" class="btn btn-outline-secondary" t-on-click="openAdministration" t-att-disabled="state.busy || state.loading || !!state.error">Administration</button>
          </div></details>
        </header>

        <nav t-if="state.data.show_setup_progress" class="o_competition_journey" aria-label="Competition setup progress">
          <button t-foreach="state.data.steps" t-as="step" t-key="step.key" t-att-class="'o_competition_journey_step is-' + step.status" t-att-aria-current="step.status === 'current' ? 'step' : undefined" t-att-title="statusLabel(step)" t-on-click="() =&gt; this.openStep(step.key)" t-att-disabled="state.busy || state.loading || !!state.error">
            <span class="o_competition_journey_icon"><i t-att-class="'fa ' + statusIcon(step)" aria-hidden="true"/></span>
            <span class="o_competition_journey_text"><strong t-esc="step.label"/><small t-esc="statusLabel(step)"/></span>
            <span t-if="step.issue_count" class="badge rounded-pill text-bg-danger" t-esc="step.issue_count"/>
          </button>
        </nav>

        <section class="o_competition_current_task mt-4" aria-labelledby="current-task-title" data-planner-current-action="true" data-planner-primary-projection="true">
          <div>
            <div class="text-muted small text-uppercase">Next action</div>
            <h2 id="current-task-title" class="h4 mb-1" t-esc="state.data.primary_action.title"/>
            <p class="mb-1" t-esc="state.data.primary_action.message"/>
            <div class="small text-muted"><strong>Responsible:</strong> <span t-esc="state.data.primary_action.owner"/></div>
            <div class="small text-muted">The responsible person also needs the matching federation-wide access group and a responsibility assignment on this competition.</div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary btn-lg" t-on-click="openPrimary" data-planner-primary-action="true" t-att-disabled="state.busy || state.loading || !!state.error">
              <t t-esc="state.data.primary_action.label"/>
              <i class="fa fa-arrow-right ms-2" aria-hidden="true"/>
            </button>
            <button t-if="state.data.can_use_advanced_tools" class="btn btn-outline-secondary" t-on-click="() =&gt; this.openStep(state.data.current_step)" t-att-disabled="state.busy || state.loading || !!state.error">Open current area</button>
          </div>
        </section>

        <section class="alert mt-3" t-att-class="state.data.readiness.status === 'ready' ? 'alert-success' : (state.data.readiness.status === 'attention' ? 'alert-warning' : 'alert-info')" role="status" data-planner-unified-readiness="true">
          <strong>Competition readiness:</strong> <span t-esc="state.data.readiness.summary"/>
          <span class="ms-2 small"><t t-esc="state.data.readiness.setup_blocker_count"/> planning blocker(s) · <t t-esc="state.data.readiness.operational_action_count"/> operational action(s)</span>
        </section>

        <section t-if="state.matchday and state.matchday.available and state.matchday.readiness" class="card mt-3" aria-label="Next game day readiness" data-planner-matchday-readiness="true">
          <div class="card-body">
            <h2 class="h5 mb-1">Can <t t-esc="state.matchday.readiness.matchday_name"/> run?
              <span class="badge ms-2" t-att-class="{'text-bg-success': ['ready', 'complete'].includes(state.matchday.readiness.overall), 'text-bg-warning': ['action_needed'].includes(state.matchday.readiness.overall), 'text-bg-info': ['waiting_review'].includes(state.matchday.readiness.overall), 'text-bg-danger': state.matchday.readiness.overall === 'blocked', 'text-bg-secondary': state.matchday.readiness.overall === 'not_applicable'}" t-esc="state.matchday.readiness.overall_label"/>
            </h2>
            <p class="mb-2" t-esc="state.matchday.readiness.headline"/>
            <ul class="list-unstyled mb-2">
              <li t-foreach="state.matchday.readiness.components" t-as="component" t-key="component.key"><strong t-esc="component.label"/>: <span t-esc="component.status_label"/> <span class="text-muted">(<t t-esc="component.summary"/>)</span></li>
            </ul>
            <ol t-if="state.matchday.readiness.blockers.length" class="mb-0">
              <li t-foreach="state.matchday.readiness.blockers.slice(0, 3)" t-as="blocker" t-key="blocker.key"><strong t-esc="blocker.problem"/> <t t-esc="blocker.action"/> <span class="small text-muted">Owner: <t t-esc="blocker.owner_label"/> · Deadline: <t t-esc="blocker.deadline_label"/></span></li>
            </ol>
          </div>
        </section>
        <p t-if="state.matchday and !state.matchday.available" class="small text-muted mt-3">Game-day readiness is unavailable to your role.</p>

        <details t-if="state.data.operations.roster_action_count || state.data.operations.lineup_action_count || state.data.operations.official_action_count || state.data.operations.result_action_count" class="sf-disclosure"><summary>Other work</summary><section class="card mt-3" aria-label="Operational tasks"><div class="card-body d-flex flex-wrap gap-2">
          <button t-if="state.data.operations.rosters_available &amp;&amp; state.data.operations.roster_action_count &gt; 0" class="btn btn-outline-primary" t-att-disabled="state.busy || state.loading || !!state.error || (state.data.operations.roster_action_count === 0)" t-on-click="() =&gt; this.openOperation('rosters')">Teams needing rosters: <t t-esc="state.data.operations.roster_action_count"/></button>
          <button t-if="state.data.operations.lineups_available &amp;&amp; state.data.operations.lineup_action_count &gt; 0" class="btn btn-outline-primary" t-att-disabled="state.busy || state.loading || !!state.error || (state.data.operations.lineup_action_count === 0)" t-on-click="() =&gt; this.openOperation('lineups')">Game days needing lineups: <t t-esc="state.data.operations.lineup_action_count"/></button>
          <button t-if="state.data.operations.officials_available &amp;&amp; state.data.operations.official_action_count &gt; 0" class="btn btn-outline-primary" t-att-disabled="state.busy || state.loading || !!state.error || (state.data.operations.official_action_count === 0)" t-on-click="() =&gt; this.openOperation('officials')">Matches needing officials: <t t-esc="state.data.operations.official_action_count"/></button>
          <button t-if="state.data.operations.results_available &amp;&amp; state.data.operations.result_action_count &gt; 0" class="btn btn-outline-primary" t-att-disabled="state.busy || state.loading || !!state.error || (state.data.operations.result_action_count === 0)" t-on-click="() =&gt; this.openOperation('results')">Results awaiting approval: <t t-esc="state.data.operations.result_action_count"/></button>
        </div></section></details>
        <section t-if="state.data.remaining_issues.length" class="mt-3" aria-label="Remaining blockers"><h2 class="h5">Other blocking issues</h2><button t-foreach="state.data.remaining_issues" t-as="issue" t-key="issue.key" class="list-group-item list-group-item-action text-start" t-on-click="() =&gt; this.openIssue(issue)" t-att-disabled="state.busy || state.loading || !!state.error"><strong t-esc="issue.title"/><span class="d-block small text-muted" t-esc="issue.message"/></button></section><details class="sf-disclosure"><summary>Division checks</summary><section class="col-xl-7" aria-labelledby="divisions-title">
            <div class="card h-100"><div class="card-header"><h2 id="divisions-title" class="h5 mb-0">Division readiness</h2></div>
              <div t-if="state.data.divisions.length" class="table-responsive"><table class="table align-middle mb-0">
                <thead><tr><th>Division</th><th>Teams</th><th>Format</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody><tr t-foreach="state.data.divisions" t-as="division" t-key="division.id">
                  <td t-esc="division.name"/><td t-esc="division.team_count"/><td t-esc="division.format_name || division.format_status"/>
                  <td><span t-att-class="division.ready ? 'badge text-bg-success' : 'badge text-bg-warning'" t-esc="division.ready ? 'Ready' : 'Action needed'"/></td>
                  <td class="text-end"><button t-if="division.teams_status === 'complete'" class="btn btn-sm btn-outline-secondary" t-att-aria-label="'Format options for ' + division.name" t-on-click="() =&gt; this.openDivisionFormat(division)" t-att-disabled="state.busy || state.loading || !!state.error">Format options</button></td>
                </tr></tbody>
              </table></div>
              <div t-else="" class="card-body text-center py-5"><h3 class="h5">No divisions yet</h3><button class="btn btn-outline-secondary" t-on-click="openBasics" t-att-disabled="state.busy || state.loading || !!state.error">Define competition divisions</button></div>
            </div>
          </section>
          </details></main>
    </div>
  </t>
</templates>