<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="sports_federation_setup_flow.CompetitionPlanner">
    <div class="o_competition_planner h-100 overflow-auto">
      <div t-if="state.loading" class="o_competition_planner_loading" role="status">
        <i class="fa fa-spinner fa-spin" aria-hidden="true"/><span>Loading competition planner…</span>
      </div>
      <div t-elif="!state.data" class="o_competition_planner_empty">
        <h2>Competition planner</h2><p>Open a season competition to start or resume its setup.</p>
      </div>
      <main t-else="" class="container-fluid py-4" aria-labelledby="planner-title">
        <header class="o_competition_planner_header">
          <div><div class="text-muted small">Competition Planner</div>
            <h1 id="planner-title" class="h2 mb-1" t-esc="state.data.edition.name"/>
            <p class="text-muted mb-0"><span t-esc="state.data.edition.season"/></p>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary" t-on-click="load"><i class="fa fa-refresh me-1" aria-hidden="true"/>Refresh</button>
             <button class="btn btn-outline-secondary" t-on-click="openBasics">Competition details</button>
             <button t-if="state.data.can_use_advanced_tools" class="btn btn-outline-secondary" t-on-click="openAdvanced">Advanced tools</button>
             <button t-if="state.data.can_use_advanced_tools" class="btn btn-outline-secondary" t-on-click="openAdministration">Administration</button>
          </div>
        </header>

        <nav class="o_competition_journey" aria-label="Competition setup progress">
          <button t-foreach="state.data.steps" t-as="step" t-key="step.key"
            t-att-class="'o_competition_journey_step is-' + step.status"
            t-att-aria-current="step.status === 'current' ? 'step' : undefined"
            t-att-title="statusLabel(step)" t-on-click="() => this.openStep(step.key)">
            <span class="o_competition_journey_icon"><i t-att-class="'fa ' + statusIcon(step)" aria-hidden="true"/></span>
            <span class="o_competition_journey_text"><strong t-esc="step.label"/><small t-esc="statusLabel(step)"/></span>
            <span t-if="step.issue_count" class="badge rounded-pill text-bg-danger" t-esc="step.issue_count"/>
          </button>
        </nav>

        <section class="o_competition_current_task mt-4" aria-labelledby="current-task-title" data-planner-current-action="true" data-planner-primary-projection="true">
          <div>
            <div class="text-muted small text-uppercase">Next action</div>
            <h2 id="current-task-title" class="h4 mb-1" t-esc="state.data.primary_action.title"/>
            <p class="mb-1" t-esc="state.data.primary_action.message"/>
            <div class="small text-muted"><strong>Responsible:</strong> <span t-esc="state.data.primary_action.owner"/></div>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary btn-lg" t-on-click="openPrimary" data-planner-primary-action="true">
              <t t-esc="state.data.primary_action.label"/>
              <i class="fa fa-arrow-right ms-2" aria-hidden="true"/>
            </button>
            <button t-if="state.data.can_use_advanced_tools" class="btn btn-outline-secondary" t-on-click="() => this.openStep(state.data.current_step)">Open current area</button>
          </div>
        </section>

        <section class="alert mt-3" t-att-class="state.data.readiness.status === 'ready' ? 'alert-success' : (state.data.readiness.status === 'attention' ? 'alert-warning' : 'alert-danger')" role="status" data-planner-unified-readiness="true">
          <strong>Competition readiness:</strong> <span t-esc="state.data.readiness.summary"/>
          <span class="ms-2 small"><t t-esc="state.data.readiness.setup_blocker_count"/> planning blocker(s) · <t t-esc="state.data.readiness.operational_action_count"/> operational action(s)</span>
        </section>

        <section class="card mt-3" aria-label="Operational tasks"><div class="card-body d-flex flex-wrap gap-2">
          <button t-if="state.data.operations.rosters_available" class="btn btn-outline-primary" t-att-disabled="state.data.operations.roster_action_count === 0" t-on-click="() => this.openOperation('rosters')">Teams needing rosters: <t t-esc="state.data.operations.roster_action_count"/></button>
          <button t-if="state.data.operations.lineups_available" class="btn btn-outline-primary" t-att-disabled="state.data.operations.lineup_action_count === 0" t-on-click="() => this.openOperation('lineups')">Game days needing lineups: <t t-esc="state.data.operations.lineup_action_count"/></button>
          <button t-if="state.data.operations.officials_available" class="btn btn-outline-primary" t-att-disabled="state.data.operations.official_action_count === 0" t-on-click="() => this.openOperation('officials')">Matches needing officials: <t t-esc="state.data.operations.official_action_count"/></button>
          <button t-if="state.data.operations.results_available" class="btn btn-outline-primary" t-att-disabled="state.data.operations.result_action_count === 0" t-on-click="() => this.openOperation('results')">Results awaiting approval: <t t-esc="state.data.operations.result_action_count"/></button>
        </div></section>
        <div class="row g-4 mt-1">
          <section class="col-xl-7" aria-labelledby="divisions-title">
            <div class="card h-100"><div class="card-header"><h2 id="divisions-title" class="h5 mb-0">Division readiness</h2></div>
              <div t-if="state.data.divisions.length" class="table-responsive"><table class="table align-middle mb-0">
                <thead><tr><th>Division</th><th>Teams</th><th>Format</th><th>Status</th></tr></thead>
                <tbody><tr t-foreach="state.data.divisions" t-as="division" t-key="division.id">
                  <td t-esc="division.name"/><td t-esc="division.team_count"/><td t-esc="division.format_name || division.format_status"/>
                  <td><span t-att-class="division.ready ? 'badge text-bg-success' : 'badge text-bg-warning'" t-esc="division.ready ? 'Ready' : 'Needs action'"/></td>
                </tr></tbody>
              </table></div>
              <div t-else="" class="card-body text-center py-5"><h3 class="h5">No divisions yet</h3><button class="btn btn-primary" t-on-click="openBasics">Define competition divisions</button></div>
            </div>
          </section>
          <aside t-if="state.data.can_use_advanced_tools" class="col-xl-5" aria-labelledby="issues-title"><div class="card h-100">
            <div class="card-header"><h2 id="issues-title" class="h5 mb-0">Action list</h2></div>
            <div t-if="state.data.issues.length" class="list-group list-group-flush">
              <button t-foreach="state.data.issues" t-as="issue" t-key="issue.key" class="list-group-item list-group-item-action text-start" t-on-click="() => this.openIssue(issue)" t-att-data-planner-issue="issue.key">
                <div class="d-flex gap-2 align-items-start"><i class="fa fa-exclamation-circle text-danger mt-1" aria-hidden="true"/><div class="flex-grow-1">
                  <strong t-esc="issue.title"/><div class="small text-muted" t-esc="issue.message"/>
                  <div class="small mt-1"><span t-esc="issue.action_label"/> · <span t-esc="issue.owner"/></div>
                </div></div>
              </button>
            </div>
            <div t-else="" class="card-body text-center py-5"><h3 class="h5">No blockers</h3><p class="text-muted mb-0">The setup is ready for operational handoff.</p></div>
          </div></aside>
          <aside t-else="" class="col-xl-5" aria-labelledby="operations-title"><div class="card h-100">
            <div class="card-header"><h2 id="operations-title" class="h5 mb-0">At a glance</h2></div>
            <div class="card-body">
              <p><strong>Game days:</strong> <t t-esc="state.data.operations.matchday_count"/></p>
              <p><strong>Schedules:</strong> <t t-esc="state.data.operations.schedule_count"/></p>
              <p t-if="state.data.operations.next_matchday"><strong>Next match day:</strong> <t t-esc="state.data.operations.next_matchday.name"/></p>
              <p class="text-muted mb-0">The workspace shows one next action at a time. Additional records remain available through contextual links and Advanced Tools.</p>
            </div>
          </div></aside>
        </div>
      </main>
    </div>
  </t>
</templates>
