<odoo>
  <record id="competition_gameday_setup_form" model="ir.ui.view">
   <field name="name">federation.competition.gameday.setup.form</field><field name="model">federation.competition.gameday.setup.wizard</field>
   <field name="arch" type="xml"><form string="Define Game Days"><group><field name="edition_id"/><field name="new_date"/><field name="default_venue_id"/><field name="default_start_hour" widget="float_time"/><field name="default_end_hour" widget="float_time"/><field name="default_slot_duration_minutes"/><button name="action_add_day" type="object" string="Add Game Day" class="btn-secondary"/></group><field name="line_ids" nolabel="1"><list editable="bottom"><field name="date"/><field name="name"/><field name="venue_id"/><field name="start_hour" widget="float_time"/><field name="end_hour" widget="float_time"/><field name="court_ids" widget="many2many_tags"/><field name="slot_duration_minutes"/><field name="noon_pause"/><field name="noon_pause_minutes" invisible="not noon_pause"/><field name="estimated_capacity" readonly="1" string="Match slots"/></list></field><footer><button name="action_save_continue" type="object" string="Save &amp; Plan Schedule" class="btn-primary"/><button name="action_save_close" type="object" string="Save and Close" class="btn-secondary"/><button string="Discard" special="cancel" class="btn-secondary"/></footer></form></field>
  </record>
</odoo>
