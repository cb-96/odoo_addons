<odoo>
  <record id="competition_gameday_setup_form" model="ir.ui.view">
    <field name="name">federation.competition.gameday.setup.form</field>
    <field name="model">federation.competition.gameday.setup.wizard</field>
    <field name="arch" type="xml">
      <form string="Game Days">
        <sheet>
          <div class="oe_title">
            <h1>Game days</h1>
            <p class="text-muted">Describe the pattern once, then adjust single days in the table below. To alternate divisions (for example men and women on some days, mixed on others), choose the divisions playing, add those days, then change the divisions and add the other days.</p>
          </div>
          <group>
            <group string="When">
              <field name="new_date" string="First game day"/>
              <field name="repeat_every_weeks"/>
              <field name="repeat_count"/>
              <field name="skip_dates" placeholder="e.g. 26/12/2026, 02/01/2027"/>
            </group>
            <group string="Where">
              <field name="default_venue_id" string="Venue"/>
              <field name="default_start_hour" widget="float_time" string="First match"/>
              <field name="default_end_hour" widget="float_time" string="Last match ends"/>
              <field name="default_slot_duration_minutes" string="Minutes per match"/>
              <field name="default_division_ids" widget="many2many_tags" placeholder="All divisions" options="{'no_create': True}"/>
            </group>
          </group>
          <div class="d-flex gap-2 mb-3">
            <button name="action_add_recurring_days" type="object" string="Add game days" class="btn-primary"/>
            <button name="action_copy_last_day" type="object" string="Add one more like the last" class="btn-secondary" invisible="not line_ids"/>
          </div>
          <field name="line_ids" nolabel="1">
            <list editable="bottom">
              <field name="date"/>
              <field name="name"/>
              <field name="venue_id"/>
              <field name="start_hour" widget="float_time"/>
              <field name="end_hour" widget="float_time"/>
              <field name="court_ids" widget="many2many_tags"/>
              <field name="division_ids" widget="many2many_tags" placeholder="All divisions" options="{'no_create': True}"/>
              <field name="slot_duration_minutes" optional="hide"/>
              <field name="noon_pause" optional="hide"/>
              <field name="noon_pause_minutes" invisible="not noon_pause" optional="hide"/>
              <field name="estimated_capacity" readonly="1" string="Match slots"/>
            </list>
          </field>
          <!-- Technical relay: the edition scopes every game day. -->
          <field name="edition_id" invisible="1"/>
        </sheet>
        <footer>
          <button name="action_save_continue" type="object" string="Save &amp; Plan Schedule" class="btn-primary"/>
          <button name="action_save_close" type="object" string="Save" class="btn-secondary"/>
          <button string="Discard" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
