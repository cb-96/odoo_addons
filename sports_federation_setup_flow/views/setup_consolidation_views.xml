<odoo>
  <record id="view_competition_edition_list_setup_flow" model="ir.ui.view">
    <field name="name">federation.competition.edition.list.setup.flow</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="sports_federation_tournament.view_federation_competition_edition_list"/>
    <field name="arch" type="xml">
      <field name="state" position="before">
        <field name="setup_next_action" optional="show"/>
      </field>
    </field>
  </record>

  <record id="action_competition_setup_home" model="ir.actions.act_window">
    <field name="name">Competition Hub</field>
    <field name="res_model">federation.competition.edition</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_active': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create a competition to start its guided setup.</p>
      <p>Open a competition and use Continue Setup to resume at the first incomplete task.</p>
    </field>
  </record>

  <record id="menu_competition_setup_home" model="ir.ui.menu">
    <field name="name">Competition Hub</field>
    <field name="action" ref="action_competition_setup_home"/>
    <field name="parent_id" ref="sports_federation_base.menu_federation_competitions"/>
    <field name="sequence">1</field>
  </record>

  <record id="competition_edition_list_workspace" model="ir.ui.view">
    <field name="name">federation.competition.edition.list.workspace</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="sports_federation_tournament.view_federation_competition_edition_list"/>
    <field name="arch" type="xml">
      <xpath expr="//list" position="attributes">
        <attribute name="create">0</attribute>
      </xpath>
      <xpath expr="//list" position="inside">
        <header>
          <button name="%(sports_federation_registration.action_create_competition_wizard)d" type="action" string="Create Competition" class="btn-primary" display="always"/>
        </header>
      </xpath>
      <field name="tournament_count" position="after">
        <field name="setup_progress" widget="progressbar" string="Readiness"/>
        <field name="setup_next_action" string="Next Action"/>
        <button name="action_open_competition_planner" type="object" string="Open Workspace" class="btn-primary" data-keyboard-competition-setup="true"/>
      </field>
    </field>
  </record>
</odoo>
