<odoo>
  <record id="practice_competition_wizard_form" model="ir.ui.view">
    <field name="name">federation.practice.competition.wizard.form</field>
    <field name="model">federation.practice.competition.wizard</field>
    <field name="arch" type="xml">
      <form string="Create Practice Competition">
        <sheet>
          <div class="oe_title">
            <h1>Practice competition</h1>
            <p class="text-muted">Builds a complete sample competition with sample clubs, teams, game days and a published schedule, then gives you a checklist of screens to look at. It is never shown on the public website and you can remove it in one click.</p>
          </div>
          <group>
            <group>
              <field name="name"/>
              <field name="competition_type"/>
              <field name="workflow_mode"/>
            </group>
            <group>
              <field name="division_count"/>
              <field name="teams_per_division"/>
              <field name="gameday_count" invisible="competition_type == 'tournament_day'"/>
              <field name="first_gameday_today"/>
              <field name="first_gameday" invisible="first_gameday_today" required="not first_gameday_today"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button name="action_create" type="object" string="Create practice competition" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_practice_competition_wizard" model="ir.actions.act_window">
    <field name="name">Create Practice Competition</field>
    <field name="res_model">federation.practice.competition.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="group_ids" eval="[(6, 0, [ref('sports_federation_base.group_federation_manager')])]"/>
  </record>

  <record id="competition_edition_list_practice" model="ir.ui.view">
    <field name="name">federation.competition.edition.list.practice</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="competition_edition_list_workspace"/>
    <field name="arch" type="xml">
      <xpath expr="//header/button" position="after">
        <button name="%(action_practice_competition_wizard)d" type="action" string="Practice Competition" class="btn-secondary" display="always" groups="sports_federation_base.group_federation_manager"/>
      </xpath>
      <xpath expr="//list" position="inside">
        <field name="is_practice" widget="boolean_toggle" readonly="1" optional="show" string="Practice"/>
      </xpath>
    </field>
  </record>

  <record id="competition_edition_form_practice" model="ir.ui.view">
    <field name="name">federation.competition.edition.form.practice</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="sports_federation_tournament.view_federation_competition_edition_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <button name="action_remove_practice_competition" type="object" string="Remove practice competition" class="btn-secondary" invisible="not is_practice" confirm="Archive this practice competition and its unused sample clubs?" groups="sports_federation_base.group_federation_manager"/>
      </xpath>
      <xpath expr="//sheet/*[1]" position="before">
        <widget name="web_ribbon" title="Practice" bg_color="text-bg-warning" invisible="not is_practice"/>
        <!-- Technical modifier relay: is_practice drives the ribbon and remove button. -->
        <field name="is_practice" invisible="1"/>
      </xpath>
    </field>
  </record>

  <record id="competition_edition_search_practice" model="ir.ui.view">
    <field name="name">federation.competition.edition.search.practice</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="sports_federation_tournament.view_federation_competition_edition_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <filter name="practice" string="Practice" domain="[('is_practice', '=', True)]"/>
        <filter name="real" string="Real competitions" domain="[('is_practice', '=', False)]"/>
      </xpath>
    </field>
  </record>
</odoo>
