<odoo>
  <record id="matchday_focus_form" model="ir.ui.view">
    <field name="name">federation.matchday.focus.form</field><field name="model">federation.matchday</field><field name="priority">99</field>
    <field name="arch" type="xml"><form string="Run Match Day" create="0" edit="0">
      <header>
        <button name="action_open_matchday_operations" type="object" string="Start Match Day" class="btn-primary" invisible="state == 'open' or readiness_state != 'ready'" confirm="Start this match day using the published schedule?"/>
        <button name="action_prepare_lineups" type="object" string="Prepare Lineups" invisible="state not in ('scheduled', 'open')"/>
        <button name="action_open_focus_results" type="object" string="Enter Results"/>
        <button name="action_open_court_status_wizard" type="object" string="Update Court" invisible="state != 'open'"/>
        <button name="action_open_incident_wizard" type="object" string="Report Incident" invisible="state != 'open'"/>
        <button name="action_open_deviation_wizard" type="object" string="Delay or Move Match" invisible="state != 'open'"/>
        <button name="action_close_matchday_operations" type="object" string="Finish Match Day" invisible="state != 'open'"/>
        <button name="action_open_focus_history" type="object" string="Details and History"/>
        <field name="state" widget="statusbar"/>
      </header>
      <sheet><group><field name="name"/><field name="date"/><field name="venue_id"/><field name="readiness_state" widget="badge"/><field name="readiness_message"/></group>
      <field name="published_match_ids" readonly="1"><list create="0" delete="0"><field name="date_scheduled"/><field name="name"/><field name="operational_slot_id" string="Court and time"/><field name="operational_status" widget="badge"/><field name="state" widget="badge"/><field name="is_officially_ready" string="Officials ready"/><button name="action_open_quick_result" type="object" string="Enter Result" invisible="state != 'done'"/></list></field>
      </sheet></form></field>
  </record>
  <record id="result_focus_list" model="ir.ui.view"><field name="name">federation.match.result.focus.list</field><field name="model">federation.match</field><field name="priority">99</field><field name="arch" type="xml"><list create="0" delete="0"><field name="date_scheduled"/><field name="name"/><field name="home_score"/><field name="away_score"/><field name="result_state" widget="badge"/><button name="action_open_quick_result" type="object" string="Enter Score" invisible="result_state not in ('draft', 'corrected')"/><button name="action_verify_result" type="object" string="Verify" invisible="result_state != 'submitted'"/><button name="action_approve_result" type="object" string="Approve" invisible="result_state != 'verified'"/></list></field></record>
  <record id="quick_result_form" model="ir.ui.view"><field name="name">federation.quick.result.form</field><field name="model">federation.quick.result.wizard</field><field name="arch" type="xml"><form string="Enter Result"><group><field name="match_id"/><field name="home_score"/><field name="away_score"/><field name="score_entry_confirmed"/><field name="zero_zero_confirmed" invisible="home_score != 0 or away_score != 0"/></group><div class="alert alert-info">Save keeps a draft. Submit follows this competition's review policy; it does not bypass independent approval.</div><footer><button name="action_submit" type="object" string="Submit Result" class="btn-primary"/><button name="action_save" type="object" string="Save Draft"/><button string="Cancel" special="cancel"/></footer></form></field></record>
  <record id="creation_draft_owner_rule" model="ir.rule"><field name="name">Creation drafts belong to their creator</field><field name="model_id" ref="model_federation_competition_creation_draft"/><field name="domain_force">[('owner_id', '=', user.id)]</field></record>
  <record id="creation_draft_list" model="ir.ui.view"><field name="name">competition.creation.draft.list</field><field name="model">federation.competition.creation.draft</field><field name="arch" type="xml"><list create="0" edit="0"><field name="name"/><field name="write_date" string="Last saved"/><button name="action_resume" type="object" string="Resume Draft"/></list></field></record>
  <record id="action_creation_drafts" model="ir.actions.act_window"><field name="name">My Creation Drafts</field><field name="res_model">federation.competition.creation.draft</field><field name="view_mode">list</field></record>
  <menuitem id="menu_creation_drafts" name="My Creation Drafts" parent="sports_federation_competition_core.menu_competition_engine_competition_root" action="action_creation_drafts" sequence="3" groups="sports_federation_base.group_federation_manager"/>
</odoo>
