<odoo>
  <record id="create_competition_wizard_journey" model="ir.ui.view">
    <field name="name">federation.create.competition.wizard.journey</field>
    <field name="model">federation.create.competition.wizard</field>
    <field name="inherit_id" ref="sports_federation_registration.create_competition_wizard_form"/>
    <field name="arch" type="xml">
      <field name="setup_template" position="attributes">
        <attribute name="string">Competition Type</attribute>
      </field>
      <field name="competition_id" position="attributes"><attribute name="string">Parent competition</attribute><attribute name="invisible">not show_additional_settings</attribute><attribute name="placeholder">Created from the name</attribute></field>
      <field name="season_id" position="attributes"><attribute name="string">Season</attribute><attribute name="invisible">not show_additional_settings</attribute><attribute name="placeholder">Derived from the start date</attribute></field>
      <field name="name" position="attributes"><attribute name="string">Competition name</attribute></field>
      <field name="rule_set_id" position="attributes"><attribute name="string">Rule set</attribute><attribute name="invisible">not show_additional_settings</attribute></field>
      <field name="date_start" position="attributes"><attribute name="string">First game day</attribute></field>
      <field name="date_end" position="attributes"><attribute name="string">Last game day</attribute></field>
      <field name="setup_template" position="after">
        <field name="show_additional_settings" string="Show additional settings"/>

        <group string="Workflow and responsibility" invisible="not show_additional_settings">
          <field name="workflow_mode" widget="radio" options="{'horizontal': true}"/>
          <div class="alert alert-info" role="status">
            <strong>What this changes</strong>
            <div><field name="workflow_summary" nolabel="1" readonly="1"/></div>
          </div>
          <group string="Planning defaults" col="4" invisible="not show_additional_settings">
            <field name="default_format_type"/>
            <field name="default_venue_id"/>
            <field name="default_start_hour" widget="float_time"/>
            <field name="default_end_hour" widget="float_time"/>
            <field name="default_slot_duration_minutes"/>
          </group>
        </group>
      </field>
      <xpath expr="//group[field[@name='registration_open']]" position="attributes"><attribute name="invisible">not show_additional_settings</attribute></xpath>
      <xpath expr="//page[field[@name='role_line_ids']]" position="attributes"><attribute name="invisible">not show_additional_settings</attribute></xpath>
      <xpath expr="//page[field[@name='role_line_ids']]" position="inside">
        <div class="alert alert-info" role="status">These assignments route responsibility within this competition; they do not grant record access. In Settings &gt; Users &amp; Companies &gt; Users, grant the needed global groups too: Federation User as the base, Registration Manager for team and participant setup, Calendar Planner for game days, Schedule Planner for working schedules, and Schedule Approver for independent review.</div>
      </xpath>
      <field name="code" position="attributes"><attribute name="column_invisible">not parent.show_additional_settings</attribute></field>
      <field name="category" position="attributes"><attribute name="string">Category</attribute><attribute name="optional">show</attribute></field>
      <field name="gender" position="attributes"><attribute name="string">Gender</attribute><attribute name="optional">show</attribute></field>
      <field name="tournament_type" position="attributes"><attribute name="column_invisible">not parent.show_additional_settings</attribute></field>
      <!-- Technical fields kept invisible for view modifiers and domains. -->
      <xpath expr="//footer" position="inside"><button name="action_save_creation_draft" type="object" string="Save Draft"/><field name="creation_draft_id" invisible="1"/></xpath>
      <button name="action_create_competition" position="attributes">
        <attribute name="string">Create and Continue</attribute>
      </button>
    </field>
  </record>
</odoo>
