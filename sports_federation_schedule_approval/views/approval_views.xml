<odoo>
 <record id="review_list" model="ir.ui.view"><field name="name">federation.schedule.review.list</field><field name="model">federation.schedule.review</field><field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-warning="state == 'changes_requested'"><field name="schedule_id"/><field name="edition_id"/><field name="submitted_revision"/><field name="reviewer_id"/><field name="state" widget="badge"/></list></field></record>
 <record id="review_form" model="ir.ui.view"><field name="name">federation.schedule.review.form</field><field name="model">federation.schedule.review</field><field name="arch" type="xml"><form><header><field name="state" widget="statusbar" statusbar_visible="pending,changes_requested,approved"/></header><sheet><group><field name="schedule_id"/><field name="edition_id"/><field name="submitted_revision"/><field name="reviewer_id"/><field name="review_note"/></group><field name="assignment_snapshot" readonly="1"/></sheet><chatter/></form></field></record>
 <record id="action_schedule_review_queue" model="ir.actions.act_window"><field name="name">Schedule Review Queue</field><field name="res_model">federation.schedule.review</field><field name="view_mode">list,form</field><field name="domain">[('state','=','pending')]</field></record>
</odoo>
