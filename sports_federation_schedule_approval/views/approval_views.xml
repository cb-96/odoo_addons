<odoo>
  <record id="schedule_form_approval_handoff" model="ir.ui.view">
    <field name="name">federation.schedule.form.approval.handoff</field>
    <field name="model">federation.schedule</field>
    <field name="inherit_id" ref="sports_federation_scheduling.schedule_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group[1]" position="before">
        <div class="oe_button_box" name="button_box">
          <button name="action_open_current_review" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="review_count == 0">
            <field name="review_count" widget="statinfo" string="Reviews"/>
          </button>
        </div>
        <field name="current_review_id" invisible="1"/>
      </xpath>
    </field>
  </record>

  <record id="review_list" model="ir.ui.view">
    <field name="name">federation.schedule.review.list</field>
    <field name="model">federation.schedule.review</field>
    <field name="arch" type="xml">
      <list create="0" delete="0" decoration-success="state == 'approved'" decoration-warning="state == 'changes_requested'">
        <field name="schedule_id"/>
        <field name="edition_id"/>
        <field name="submitted_revision"/>
        <field name="submitted_by_id"/>
        <field name="reviewer_id"/>
        <field name="reviewed_at"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="review_form" model="ir.ui.view">
    <field name="name">federation.schedule.review.form</field>
    <field name="model">federation.schedule.review</field>
    <field name="arch" type="xml">
      <form create="0" delete="0">
        <header>
          <button name="action_withdraw_submission" type="object" groups="sports_federation_scheduling.group_schedule_planner,sports_federation_base.group_federation_manager" string="Withdraw Submission" invisible="state != 'pending'" confirm="Withdraw this submission and return it to planning?"/>
          <button name="action_request_changes" type="object" groups="sports_federation_schedule_approval.group_schedule_approver,sports_federation_base.group_federation_manager" string="Request Changes" invisible="state != 'pending'" confirm="Return this schedule to the planner for changes?"/>
          <button name="action_approve_schedule" type="object" groups="sports_federation_schedule_approval.group_schedule_approver,sports_federation_base.group_federation_manager" string="Approve Schedule" class="btn-primary" invisible="state != 'pending'" confirm="Approve this immutable submitted revision?"/>
          <button name="action_publish_schedule" type="object" groups="sports_federation_schedule_approval.group_schedule_approver,sports_federation_base.group_federation_manager" string="Publish Schedule" class="btn-primary" invisible="state != 'approved'" confirm="Publish this approved schedule for match-day execution?"/>
          <button name="action_open_schedule" type="object" string="Open Working Schedule"/>
          <field name="state" widget="statusbar" statusbar_visible="pending,changes_requested,approved"/>
        </header>
        <sheet>
          <div class="alert alert-info" role="status" invisible="state != 'pending'">Review the immutable submitted snapshot. Add a note, then request changes or approve it. The submitting planner cannot decide their own review.</div>
          <div class="alert alert-warning" role="status" invisible="state != 'changes_requested'">This review is retained as historical evidence. The planner must update the working schedule and submit a new revision.</div>
          <div class="alert alert-success" role="status" invisible="state != 'approved'">The schedule is independently approved and ready for publication.</div>
          <group>
            <group>
              <field name="schedule_id" readonly="1"/>
              <field name="edition_id" readonly="1"/>
              <field name="submitted_revision" readonly="1"/>
              <field name="snapshot_digest" readonly="1" groups="sports_federation_base.group_federation_manager"/>
            </group>
            <group>
              <field name="submitted_by_id" readonly="1"/>
              <field name="reviewer_id" readonly="1"/>
              <field name="reviewed_at" readonly="1"/>
              <field name="review_note" readonly="state != 'pending'" placeholder="Required when requesting changes. Optional approval note. Used as the replacement reason when publishing over a live schedule."/>
            </group>
          </group>
          <group string="Immutable submitted assignments">
            <field name="assignment_snapshot" readonly="1" nolabel="1"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>


  <record id="review_search" model="ir.ui.view">
    <field name="name">federation.schedule.review.search</field>
    <field name="model">federation.schedule.review</field>
    <field name="arch" type="xml">
      <search>
        <field name="schedule_id"/>
        <field name="edition_id"/>
        <field name="submitted_by_id"/>
        <field name="reviewer_id"/>
        <filter name="pending" string="Pending" domain="[('state','=','pending')]"/>
        <filter name="changes_requested" string="Changes Requested" domain="[('state','=','changes_requested')]"/>
        <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
        <group>
          <filter name="group_edition" string="Edition" context="{'group_by':'edition_id'}"/>
          <filter name="group_state" string="State" context="{'group_by':'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="publication_list" model="ir.ui.view">
    <field name="name">federation.schedule.publication.list</field>
    <field name="model">federation.schedule.publication</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'live'" decoration-muted="state == 'superseded'">
        <field name="edition_id"/>
        <field name="matchday_id"/>
        <field name="schedule_id"/>
        <field name="version"/>
        <field name="source_revision"/>
        <field name="published_by_id"/>
        <field name="published_at"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>

  <record id="publication_form" model="ir.ui.view">
    <field name="name">federation.schedule.publication.form</field>
    <field name="model">federation.schedule.publication</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <header>
          <button name="action_open_schedule" type="object" string="Open Source Schedule"/>
          <field name="state" widget="statusbar" statusbar_visible="live,superseded"/>
        </header>
        <sheet>
          <div class="alert alert-success" role="status" invisible="state != 'live'">This is the current immutable schedule used by Match-Day Operations.</div>
          <div class="alert alert-secondary" role="status" invisible="state != 'superseded'">This historical publication has been replaced and remains available as audit evidence.</div>
          <group>
            <group><field name="edition_id"/><field name="matchday_id"/><field name="schedule_id"/><field name="review_id"/><field name="version"/><field name="source_revision"/></group>
            <group><field name="published_by_id"/><field name="published_at"/><field name="reason"/><field name="snapshot_digest" groups="sports_federation_base.group_federation_manager"/></group>
          </group>
          <group string="Immutable published assignments"><field name="assignment_snapshot" nolabel="1"/></group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_schedule_review_queue" model="ir.actions.act_window">
    <field name="name">Schedule Review Queue</field>
    <field name="res_model">federation.schedule.review</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','=','pending')]</field>
    <field name="context">{'search_default_pending': 1}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No schedules are waiting for independent review.</p></field>
  </record>
  <record id="action_approved_schedule_queue" model="ir.actions.act_window">
    <field name="name">Approved Schedules</field>
    <field name="res_model">federation.schedule.review</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('state','=','approved'),('schedule_id.state','=','approved')]</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No approved schedules are waiting for publication.</p></field>
  </record>
  <record id="action_schedule_publication_history" model="ir.actions.act_window">
    <field name="name">Schedule Publications</field>
    <field name="res_model">federation.schedule.publication</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
