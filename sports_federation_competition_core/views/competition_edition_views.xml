<odoo>
  <record id="competition_edition_form_workflow" model="ir.ui.view">
    <field name="name">federation.competition.edition.form.workflow</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="sports_federation_tournament.view_federation_competition_edition_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_role_assignments" type="object" class="oe_stat_button" icon="fa-users">
          <field name="role_assignment_count" widget="statinfo" string="Responsibilities"/>
        </button>
        <button name="action_competition_events" type="object" class="oe_stat_button" icon="fa-history">
          <field name="event_count" widget="statinfo" string="History"/>
        </button>
      </xpath>
      <xpath expr="//notebook" position="before">
        <group string="Competition workflow">
          <field name="workflow_progress" widget="progressbar"/>
          <field name="journey_state" widget="badge" readonly="1"/><field name="journey_blocker_count" readonly="1"/><field name="workflow_next_action" readonly="1"/><button name="action_open_next_workspace" type="object" string="Open Next Workspace" class="btn-primary"/>
        </group>
      </xpath>
      <xpath expr="//notebook" position="inside">
        <page string="Advanced Workflow" name="workflow_policy" groups="sports_federation_base.group_federation_advanced_operator">
          <group><field name="workflow_mode"/><div class="alert alert-info" role="status">Streamlined completes routine checkpoints automatically after validation. Independent Review requires another responsible person. Advanced / Custom exposes every checkpoint. All modes keep permissions, audit history and immutable official snapshots.</div></group>
          <group string="Registration and format"><field name="registration_approval_required"/><field name="structure_freeze_confirmation_required"/></group>
          <group string="Schedules"><field name="schedule_approval_required"/><field name="schedule_self_approval_allowed" invisible="not schedule_approval_required"/><field name="schedule_auto_publish_after_approval"/></group>
          <group string="Results"><field name="result_verification_required"/><field name="result_approval_required"/><field name="result_self_verification_allowed" invisible="not result_verification_required"/><field name="result_self_approval_allowed" invisible="not result_approval_required"/><field name="auto_recompute_standings"/></group>
          <group string="Progression and teams"><field name="standings_freeze_confirmation_required"/><field name="auto_progress_completed_stage"/><field name="roster_approval_required"/><field name="match_sheet_approval_required"/></group>
        </page>
        <page string="Responsibilities" name="responsibilities">
          <field name="role_assignment_ids" context="{'default_edition_id': id}">
            <list editable="bottom"><field name="role"/><field name="user_id"/><field name="active"/></list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
  <record id="action_competition_overview" model="ir.actions.act_window">
    <field name="name">Competition Overview</field><field name="res_model">federation.competition.edition</field><field name="view_mode">kanban,list,form</field>
  </record>
</odoo>
