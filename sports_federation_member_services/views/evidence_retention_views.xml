<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="member_evidence_revision_list" model="ir.ui.view">
    <field name="name">federation.member.evidence.revision.list</field>
    <field name="model">federation.member.evidence.revision</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="person_id"/>
        <field name="request_id"/>
        <field name="revision"/>
        <field name="filename"/>
        <field name="uploaded_by_id"/>
        <field name="create_date" string="Retained on"/>
        <field name="legal_hold"/>
        <field name="legal_hold_on"/>
      </list>
    </field>
  </record>

  <record id="member_evidence_revision_form" model="ir.ui.view">
    <field name="name">federation.member.evidence.revision.form</field>
    <field name="model">federation.member.evidence.revision</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <sheet>
          <group>
            <group>
              <field name="person_id"/>
              <field name="request_id"/>
              <field name="revision"/>
              <field name="checksum"/>
              <field name="document" filename="filename"/>
              <!-- Technical relay: filename names the downloaded document. -->
              <field name="filename" invisible="1"/>
              <field name="uploaded_by_id"/>
              <field name="create_date" string="Retained on"/>
            </group>
            <group string="Legal hold">
              <field name="legal_hold"/>
              <field name="legal_hold_reason"/>
              <field name="legal_hold_by_id"/>
              <field name="legal_hold_on"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="member_evidence_revision_search" model="ir.ui.view">
    <field name="name">federation.member.evidence.revision.search</field>
    <field name="model">federation.member.evidence.revision</field>
    <field name="arch" type="xml">
      <search>
        <field name="person_id"/>
        <field name="request_id"/>
        <filter name="held" string="Under legal hold" domain="[('legal_hold', '=', True)]"/>
        <filter name="not_held" string="Not held" domain="[('legal_hold', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="action_member_evidence_revision" model="ir.actions.act_window">
    <field name="name">Member evidence history</field>
    <field name="res_model">federation.member.evidence.revision</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="member_evidence_revision_search"/>
  </record>

  <menuitem id="menu_member_evidence_revision" name="Member Evidence History"
            action="action_member_evidence_revision"
            parent="sports_federation_base.menu_federation_system_health"
            groups="sports_federation_base.group_federation_manager" sequence="72"/>

  <record id="member_evidence_governance_wizard_form" model="ir.ui.view">
    <field name="name">federation.member.evidence.governance.wizard.form</field>
    <field name="model">federation.member.evidence.governance.wizard</field>
    <field name="arch" type="xml">
      <form string="Legal hold or erasure">
        <group>
          <field name="operation" widget="radio"/>
          <field name="revision_ids" widget="many2many_tags" readonly="1"/>
          <field name="reason" placeholder="Case or request reference and why this decision is taken"/>
          <field name="confirm_erasure" invisible="operation != 'erase'"/>
        </group>
        <p class="text-muted" invisible="operation != 'erase'">
          Erasure permanently deletes the selected revisions and their files. Revisions under legal hold are refused. The decision is recorded on each request and in retention evidence.
        </p>
        <footer>
          <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_member_evidence_governance_wizard" model="ir.actions.act_window">
    <field name="name">Legal hold or erasure</field>
    <field name="res_model">federation.member.evidence.governance.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="model_federation_member_evidence_revision"/>
    <field name="binding_view_types">list,form</field>
    <field name="group_ids" eval="[(4, ref('sports_federation_base.group_federation_manager'))]"/>
  </record>
</odoo>
