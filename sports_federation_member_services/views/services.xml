<template id="family" name="Member and Family Services"><t t-call="portal.portal_layout"><main class="container py-4">
<h1>My membership and family</h1><p>Membership, document verification and sporting eligibility are separate checks. Payer status does not grant access to personal documents.</p>
<a href="/my/work">Return to my work</a><a href="/my/invoices" class="btn btn-link">My invoices</a>
<p role="status" t-esc="feedback"/>
<h2>Memberships</h2><div t-foreach="memberships" t-as="m" class="card p-3 mb-3"><h3 t-esc="m['person']"/>
<p><t t-esc="m['club']"/> · <t t-esc="m['season']"/> · <t t-esc="m['role']"/> · <t t-esc="m['state']"/></p><p t-esc="m['note']"/>
<form t-att-action="'/my/family/memberships/%s/renew' % m['id']" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<label t-att-for="'season-%s' % m['id']">Renew for an open season</label><select name="season_id" t-att-id="'season-%s' % m['id']" required="required" class="form-select"><option t-foreach="seasons" t-as="s" t-att-value="s.id" t-esc="s.name"/></select><button class="btn btn-primary mt-2">Request renewal</button></form></div>
<h2>Document requests</h2><div t-foreach="requests" t-as="r" class="card p-3 mb-3"><h3 t-esc="r['name']"/><p t-esc="r['purpose']"/><p>Deadline: <t t-esc="r['deadline']"/></p><p>Status: <t t-esc="r['state']"/></p><p t-esc="r['note']"/>
<form t-if="r['can_upload']" t-att-action="'/my/family/requests/%s/upload' % r['id']" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
<label t-att-for="'doc-%s' % r['id']">Document (PDF, PNG or JPEG, maximum 10 MB)</label><input type="file" name="document" t-att-id="'doc-%s' % r['id']" required="required" accept=".pdf,.png,.jpg,.jpeg" class="form-control"/><button class="btn btn-primary mt-2">Upload for review</button></form></div>
</main></t></template>
</odoo>
