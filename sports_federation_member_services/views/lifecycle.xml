<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <template id="family_lifecycle" name="Member and family lifecycle"><t t-call="portal.portal_layout"><main class="container py-4">
    <h1>My membership and family</h1><p>Choose the named person before acting. Membership, licence, payment and sporting eligibility are separate checks.</p><a href="/my/work" class="btn btn-outline-secondary mb-3">My federation work</a><a href="/my/family" class="btn btn-outline-secondary mb-3 ms-2">All authorised family members</a>
    <p t-if="feedback" class="alert alert-info" role="status"><t t-esc="feedback"/></p>
    <article t-foreach="people" t-as="person" class="card p-3 mb-4" t-att-data-family-person="person['id']"><h2><t t-esc="person['name']"/> <span class="badge text-bg-light"><t t-if="person['self']">You</t><t t-elif="person['personal']">Verified dependant</t><t t-else="">Club-managed person</t></span></h2><a t-attf-href="/my/family?person_id=#{person['id']}" class="btn btn-outline-primary mb-3">Focus on this person</a>
      <p t-if="not person['memberships']">No membership records are visible for this person.</p>
      <section t-foreach="person['memberships']" t-as="m" class="border rounded p-3 mb-3" t-att-data-membership="m['id']"><h3 class="h5"><t t-esc="m['club']"/> · <t t-esc="m['season']"/> · <t t-esc="m['role']"/></h3><dl><dt>Membership</dt><dd><t t-esc="m['membership']"/></dd><dt>Licence</dt><dd><t t-esc="m['licence']"/></dd><dt>Payment</dt><dd><t t-esc="m['payment']"/> <a t-if="m['invoice_url']" t-att-href="m['invoice_url']">Open your invoice</a></dd><dt>Sporting eligibility</dt><dd><t t-esc="m['eligibility']"/><ul><li t-foreach="m['blockers']" t-as="blocker"><t t-esc="blocker"/></li></ul></dd><dt>Next owner</dt><dd><t t-esc="m['owner']"/></dd></dl><p t-esc="m['note']"/>
        <form t-if="m['state'] == 'active'" t-attf-action="/my/family/memberships/#{m['id']}/renew" method="post" class="mb-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="person_id" t-att-value="person['id']"/><label t-attf-for="renew-season-#{m['id']}">Renew for a later open season</label><select name="season_id" t-attf-id="renew-season-#{m['id']}" class="form-select" required="required"><option value="">Choose season</option><option t-foreach="[s for s in seasons if s['start'] &gt; m['season_start']]" t-as="s" t-att-value="s['id']"><t t-esc="s['name']"/></option></select><label class="d-block my-2"><input type="checkbox" name="confirmed" value="yes" required="required"/> I am requesting renewal for <strong><t t-esc="person['name']"/></strong>, not activation.</label><button type="submit" class="btn btn-primary">Request renewal for this person</button></form>
        <form t-if="m['can_licence']" t-attf-action="/my/family/memberships/#{m['id']}/licence" method="post" class="mb-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="person_id" t-att-value="person['id']"/><label class="d-block"><input type="checkbox" name="confirmed" value="yes" required="required"/> Request a draft licence for <t t-esc="person['name']"/>; federation activation is separate.</label><button type="submit" class="btn btn-outline-primary">Request missing licence</button></form>
        <details><summary>Cancellation, reactivation or membership transfer</summary><p>Federation review is required. These membership actions do not transfer player club, licences or rosters, and do not cancel or refund invoices.</p><form t-attf-action="/my/family/memberships/#{m['id']}/change" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="person_id" t-att-value="person['id']"/><label t-attf-for="change-kind-#{m['id']}">Requested action</label><select name="kind" t-attf-id="change-kind-#{m['id']}" class="form-select"><option t-if="m['state'] == 'active'" value="cancel">Cancellation</option><option t-if="m['state'] == 'active'" value="transfer">Membership transfer</option><option t-if="m['state'] == 'cancelled'" value="reactivate">Reactivation review</option></select><label t-attf-for="change-club-#{m['id']}">Destination club, only for membership transfer</label><select name="target_club_id" t-attf-id="change-club-#{m['id']}" class="form-select"><option value="">Not applicable</option><option t-foreach="clubs" t-as="club" t-att-value="club['id']"><t t-esc="club['name']"/></option></select><label t-attf-for="change-reason-#{m['id']}">Reason</label><textarea name="reason" t-attf-id="change-reason-#{m['id']}" class="form-control" required="required"/><label class="d-block my-2"><input type="checkbox" name="confirmed" value="yes" required="required"/> This request concerns <strong><t t-esc="person['name']"/></strong>.</label><button type="submit" class="btn btn-outline-primary">Request federation decision</button></form><p t-foreach="m['changes']" t-as="change"><t t-esc="change['kind']"/>: <t t-esc="change['state']"/>. <t t-esc="change['note']"/></p></details>
      </section>
      <h3 class="h5">Required documents for <t t-esc="person['name']"/></h3><section t-foreach="person['requests']" t-as="doc" class="border rounded p-3 mb-3" t-att-data-document-request="doc['id']"><h4 class="h6"><t t-esc="doc['name']"/></h4><p><t t-esc="doc['purpose']"/></p><p>Status: <t t-esc="doc['state']"/>. Revision: <t t-esc="doc['revision']"/>. Deadline: <t t-esc="doc['deadline']"/>. Next owner: <t t-esc="doc['owner']"/>.</p><p style="white-space: pre-line"><t t-esc="doc['note']"/></p><a t-if="doc['revision']" t-attf-href="/my/family/requests/#{doc['id']}/download?person_id=#{person['id']}">Download current evidence for this person</a><form t-if="doc['can_upload']" t-attf-action="/my/family/requests/#{doc['id']}/upload" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="person_id" t-att-value="person['id']"/><label t-attf-for="family-doc-#{doc['id']}">Evidence for <t t-esc="person['name']"/> (PDF, PNG or JPEG; configured upload limit applies)</label><input type="file" name="document" t-attf-id="family-doc-#{doc['id']}" class="form-control" accept=".pdf,.png,.jpg,.jpeg" required="required"/><label class="d-block my-2"><input type="checkbox" name="confirmed" value="yes" required="required"/> This evidence belongs to <strong><t t-esc="person['name']"/></strong>. Upload is not verification.</label><button type="submit" class="btn btn-primary">Upload for this person's review</button></form></section>
    </article>
    <details class="border rounded p-3"><summary>Request a guardian relationship</summary><p>Ask federation staff for the person's private family reference. A reference alone does not grant access. Do not provide unnecessary identity data; submit only the requested relationship evidence.</p><form action="/my/family/guardian-request" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="family-reference">Private family reference</label><input id="family-reference" name="reference" class="form-control" required="required" autocomplete="off"/><label for="guardian-reason">Relationship reason</label><textarea id="guardian-reason" name="reason" class="form-control" required="required"/><label for="guardian-evidence">Requested evidence</label><input id="guardian-evidence" name="document" type="file" class="form-control" accept=".pdf,.png,.jpg,.jpeg" required="required"/><button type="submit" class="btn btn-primary mt-2">Submit for independent review</button></form><p t-foreach="claims" t-as="claim">Relationship request <t t-esc="claim['id']"/>: <t t-esc="claim['state']"/>. <t t-esc="claim['note']"/></p></details>
  </main></t></template>
  <template id="family_work_link" inherit_id="sports_federation_portal.role_home"><xpath expr="//h1" position="after"><a href="/my/family" class="btn btn-outline-primary mb-3">My membership and family</a></xpath></template>
  <template id="family_home_link" inherit_id="portal.portal_my_home"><xpath expr="//div[hasclass('o_portal_docs')]" position="before"><a href="/my/family" class="btn btn-outline-primary my-3">My membership and family</a></xpath></template>
  <record id="membership_lifecycle_form" model="ir.ui.view"><field name="name">membership.lifecycle.form</field><field name="model">federation.person.membership</field><field name="inherit_id" ref="person_membership_form"/><field name="arch" type="xml"><xpath expr="//form" position="attributes"><attribute name="string">Membership review, not sporting activation</attribute></xpath><xpath expr="//sheet" position="before"><header><button name="action_activate" type="object" string="Activate reviewed membership only" invisible="state != 'draft'"/></header></xpath><xpath expr="//field[@name='state']" position="attributes"><attribute name="readonly">1</attribute></xpath><xpath expr="//sheet/group" position="inside"><field name="finance_event_id"/><field name="previous_id"/></xpath></field></record>
  <record id="request_lifecycle_form" model="ir.ui.view"><field name="name">request.lifecycle.form</field><field name="model">federation.person.request</field><field name="inherit_id" ref="person_request_form"/><field name="arch" type="xml"><xpath expr="//sheet/group" position="inside"><field name="membership_id"/><field name="required_for_activation"/><field name="purpose_kind"/><field name="parental_approval_id"/><field name="renewed_from_id"/><field name="evidence_revision_ids" readonly="1"/></xpath></field></record>
  <record id="identity_player_form" model="ir.ui.view"><field name="name">player.identity.review</field><field name="model">federation.player</field><field name="inherit_id" ref="sports_federation_people.view_federation_player_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_review_identity" type="object" string="Review identity / resolve duplicate" groups="sports_federation_base.group_federation_manager"/></xpath><xpath expr="//sheet" position="inside"><group groups="sports_federation_base.group_federation_manager"><field name="person_id" readonly="1"/><field name="family_duplicate_of_id" readonly="1"/></group></xpath></field></record>
  <record id="family_reference_partner_form" model="ir.ui.view"><field name="name">partner.family.reference</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Reviewed family identity" groups="sports_federation_base.group_federation_manager"><field name="family_reference" readonly="1"/><field name="family_canonical_id" readonly="1"/><button name="action_issue_family_reference" type="object" string="Issue / rotate private family reference"/></group></xpath></field></record>
  <record id="identity_review_form" model="ir.ui.view"><field name="name">identity.review.form</field><field name="model">federation.identity.review</field><field name="arch" type="xml"><form><sheet><p>No email-based matching, automatic account merge or permission union. Review existing records and identity evidence before confirming.</p><group><field name="player_id"/><field name="person_id" options="{'no_create': True}"/><field name="duplicate_player_id"/><field name="reason"/><field name="preview" readonly="1"/><field name="preview_signature" readonly="1"/><field name="inspected"/></group></sheet><footer><button name="action_preview" type="object" string="Preview identity effects"/><button name="action_confirm" type="object" string="Confirm reviewed identity decision" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="member_change_form" model="ir.ui.view"><field name="name">federation.member.change.form</field><field name="model">federation.member.change</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_approve" type="object" string="Approve membership action" invisible="state != 'pending'"/><button name="action_reject" type="object" string="Reject with reason" invisible="state != 'pending'"/></header><sheet><group><field name="membership_id" readonly="1"/><field name="person_id" readonly="1"/><field name="company_id" readonly="1"/><field name="kind" readonly="1"/><field name="target_club_id" readonly="1"/><field name="reason" readonly="1"/><field name="requested_by_id" readonly="1"/><field name="source_signature" readonly="1"/><field name="state" readonly="1"/><field name="decision_note"/><field name="decided_by_id" readonly="1"/><field name="result_membership_id" readonly="1"/></group></sheet><chatter/></form></field></record><record id="member_change_action" model="ir.actions.act_window"><field name="name">Member Change</field><field name="res_model">federation.member.change</field><field name="view_mode">list,form</field></record><menuitem id="member_change_menu" name="Member Change" action="member_change_action" groups="sports_federation_base.group_federation_manager"/><record id="guardian_claim_form" model="ir.ui.view"><field name="name">federation.guardian.claim.form</field><field name="model">federation.guardian.claim</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_verify" type="object" string="Verify independent guardian evidence" invisible="state != 'pending'"/><button name="action_reject" type="object" string="Reject with reason" invisible="state != 'pending'"/></header><sheet><group><field name="person_id" readonly="1"/><field name="delegate_id" readonly="1"/><field name="company_id" readonly="1"/><field name="submitted_by_id" readonly="1"/><field name="document" readonly="1" filename="filename"/><field name="filename" readonly="1"/><field name="checksum" readonly="1"/><field name="reason" readonly="1"/><field name="valid_until"/><field name="state" readonly="1"/><field name="decision_note"/><field name="inspected"/><field name="relationship_id" readonly="1"/></group></sheet><chatter/></form></field></record><record id="guardian_claim_action" model="ir.actions.act_window"><field name="name">Guardian Claim</field><field name="res_model">federation.guardian.claim</field><field name="view_mode">list,form</field></record><menuitem id="guardian_claim_menu" name="Guardian Claim" action="guardian_claim_action" groups="sports_federation_base.group_federation_manager"/><record id="identity_decision_form" model="ir.ui.view"><field name="name">federation.identity.decision.form</field><field name="model">federation.identity.decision</field><field name="arch" type="xml"><form create="0" delete="0"><header/><sheet><group><field name="company_id" readonly="1"/><field name="player_id" readonly="1"/><field name="duplicate_player_id" readonly="1"/><field name="person_id" readonly="1"/><field name="actor_id" readonly="1"/><field name="reason" readonly="1"/><field name="before" readonly="1"/><field name="decided_on" readonly="1"/></group></sheet></form></field></record><record id="identity_decision_action" model="ir.actions.act_window"><field name="name">Identity Decision</field><field name="res_model">federation.identity.decision</field><field name="view_mode">list,form</field></record><menuitem id="identity_decision_menu" name="Identity Decision" action="identity_decision_action" groups="sports_federation_base.group_federation_manager"/></odoo>
