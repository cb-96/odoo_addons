<odoo>
  <record id="club_season_registration_list" model="ir.ui.view">
    <field name="name">club.season.registration.list</field>
    <field name="model">federation.club.season.registration</field>
    <field name="arch" type="xml"><list>
      <field name="club_id"/><field name="season_id"/>
      <field name="registered_player_count"/><field name="pending_player_count"/>
      <field name="state" widget="badge"/>
    </list></field>
  </record>
  <record id="club_season_registration_form" model="ir.ui.view">
    <field name="name">club.season.registration.form</field>
    <field name="model">federation.club.season.registration</field>
    <field name="arch" type="xml"><form>
      <header>
        <button name="action_collect_club_players" type="object" string="Collect club players" invisible="state == 'cancelled'"/>
        <button name="action_submit" type="object" string="Submit pending players" invisible="state in ('submitted', 'cancelled')"/>
        <button name="action_confirm" type="object" string="Approve pending players" class="btn-primary" invisible="state == 'cancelled'"/>
        <button name="action_cancel" type="object" string="Cancel registration" confirm="Cancel all pending and active player registrations? Existing charges are retained for financial review." invisible="state == 'cancelled'"/>
        <field name="state" widget="statusbar"/>
      </header>
      <sheet>
        <group><field name="club_id" readonly="player_count != 0"/><field name="season_id" readonly="player_count != 0"/>
          <!-- Technical context relay: new licences inherit the season validity dates. -->

          <!-- Technical context relay: new licences inherit season validity dates. -->
          <field name="season_date_start" invisible="True"/><field name="season_date_end" invisible="True"/><field name="company_id" groups="base.group_multi_company"/><field name="player_count"/><field name="registered_player_count"/><field name="pending_player_count"/></group>
        <p>Collect or add players, then approve them. Approved season licences allow team roster registration. Charges are created once per player, not per team.</p>
        <field name="license_ids" context="{'default_club_id': club_id, 'default_season_id': season_id, 'default_issue_date': season_date_start, 'default_expiry_date': season_date_end}" readonly="state == 'cancelled'">
          <list editable="bottom"><field name="player_id" domain="[('club_id', '=', parent.club_id), ('active', '=', True)]"/>
            <field name="name"/><field name="club_id" column_invisible="True"/><field name="season_id" column_invisible="True"/>
            <field name="category"/><field name="issue_date"/><field name="expiry_date"/><field name="state" readonly="True"/>
          </list>
        </field><field name="notes"/>
      </sheet><chatter/>
    </form></field>
  </record>
  <record id="club_season_registration_action" model="ir.actions.act_window">
    <field name="name">Club Season Players</field><field name="res_model">federation.club.season.registration</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_club_season_registration" name="Season Player Registrations"
    parent="sports_federation_base.menu_federation_setup" action="club_season_registration_action" sequence="30"/>
  <record id="player_license_club_registration" model="ir.ui.view">
    <field name="name">player.license.club.registration</field><field name="model">federation.player.license</field>
    <field name="inherit_id" ref="view_federation_player_license_form"/>
    <field name="arch" type="xml"><xpath expr="//field[@name='season_id']" position="after"><field name="club_registration_id"/></xpath></field>
  </record>
</odoo>
