FROM odoo:19

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        wget \
    && wget -q -O /tmp/google-chrome-stable_current_amd64.deb \
        https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        /tmp/google-chrome-stable_current_amd64.deb \
    && rm -f /tmp/google-chrome-stable_current_amd64.deb \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/google-chrome-stable /usr/local/bin/chromium-browser \
    && google-chrome-stable --version

COPY requirements-odoo-ci.txt /tmp/sports-federation-odoo-ci-requirements.txt
RUN python3 -m pip install \
    --break-system-packages \
    --no-cache-dir \
    -r /tmp/sports-federation-odoo-ci-requirements.txt \
    && python3 -c "import websocket; assert websocket.__version__ == '1.8.0'" \
    && chromium-browser --version