<odoo>
 <record id="view_competition_format_template_list" model="ir.ui.view"><field name="name">federation.competition.format.template.list</field><field name="model">federation.competition.format.template</field><field name="arch" type="xml"><list><field name="code"/><field name="name"/><field name="version"/><field name="format_type"/><field name="pool_count"/><field name="series_length"/><field name="active"/></list></field></record>
 <record id="view_competition_format_template_form" model="ir.ui.view"><field name="name">federation.competition.format.template.form</field><field name="model">federation.competition.format.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="version"/><field name="active"/><field name="format_type"/><field name="pool_count" invisible="format_type not in ('pool_knockout', 'split_pools')"/><field name="series_length" invisible="format_type not in ('knockout', 'placement_bracket')"/><field name="swiss_round_count" invisible="format_type != 'swiss'"/><field name="configuration" widget="json"/><field name="notes"/></group></sheet></form></field></record>
 <record id="action_competition_format_template" model="ir.actions.act_window"><field name="name">Format Templates</field><field name="res_model">federation.competition.format.template</field><field name="view_mode">list,form</field></record>
</odoo>
