<odoo>
 <record id="structure_list" model="ir.ui.view"><field name="name">federation.competition.structure.list</field><field name="model">federation.competition.structure</field><field name="arch" type="xml"><list decoration-success="state == 'frozen'"><field name="name"/><field name="edition_id"/><field name="division_id"/><field name="participant_set_id"/><field name="format_type"/><field name="version"/><field name="state" widget="badge"/></list></field></record>
 <record id="structure_form" model="ir.ui.view"><field name="name">federation.competition.structure.form</field><field name="model">federation.competition.structure</field><field name="arch" type="xml"><form><header><button name="action_generate" type="object" string="Generate Fixtures" class="btn-primary" invisible="state == 'frozen'"/><button name="action_freeze" type="object" string="Freeze Structure" class="btn-primary" invisible="state != 'generated'"/><field name="state" widget="statusbar" statusbar_visible="draft,generated,frozen"/></header><sheet><group><field name="name"/><field name="edition_id"/><field name="division_id" domain="[('edition_id','=',edition_id)]"/><field name="participant_set_id" domain="[('division_id','=',division_id),('state','=','finalized')]"/><field name="format_type"/><field name="version"/></group><notebook><page string="Stages"><field name="stage_ids"><list editable="bottom"><field name="sequence"/><field name="name"/><field name="stage_type"/></list></field></page><page string="Fixtures"><field name="fixture_ids"><list><field name="stage_id"/><field name="round_number"/><field name="sequence"/><field name="home_team_id"/><field name="away_team_id"/><field name="state"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_format_studio" model="ir.actions.act_window"><field name="name">Format Studio</field><field name="res_model">federation.competition.structure</field><field name="view_mode">list,form</field></record>
</odoo>
