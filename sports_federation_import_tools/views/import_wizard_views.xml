<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Import Clubs Wizard Form -->
    <record id="view_federation_import_clubs_wizard_form" model="ir.ui.view">
        <field name="name">federation.import.clubs.wizard.form</field>
        <field name="model">federation.import.clubs.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Clubs">
                <group>
                    <group>
                        <field name="template_id"/>
                        <field name="contract_version" readonly="1"/>
                        <field name="upload_file" filename="upload_filename"/>
                        <!-- Technical field retained for view modifiers and domains. -->
                        <field name="upload_filename" invisible="1"/>
                        <field name="dry_run"/>
                    </group>
                    <group>
                        <field name="governance_job_id" readonly="1"/>
                        <field name="integration_delivery_id" readonly="1"/>
                        <field name="approval_state" readonly="1"/>
                        <field name="mapping_guide" nolabel="1" readonly="1" widget="text"/>
                    </group>
                </group>
                <group invisible="not line_count">
                    <group>
                        <field name="line_count"/>
                        <field name="success_count"/>
                        <field name="error_count"/>
                    </group>
                </group>
                <group invisible="not result_message">
                    <field name="result_message" nolabel="1" widget="text"/>
                </group>
                <group invisible="not governance_job_id">
                    <field name="verification_summary" nolabel="1" widget="text" readonly="1"/>
                </group>
                <footer>
                    <button name="action_parse_and_import" string="Run Preview / Import" type="object" class="btn-primary"/>
                    <button name="action_request_approval" string="Request Approval" type="object" class="btn-secondary"/>
                    <button name="action_approve_import" string="Approve Import" type="object" class="btn-secondary"
                            invisible="approval_state != 'awaiting_approval'"
                            groups="sports_federation_base.group_federation_manager"/>
                    <button name="action_view_governance_job" string="View Governance Job" type="object" class="btn-secondary"
                            invisible="not governance_job_id"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

