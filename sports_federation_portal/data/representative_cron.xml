<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <!--
    Tenures and delegations end by date. Portal scopes of users are stored
    (record rules read them), so this job refreshes the ones that changed only
    because time passed. Cheap: it looks at representatives with dates only.
  -->
  <record id="cron_refresh_representative_time_state" model="ir.cron">
    <field name="name">Federation: refresh representative tenures and delegations</field>
    <field name="model_id" ref="model_federation_club_representative"/>
    <field name="state">code</field>
    <field name="code">model._cron_refresh_time_based_state()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="active">True</field>
  </record>
</odoo>
