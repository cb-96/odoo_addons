<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <template id="club_preparation_journey" name="Club Preparation">
    <t t-call="portal.portal_layout"><main class="container py-4 sf-preparation" data-journey-user="1">
      <a href="/my" class="btn btn-outline-secondary mb-3" data-journey-return="1">Back to overview</a>
      <h1>Prepare your team</h1>
      <p class="text-muted">Complete the next requirement. Submission and approval remain separate.</p>
      <div t-if="not rows" class="sf-empty"><p>No confirmed registration in this view.</p><a t-att-href="preparation_url('/my/competitions')" class="btn btn-primary" data-journey-open="1">Register a team</a></div>
      <section t-foreach="rows" t-as="row" class="card sf-task-card mb-3">
        <div class="card-body">
          <h2 class="h5"><t t-esc="row['registration'].team_id.display_name"/></h2>
          <p class="small text-muted"><t t-esc="row['registration'].team_id.club_id.display_name"/> · <t t-esc="row['registration'].season_id.display_name"/></p>
          <section data-journey-participation="1">
            <p><strong t-esc="request.env['federation.readiness.vocabulary'].label_for('journey', row['participation_status'])"/></p>
            <t t-set="check" t-value="row['next_check']"/>
            <div t-if="check"><h3 class="h6" t-esc="check['label']"/><p class="sf-task-blocker" t-esc="check['detail']"/><a t-att-href="check['url']" data-journey-open="1" class="btn btn-primary">Continue <t t-esc="check['label']"/></a></div>
            <p t-elif="row['participation_status'] == 'waiting'" class="text-muted">Your submission is waiting for review. No resubmission is needed.</p>
            <p t-else="" class="text-muted">No action on the current checks. Match-day approval remains separate.</p>
            <details class="sf-disclosure"><summary>Requirements and status</summary>
              <t t-foreach="row['participation_checks']" t-as="requirement">
                <details class="sf-disclosure" t-att-open="requirement == row['next_check']">
                  <summary><t t-esc="requirement['label']"/>: <t t-esc="request.env['federation.readiness.vocabulary'].label_for('journey', requirement['state'])"/></summary>
                  <p class="sf-task-blocker" t-esc="requirement['detail']"/><a t-att-href="requirement['url']" data-journey-open="1">Review requirement</a>
                </details>
              </t>
              <p class="small text-muted">Checks apply to this roster and its upcoming line-ups. They do not replace match-day approval.</p>
            </details>
          </section>
          <a t-if="len(rows) &gt; 1" t-att-href="row['context_url']" class="small" data-journey-open="1">Focus on this team</a>
        </div>
      </section>
      <details t-if="sheets" class="sf-disclosure"><summary>Game days</summary><a t-foreach="sheets" t-as="sheet" t-attf-href="/my/match-sheets/#{sheet.id}" class="list-group-item list-group-item-action" data-journey-open="1"><t t-esc="sheet.team_id.display_name"/> · <t t-esc="sheet.match_id.display_name"/> · <t t-esc="sheet.get_portal_state_label()"/></a></details>
    </main></t>
  </template>
  <template id="competition_preparation_link" inherit_id="sports_federation_portal.portal_my_competitions"><xpath expr="//div[contains(@class, 'container')]" position="inside"><a href="/my/preparation" class="btn btn-outline-secondary my-3" data-journey-open="1">Prepare your team</a></xpath></template>
  <template id="roster_preparation_link" inherit_id="sports_federation_portal.portal_my_roster_detail"><xpath expr="//t[@t-call='portal.portal_layout']" position="inside"><a href="/my/preparation" class="btn btn-outline-secondary m-3" data-journey-return="1">Back to team preparation</a></xpath></template>
</odoo>