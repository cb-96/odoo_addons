<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_federation_operation_task_tree" model="ir.ui.view">
        <field name="name">federation.operation.task.tree</field>
        <field name="model">federation.operation.task</field>
        <field name="arch" type="xml">
            <list string="Operational Action Queue" default_order="blocking desc,priority desc,deadline asc">
                <field name="name"/>
                <field name="task_type"/>
                <field name="responsible_club_id"/>
                <field name="tournament_id"/>
                <field name="audience"/>
                <field name="priority" widget="priority"/>
                <field name="blocking"/>
                <field name="deadline"/>
                <field name="state"/>
                <field name="escalation_level"/>
            </list>
        </field>
    </record>

    <record id="view_federation_operation_task_form" model="ir.ui.view">
        <field name="name">federation.operation.task.form</field>
        <field name="model">federation.operation.task</field>
        <field name="arch" type="xml">
            <form string="Operational Task"><header><button name="action_open_source" type="object" string="Open Source" class="btn-primary"/><button name="action_retry_source" type="object" string="Retry / Return to Draft" invisible="state == 'done'"/></header>
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-secondary" invisible="state != 'open' or blocking"/>
                    <button name="action_escalate" type="object" string="Escalate" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,acknowledged,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="task_type"/>
                            <field name="audience"/>
                            <field name="priority" widget="priority"/>
                            <field name="blocking"/>
                            <field name="deadline"/>
                        </group>
                        <group>
                            <field name="responsible_club_id"/>
                            <field name="assigned_user_id"/>
                            <field name="season_id"/>
                            <field name="tournament_id"/>
                            <field name="match_id"/>
                            <field name="action_url" widget="url"/>
                        </group>
                    </group>
                    <group>
                        <field name="blocking_reason"/>
                        <field name="next_step"/>
                    </group>
                    <group string="Source">
                        <field name="source_model"/>
                        <field name="source_record_id"/>
                        <field name="source_key"/>
                        <field name="completed_on"/>
                        <field name="escalation_level"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_federation_operation_task_search" model="ir.ui.view">
        <field name="name">federation.operation.task.search</field>
        <field name="model">federation.operation.task</field>
        <field name="arch" type="xml">
            <search string="Operational Tasks">
                <field name="name"/>
                <field name="task_type"/>
                <field name="responsible_club_id"/>
                <field name="tournament_id"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('open', 'acknowledged'))]"/>
                <filter name="blocking" string="Blocking" domain="[('blocking', '=', True)]"/>
                <filter name="overdue" string="Overdue" domain="[('deadline', '&lt;', context_today())]"/>
                <group>
                    <filter name="group_type" string="Task type" context="{'group_by': 'task_type'}"/>
                    <filter name="group_club" string="Club" context="{'group_by': 'responsible_club_id'}"/>
                    <filter name="group_tournament" string="Tournament" context="{'group_by': 'tournament_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_federation_operation_task" model="ir.actions.act_window">
        <field name="name">Operational Action Queue</field>
        <field name="res_model">federation.operation.task</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_federation_operation_task_search"/>
        <field name="domain">[('audience', '=', 'manager'), ('state', '!=', 'done')]</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>