<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="portal_my_players_parental_approval_action" inherit_id="sports_federation_portal.portal_my_players" name="Player Parental Approval Action">
    <xpath expr="//table/thead/tr/th[last()]" position="after">
      <th scope="col" class="text-end">Parental approval</th>
    </xpath>
    <xpath expr="//table/tbody/t/tr/td[last()]" position="after">
      <td class="text-end">
        <div t-if="pa.get('show_badge')" class="d-flex flex-column align-items-end gap-1 mb-1" data-parental-status="1">
          <span t-attf-class="badge #{pa['badge']}"><i t-attf-class="fa #{pa['icon']} me-1" aria-hidden="true"/><t t-esc="pa['label']"/></span>
          <span t-if="pa.get('detail')" class="small text-muted" t-esc="pa['detail']"/>
        </div>
        <span t-elif="pa.get('key') == 'not_required'" class="small text-muted d-block mb-1">Not required</span>
        <a t-attf-href="/my/players/#{player.id}/parental-approvals" t-attf-class="btn btn-sm #{pa.get('cta_class') or 'btn-outline-secondary'}"><t t-esc="pa.get('cta') or 'Manage document'"/></a>
      </td>
    </xpath>
    <!-- Which players would need parental approval: summary above the filters. -->
    <xpath expr="//form[@action='/my/players']" position="before">
      <t t-set="parental_overview" t-value="request.env['federation.player.parental.approval']._portal_player_overview(players)"/>
      <t t-set="parental_counts" t-value="parental_overview['counts']"/>
      <t t-set="parental_needed_only" t-value="request.httprequest.args.get('approval') == 'needed'"/>
      <t t-set="parental_rows" t-value="players.filtered(lambda p: parental_overview['by_player'].get(p.id, {}).get('needs_action')) if parental_needed_only else players"/>
      <section t-if="parental_counts['under_age'] or parental_counts['no_birth_date']" class="card border-0 shadow-sm mb-4" data-parental-overview="1" aria-labelledby="parental-overview-title">
        <div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
              <h3 id="parental-overview-title" class="h5 mb-1"><i class="fa fa-shield me-2" aria-hidden="true"/>Parental approval</h3>
              <p class="text-muted small mb-0">Players under 16 need a verified parental approval to play in a senior (adult) league. The federation checks it against the match date.</p>
            </div>
            <div t-if="parental_counts['needs_action']">
              <a t-if="not parental_needed_only" t-attf-href="/my/players?approval=needed&amp;gender=#{filter_gender or ''}&amp;state=#{filter_state or ''}" class="btn btn-sm btn-outline-danger">Show only players who need action (<t t-esc="parental_counts['needs_action']"/>)</a>
              <a t-else="" t-attf-href="/my/players?gender=#{filter_gender or ''}&amp;state=#{filter_state or ''}" class="btn btn-sm btn-outline-secondary">Show all players</a>
            </div>
          </div>
          <div t-if="parental_overview['bar']" class="progress mt-3" style="height: 1.25rem;" role="img" t-att-aria-label="parental_overview['summary']">
            <div t-foreach="parental_overview['bar']" t-as="segment" t-attf-class="progress-bar #{segment['css']}" t-attf-style="width: #{segment['pct']}%;" t-att-title="segment['label']"><t t-esc="segment['count']"/></div>
          </div>
          <div class="row g-2 mt-1">
            <div t-foreach="parental_overview['tiles']" t-as="tile" class="col-6 col-lg">
              <div t-attf-class="border rounded p-2 h-100 #{tile['css']}">
                <div class="fw-semibold"><i t-attf-class="fa #{tile['icon']} me-1" aria-hidden="true"/><t t-esc="tile['count']"/> <t t-esc="tile['label']"/></div>
                <div class="small text-muted" t-esc="tile['hint']"/>
              </div>
            </div>
          </div>
          <p t-if="parental_needed_only and not parental_counts['needs_action']" class="mb-0 mt-2 small text-success">No players need action.</p>
        </div>
      </section>
    </xpath>
    <xpath expr="//table/tbody/t" position="attributes">
      <attribute name="t-foreach">parental_rows</attribute>
    </xpath>
    <xpath expr="//table/tbody/t/tr" position="attributes">
      <attribute name="t-att-class">(parental_overview['by_player'].get(player.id) or {}).get('row_class') or None</attribute>
    </xpath>
    <xpath expr="//table/tbody/t/tr/td[1]" position="before">
      <t t-set="pa" t-value="parental_overview['by_player'].get(player.id) or {}"/>
    </xpath>
    <xpath expr="//table/tbody/t/tr/td[1]" position="inside">
      <span t-if="pa.get('under_age')" class="badge text-bg-light border ms-2"><t t-esc="pa['age_label']"/></span>
      <div t-if="pa.get('age_note')" class="small text-muted fw-normal" t-esc="pa['age_note']"/>
    </xpath>
  </template>

  <template id="portal_player_parental_approvals" name="Player Parental Approvals">
    <t t-call="portal.portal_layout">
      <div class="container py-4">
        <a href="/my/players" class="btn btn-link px-0 mb-3"><i class="fa fa-arrow-left me-2"/>Back to players</a>
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
          <div><h1 class="h3 mb-1">Parental approval</h1><p class="text-muted mb-0"><t t-esc="player.display_name"/></p></div>
          <span class="badge bg-secondary">Federation verification required</span>
        </div>
        <div t-if="success" class="alert alert-success" role="status"><t t-esc="success"/></div>
        <div t-if="error" class="alert alert-danger" role="alert"><t t-esc="error"/></div>
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="card"><div class="card-body">
              <h2 class="h5">Upload signed approval</h2>
              <p class="text-muted">PDF, PNG or JPG, maximum 10 MiB. The federation verifies the document before it becomes valid.</p>
              <form t-attf-action="/my/players/#{player.id}/parental-approvals/upload" method="post" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="mb-3"><label class="form-label" for="guardian_name">Parent or guardian name</label><input class="form-control" id="guardian_name" name="guardian_name" required="required"/></div>
                <div class="mb-3"><label class="form-label" for="guardian_email">Guardian email</label><input class="form-control" id="guardian_email" name="guardian_email" type="email"/></div>
                <div class="row g-3 mb-3"><div class="col-md-6"><label class="form-label" for="approval_date">Approval date</label><input class="form-control" id="approval_date" name="approval_date" type="date" required="required"/></div><div class="col-md-6"><label class="form-label" for="valid_until">Valid until</label><input class="form-control" id="valid_until" name="valid_until" type="date"/></div></div>
                <div class="mb-3"><label class="form-label" for="approval_document">Signed document</label><input class="form-control" id="approval_document" name="approval_document" type="file" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" required="required"/></div>
                <div class="mb-3"><label class="form-label" for="notes">Notes</label><textarea class="form-control" id="notes" name="notes" rows="3"/></div>
                <button class="btn btn-primary" type="submit">Upload for review</button>
              </form>
            </div></div>
          </div>
          <div class="col-lg-5"><div class="card"><div class="card-body"><h2 class="h5">Submission history</h2>
            <div t-if="not approvals" class="text-muted">No approval documents uploaded yet.</div>
            <div t-foreach="approvals" t-as="approval" class="border-bottom py-3">
              <div class="d-flex justify-content-between gap-2"><strong><t t-esc="approval.approval_document_filename"/></strong><span t-attf-class="badge #{'bg-success' if approval.state == 'verified' else ('bg-danger' if approval.state in ('revoked', 'replacement_requested') else 'bg-warning text-dark')}"><t t-esc="dict(approval._fields['state'].selection).get(approval.state)"/></span></div>
              <div class="small text-muted mt-1">Approval date <t t-esc="approval.approval_date"/><t t-if="approval.valid_until"> · valid until <t t-esc="approval.valid_until"/></t></div>
              <div t-if="approval.submitted_on" class="small text-muted">Submitted <t t-esc="approval.submitted_on" t-options="{'widget': 'datetime'}"/> by <t t-esc="approval.submitted_by_id.name"/></div>
              <p t-if="approval.state == 'draft' and approval.submitted_on" class="small text-muted">Document uploaded. Verification pending.</p>
              <div t-if="approval.review_note" class="alert alert-warning py-2 mt-2 mb-1" role="status"><strong>Federation feedback:</strong> <t t-esc="approval.review_note"/></div>
              <a t-if="approval.approval_document" class="btn btn-sm btn-outline-secondary mt-2" t-attf-href="/my/players/#{player.id}/parental-approvals/#{approval.id}/download">Download submitted document</a>
            </div>
          </div></div></div>
        </div>
      </div>
    </t>
  </template>
</odoo>
