<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <record id="action_connected_federation_work" model="ir.actions.act_url"><field name="name">Back to my work</field><field name="url">/my/work</field><field name="target">self</field></record>
  <record id="view_connected_task_return" model="ir.ui.view"><field name="name">federation.operation.task.connected.return</field><field name="model">federation.operation.task</field><field name="inherit_id" ref="sports_federation_portal.view_federation_operation_task_form"/><field name="arch" type="xml"><xpath expr="(//form/header)[1]" position="inside"><button name="%(action_connected_federation_work)d" type="action" string="Back to my work" groups="sports_federation_base.group_federation_manager"/></xpath></field></record>
  <record id="view_connected_review_return" model="ir.ui.view"><field name="name">federation.match.connected.return</field><field name="model">federation.match</field><field name="inherit_id" ref="sports_federation_tournament.view_federation_match_form"/><field name="arch" type="xml"><xpath expr="(//form/header)[1]" position="inside"><button name="%(action_connected_federation_work)d" type="action" string="Back to my work" groups="sports_federation_result_control.group_result_validator,sports_federation_result_control.group_result_approver"/></xpath></field></record>

  <template id="connected_work_card" name="Work card"><article class="card sf-task-card mb-3" t-att-data-journey-card="card['key']"><div class="card-body"><h3 class="h5" t-esc="card['title']"/><p class="small text-muted"><t t-esc="card['owner']"/><span t-if="card['deadline']"> · Due <t t-esc="request.env['federation.event.time'].display(card['deadline'], card.get('event_record'))"/></span></p><p t-if="card['blocker']" class="sf-task-blocker" t-esc="card['blocker']"/><a t-att-href="card['url']" data-journey-open="1" t-att-class="'btn btn-primary' if bucket[0] == 'now' else 'btn btn-outline-secondary'"><t t-esc="card['next_action']"/></a><details class="sf-disclosure"><summary>Details</summary><p class="small text-muted" data-journey-handoff="1" t-esc="card['handoff']"/><t t-set="task" t-value="card.get('task')"/><t t-set="representatives" t-value="card.get('representatives')"/><form t-if="task and task.state != 'done' and representatives" action="/my/action-items/assign" method="POST" class="d-flex gap-2 flex-wrap mt-3"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="task_id" t-att-value="task.id"/><label t-attf-for="assignee_#{task.id}" class="visually-hidden">Assign action</label><select t-attf-id="assignee_#{task.id}" name="user_id" class="form-select form-select-sm w-auto"><t t-foreach="representatives" t-as="rep"><option t-att-value="rep.effective_user_id.id" t-att-selected="task.assigned_user_id == rep.effective_user_id"><t t-esc="rep.effective_user_id.name"/> · <t t-esc="rep.operational_role or rep.role_type_id.name"/></option></t></select><button class="btn btn-sm btn-outline-secondary">Assign</button></form>
        </details></div></article></template><template id="connected_work_groups" name="Connected work groups"><div class="sf-connected-work" t-att-data-journey-user="request.env.user.id"><t t-set="todo" t-value="request.env['federation.operation.task']._journey_actionable_cards(journey_groups)"/><section t-if="todo" data-journey-bucket="now" aria-labelledby="journey-now"><h2 id="journey-now" class="h4">To do <span class="badge text-bg-light" t-esc="len(todo)"/></h2><t t-set="bucket" t-value="('now','To do')"/><t t-foreach="todo" t-as="card"><t t-call="sports_federation_portal.connected_work_card"/></t></section><p t-else="" class="sf-empty text-muted">Nothing needs your attention in this view.</p><t t-foreach="[('waiting','Waiting'),('recent','Completed')]" t-as="bucket"><details t-if="journey_groups[bucket[0]]" class="sf-disclosure" t-att-data-journey-bucket="bucket[0]"><summary><t t-esc="bucket[1]"/> <span class="badge text-bg-light" t-esc="len(journey_groups[bucket[0]])"/></summary><p t-if="bucket[0] == 'recent'" class="small text-muted">Task completion does not replace eligibility or approval checks.</p><t t-foreach="journey_groups[bucket[0]]" t-as="card"><t t-call="sports_federation_portal.connected_work_card"/></t></details></t></div></template><template id="role_home" name="My work"><t t-call="portal.portal_layout"><main class="container py-4"><h1>My work</h1><p class="text-muted" t-esc="journey_role_label"/><form t-if="len(journey_roles) &gt; 1 or len(journey_clubs) &gt; 1" action="/my/work" method="get" class="sf-context"><div t-if="len(journey_roles) &gt; 1"><label for="journey-role">Responsibility</label><select id="journey-role" name="role" class="form-select"><option t-foreach="journey_roles" t-as="item" t-att-value="item['key']" t-att-selected="item['key'] == journey_role"><t t-esc="item['label']"/></option></select></div><input t-else="" type="hidden" name="role" t-att-value="journey_role"/><div t-if="len(journey_clubs) &gt; 1"><label for="journey-club">Club</label><select id="journey-club" name="club" class="form-select"><option value="">All my clubs</option><option t-foreach="journey_clubs" t-as="club" t-att-value="club.id" t-att-selected="club.id == journey_club"><t t-esc="club.display_name"/></option></select></div><button class="btn btn-outline-secondary">Apply</button></form><t t-call="sports_federation_portal.connected_work_groups"/><p t-if="journey_role_url and not journey_groups['now'] and not journey_groups['soon']"><a t-att-href="journey_role_url" data-journey-open="1" class="btn btn-outline-primary"><t t-esc="{'club':'Prepare a team','planner':'Manage competitions','official':'View assignments','reviewer':'Review results','manager':'Manage work'}.get(journey_role, 'Open workspace')"/></a></p><details class="sf-disclosure"><summary>More</summary><a t-if="journey_role_url" t-att-href="journey_role_url" data-journey-open="1" class="btn btn-outline-secondary">Open workspace</a><a href="/my?generic=1" class="btn btn-outline-secondary">Other services</a><p class="small text-muted mt-2">Showing at most <t t-esc="journey_limit"/> source records. Use the workspace for older work.</p></details></main></t></template><template id="missing_roster" name="Create Missing Roster">
    <t t-call="portal.portal_layout"><main class="container py-4" t-att-data-journey-user="journey_user_id"><h1>Create the team roster</h1><p><strong><t t-esc="registration.team_id.display_name"/></strong> has a confirmed registration for <t t-esc="registration.season_id.display_name"/> but no roster.</p><p>Create the roster, add eligible players and activate it before preparing a lineup.</p>
      <form t-attf-action="/my/rosters/create/#{registration.id}" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="btn btn-primary">Create roster</button></form>
      <a href="/my/action-items?scope=club" class="btn btn-outline-secondary mt-3">Back to preparation inbox</a>
    </main></t>
  </template>
  <template id="inbox_journey" inherit_id="sports_federation_portal.portal_my_operation_tasks">
    <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' container ')]" position="attributes"><attribute name="t-att-data-journey-user">request.env.user.id</attribute></xpath>
    <xpath expr="//nav[hasclass('d-flex') and hasclass('gap-2') and hasclass('mb-4')]" position="after"><section t-if="journey_waiting_entries" class="card mb-4"><div class="card-body"><h3 class="h5">Competition entries waiting for federation review</h3><p>These submissions are not unfinished club actions. Open an entry to view its current status.</p><div class="list-group"><a t-foreach="journey_waiting_entries" t-as="entry" t-attf-href="/my/competition-entries/#{entry.id}" data-journey-open="1" class="list-group-item list-group-item-action"><strong><t t-esc="entry.team_id.display_name"/></strong> · <t t-esc="entry.edition_id.display_name"/></a></div><p class="small text-muted mt-2">Showing at most 100 recent submissions.</p></div></section></xpath>
    <xpath expr="//nav[hasclass('d-flex') and hasclass('gap-2') and hasclass('mb-4')]" position="before"><a href="/my/work" class="btn btn-outline-secondary mb-3">My work</a></xpath>
  </template>
  <template id="manager_queue" name="Manager Work Queue">
    <t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/work" class="btn btn-outline-secondary mb-3">My work</a><h1>Manager work queue</h1><p>Open the linked task and its source through the backend. Current source permissions and independent review checks apply.</p>
      <div class="d-flex gap-3 mb-3"><span>All manager work: <t t-esc="summary['total']"/> open items</span><span><t t-esc="summary['blocking']"/> blocking</span><span><t t-esc="summary['overdue']"/> overdue</span></div>
      <form method="get" action="/federation/operations/action-items" class="d-flex gap-2 flex-wrap mb-3"><select name="status" class="form-select w-auto" aria-label="Task status"><option value="open" t-att-selected="active_filters.get('status') != 'recent'">Open work</option><option value="recent" t-att-selected="active_filters.get('status') == 'recent'">Completed work</option></select><select name="task_type" class="form-select w-auto" aria-label="Task type"><option value="">All task types</option><option t-foreach="task_type_labels.items()" t-as="kind" t-att-value="kind[0]" t-att-selected="kind[0] == active_task_type"><t t-esc="kind[1]"/></option></select><button class="btn btn-outline-primary">Filter</button></form>
      <p><t t-esc="len(tasks)"/> matching tasks in this view.</p><t t-call="sports_federation_portal.connected_work_groups"/><p t-if="not tasks" class="alert alert-info">No matching tasks. This does not certify that all competition checks passed.</p>
    </main></t>
  </template>
  <template id="review_work" name="Result Review Work"><t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/work" class="btn btn-outline-secondary mb-3">My work</a><h1>Result review</h1><p>Review the results assigned to your role. Independent approval checks still apply.</p><t t-call="sports_federation_portal.connected_work_groups"/><p t-if="not matches" class="alert alert-info">No pending results are visible to your current role.</p><p class="text-muted">Showing at most 100 recent pending records. Use the backend filters for older work.</p></main></t></template>
  <template id="portal_journey_entry" inherit_id="portal.portal_my_home">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="before"><a href="/my/work" class="btn btn-primary my-3">My work</a></xpath>
  </template>
</odoo>