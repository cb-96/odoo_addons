<odoo>
  <template id="role_home" name="My Federation Work">
    <t t-call="portal.portal_layout"><main class="container py-4" t-att-data-journey-user="journey_user_id">
      <h1>My federation work</h1><p>Choose the responsibility you are working on. Switching workspace does not change your permissions.</p>
      <div class="row g-3">
        <section t-if="club_access" class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h4">Club and team preparation</h2><p>Registration, roster, lineup and consent work for your current clubs and teams.</p><a href="/my/action-items?scope=club" class="btn btn-primary">Open preparation inbox</a><a href="/my/competitions" class="btn btn-outline-primary ms-2">Competitions</a></div></div></section>
        <section t-if="official_access" class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h4">My official assignments</h2><p>Review the exact assignment and respond. Acceptance does not establish eligibility or attendance.</p><a href="/my/referee-assignments" class="btn btn-primary">Review assignments</a></div></div></section>
        <section t-if="manager_access" class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h4">Organising and review</h2><p>Open source records through the authorised backend. Independent review remains governed by the competition policy.</p><a href="/federation/operations/action-items" class="btn btn-primary">Open manager queue</a></div></div></section>
        <section t-if="planner_access" class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h4">Competition planning</h2><p>Continue the existing competition planner and its governed publication journey.</p><a href="/odoo/action-sports_federation_setup_flow.action_competition_setup_home" class="btn btn-primary">Open competition planner</a></div></div></section>
        <section t-if="reviewer_access" class="col-md-6"><div class="card h-100"><div class="card-body"><h2 class="h4">Result review</h2><p>Open pending decisions under your existing reviewer permissions.</p><a href="/my/work/reviews" class="btn btn-primary">Open review work</a></div></div></section>
      </div>
      <section class="mt-4" t-if="club_access"><h2 class="h4">Preparation status</h2><p class="text-muted">This is a scoped work queue, not a certification that all competition checks passed.</p>
        <div class="list-group"><a t-foreach="tasks" t-as="task" t-att-href="task.journey_url" class="list-group-item list-group-item-action" data-journey-open="1"><strong><t t-esc="task.name"/></strong><br/><t t-esc="task.next_step"/><span class="badge text-bg-light ms-2"><t t-esc="dict(task._fields['journey_status'].selection).get(task.journey_status)"/></span></a></div>
        <p t-if="not tasks" class="alert alert-info mt-2">No current preparation tasks are visible in your scope. Check competition status for planning and publication readiness.</p>
      </section>
    </main></t>
  </template>
  <template id="missing_roster" name="Create Missing Roster">
    <t t-call="portal.portal_layout"><main class="container py-4" t-att-data-journey-user="journey_user_id"><h1>Create the team roster</h1><p><strong><t t-esc="registration.team_id.display_name"/></strong> has a confirmed registration for <t t-esc="registration.season_id.display_name"/> but no roster.</p><p>Create the roster, add eligible players and activate it before preparing a lineup.</p>
      <form t-attf-action="/my/rosters/create/#{registration.id}" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit" class="btn btn-primary">Create roster</button></form>
      <a href="/my/action-items?scope=club" class="btn btn-outline-secondary mt-3">Back to preparation inbox</a>
    </main></t>
  </template>
  <template id="inbox_journey" inherit_id="sports_federation_portal.portal_my_operation_tasks">
    <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' container ')]" position="attributes"><attribute name="t-att-data-journey-user">request.env.user.id</attribute></xpath>
    <xpath expr="//article//strong[t[@t-esc='task.name']]" position="after"><span class="badge text-bg-light ms-2"><t t-esc="dict(task._fields['journey_status'].selection).get(task.journey_status)"/></span><div class="small text-muted">Next responsible party: <t t-esc="dict(task._fields['journey_owner'].selection).get(task.journey_owner)"/><span t-if="not task.assigned_user_id"> · Unassigned</span><span t-if="not task.deadline"> · No deadline specified</span></div></xpath>
    <xpath expr="//a[@t-att-href='task.action_url']" position="replace"><a t-if="task.action_url and task.journey_status != 'unavailable'" t-att-href="task.journey_url" data-journey-open="1" class="btn btn-primary align-self-start"><t t-if="task.journey_status == 'waiting'">View review status</t><t t-else="">Open next step</t></a></xpath>
    <xpath expr="//nav[hasclass('d-flex') and hasclass('gap-2') and hasclass('mb-4')]" position="after"><section t-if="journey_waiting_entries" class="card mb-4"><div class="card-body"><h3 class="h5">Competition entries waiting for federation review</h3><p>These submissions are not unfinished club actions. Open an entry to view its current status.</p><div class="list-group"><a t-foreach="journey_waiting_entries" t-as="entry" t-attf-href="/my/competition-entries/#{entry.id}" data-journey-open="1" class="list-group-item list-group-item-action"><strong><t t-esc="entry.team_id.display_name"/></strong> · <t t-esc="entry.edition_id.display_name"/></a></div><p class="small text-muted mt-2">Showing at most 100 recent submissions.</p></div></section></xpath>
    <xpath expr="//nav[hasclass('d-flex') and hasclass('gap-2') and hasclass('mb-4')]" position="before"><a href="/my/work" class="btn btn-outline-secondary mb-3">Switch responsibility</a></xpath>
  </template>
  <template id="manager_queue" name="Manager Work Queue">
    <t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/work" class="btn btn-outline-secondary mb-3">Switch responsibility</a><h1>Manager work queue</h1><p>Open the linked task and its source through the backend. Current source permissions and independent review checks apply.</p>
      <div class="d-flex gap-3 mb-3"><span>All manager work: <t t-esc="summary['total']"/> open items</span><span><t t-esc="summary['blocking']"/> blocking</span><span><t t-esc="summary['overdue']"/> overdue</span></div>
      <form method="get" action="/federation/operations/action-items" class="d-flex gap-2 flex-wrap mb-3"><select name="task_type" class="form-select w-auto" aria-label="Task type"><option value="">All task types</option><option t-foreach="task_type_labels.items()" t-as="kind" t-att-value="kind[0]" t-att-selected="kind[0] == active_task_type"><t t-esc="kind[1]"/></option></select><button class="btn btn-outline-primary">Filter</button></form>
      <p><t t-esc="len(tasks)"/> matching tasks in this view.</p><div class="list-group"><a t-foreach="tasks" t-as="task" t-att-href="task.journey_url" class="list-group-item list-group-item-action"><strong><t t-esc="task.name"/></strong><br/><t t-esc="task.blocking_reason"/><br/><t t-esc="task.next_step"/><span class="ms-2" t-if="task.deadline">Due: <t t-esc="task.deadline"/></span></a></div><p t-if="not tasks" class="alert alert-info">No matching tasks. This does not certify that all competition checks passed.</p>
    </main></t>
  </template>
  <template id="review_work" name="Result Review Work"><t t-call="portal.portal_layout"><main class="container py-4"><a href="/my/work" class="btn btn-outline-secondary mb-3">Switch responsibility</a><h1>Result review</h1><p>Pending records visible to your current role. Opening a record does not grant approval rights; the competition policy and independent-review checks remain authoritative.</p><div class="list-group"><a t-foreach="matches" t-as="match" t-attf-href="/odoo/federation.match/#{match.id}" class="list-group-item list-group-item-action"><strong><t t-esc="match.display_name"/></strong><span class="ms-2"><t t-esc="match.result_state"/></span></a></div><p t-if="not matches" class="alert alert-info">No pending results are visible to your current role.</p><p class="text-muted">Showing at most 100 recent pending records. Use the backend filters for older work.</p></main></t></template>
  <template id="portal_journey_entry" inherit_id="portal.portal_my_home">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="before"><a href="/my/work" class="btn btn-primary my-3">My federation work</a></xpath>
  </template>
</odoo>
