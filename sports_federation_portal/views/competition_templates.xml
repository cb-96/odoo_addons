<odoo>
  <template id="portal_my_competitions" name="My Competitions">
    <t t-call="portal.portal_layout">
      <t t-set="breadcrumbs_searchbar" t-value="True"/>
      <t t-call="portal.portal_searchbar"><t t-set="title">Competitions</t></t>
      <div class="container py-3">
        <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="mb-1">Your competitions</h2><p class="text-muted mb-0">Everything your teams need for registration, schedules, match days and results.</p></div><a href="/my/match-days" class="btn btn-outline-primary">Match days</a></div>
        <div class="row g-3" t-if="competition_cards">
          <div class="col-12 col-lg-6" t-foreach="competition_cards" t-as="card">
            <article class="card h-100 shadow-sm border-0"><div class="card-body"><div class="d-flex justify-content-between gap-3"><div><h3 class="h5 mb-1"><t t-esc="card['edition'].display_name"/></h3><p class="text-muted mb-2"><t t-esc="', '.join(card['teams'].mapped('display_name'))"/></p></div><span t-attf-class="badge text-bg-#{card['status_tone']}"><t t-esc="card['status_label']"/></span></div><p class="mb-1"><strong>Published match days:</strong> <t t-esc="card['published_matchday_count']"/></p><p class="mb-3"><strong>Result follow-up:</strong> <t t-esc="card['result_follow_up_count']"/></p><a t-attf-href="/my/competitions/#{card['edition'].id}" class="btn btn-primary">Open competition</a></div></article>
          </div>
        </div>
        <div class="alert alert-info" role="alert" t-else="">No competitions are available yet. Your competitions will appear after a team entry is accepted.</div>
      </div>
    </t>
  </template>
  <template id="portal_my_competition_detail" name="Competition Workspace">
    <t t-call="portal.portal_layout"><div class="container py-3"><a href="/my/competitions" class="text-decoration-none">← Competitions</a><div class="d-flex justify-content-between align-items-start mt-2 mb-4"><div><h2><t t-esc="workspace['edition'].display_name"/></h2><p class="text-muted"><t t-esc="', '.join(workspace['teams'].mapped('display_name'))"/></p></div><span t-attf-class="badge text-bg-#{workspace['status_tone']}"><t t-esc="workspace['status_label']"/></span></div>
      <div class="row g-3"><section class="col-12 col-lg-6"><div class="card h-100"><div class="card-header"><strong>Participation</strong></div><div class="card-body"><div t-foreach="workspace['entries']" t-as="entry" class="mb-2"><t t-esc="entry.team_id.display_name"/> · <span class="badge text-bg-light"><t t-esc="entry.state"/></span></div><div t-foreach="workspace['participant_sets']" t-as="pset"><strong><t t-esc="pset.division_id.display_name"/></strong>: <t t-esc="', '.join(pset.line_ids.filtered(lambda l: l.team_id in workspace['teams']).mapped('team_id.display_name'))"/></div></div></div></section>
      <section class="col-12 col-lg-6"><div class="card h-100"><div class="card-header"><strong>Upcoming published match days</strong></div><div class="list-group list-group-flush"><a t-foreach="workspace['matchdays']" t-as="day" t-attf-href="/my/match-days/#{day.id}" class="list-group-item list-group-item-action"><strong><t t-esc="day.display_name"/></strong><br/><span class="text-muted"><t t-esc="day.date"/> · <t t-esc="day.venue_id.display_name"/> · official schedule revision <t t-esc="day.current_publication_id.version"/></span></a><div class="list-group-item text-muted" t-if="not workspace['matchdays']">No current publication is available.</div></div></div></section></div>
      <section class="card mt-3"><div class="card-header"><strong>Fixtures and results</strong></div><div class="table-responsive"><table class="table mb-0"><caption class="visually-hidden">Fixtures and results</caption><thead><tr><th scope="col">Kickoff</th><th scope="col">Match</th><th scope="col">Published slot</th><th scope="col">Status</th></tr></thead><tbody><tr t-foreach="workspace['matches']" t-as="match"><td><t t-esc="match.date_scheduled"/></td><td><t t-esc="match.display_name"/></td><td><t t-esc="match.published_slot_id.display_name"/></td><td><t t-esc="match.state"/></td></tr></tbody></table></div></section>
    </div></t>
  </template>
  <template id="portal_my_competition_entries" name="Competition Entries">
    <t t-call="portal.portal_layout"><div class="container py-3"><div class="d-flex justify-content-between"><div><h2>Competition entries</h2><p class="text-muted">Registration windows and entries for your represented teams.</p></div><a href="/my/competitions" class="btn btn-outline-primary">Competitions</a></div><div class="alert alert-success" t-if="success"><t t-esc="success"/></div><div class="alert alert-danger" t-if="error"><t t-esc="error"/></div>
      <section class="card mb-3"><div class="card-header"><strong>Submit a new entry</strong></div><div class="card-body"><form action="/my/competition-entries/new" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-2"><div class="col-md-5"><label class="form-label" for="window_id">Registration window</label><select id="window_id" name="window_id" class="form-select" required="required"><option value="">Select</option><option t-foreach="windows" t-as="window" t-att-value="window.id"><t t-esc="window.display_name"/> · <t t-esc="window.division_id.display_name"/></option></select></div><div class="col-md-5"><label class="form-label" for="team_id">Team</label><select id="team_id" name="team_id" class="form-select" required="required"><option value="">Select</option><option t-foreach="teams" t-as="team" t-att-value="team.id"><t t-esc="team.display_name"/></option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Submit</button></div></div></form></div></section>
      <section class="card"><div class="card-header"><strong>Current entries</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Competition</th><th>Division</th><th>Team</th><th>Status</th></tr></thead><tbody><tr t-foreach="entries" t-as="entry"><td><t t-esc="entry.edition_id.display_name"/></td><td><t t-esc="entry.window_id.division_id.display_name"/></td><td><t t-esc="entry.team_id.display_name"/></td><td><span class="badge text-bg-light"><t t-esc="entry.state"/></span></td></tr></tbody></table></div></section>
    </div></t>
  </template>
  <template id="portal_my_matchdays" name="My Match Days"><t t-call="portal.portal_layout"><div class="container py-3"><div class="d-flex justify-content-between"><div><h2>Match days</h2><p class="text-muted">Schedules are shown only from current live publications.</p></div><a href="/my/competitions" class="btn btn-outline-primary">Competitions</a></div><div class="list-group"><a t-foreach="matchdays" t-as="day" t-attf-href="/my/match-days/#{day.id}" class="list-group-item list-group-item-action"><strong><t t-esc="day.display_name"/></strong><span class="ms-2 badge text-bg-light">official schedule revision <t t-esc="day.current_publication_id.version"/></span><br/><span class="text-muted"><t t-esc="day.date"/> · <t t-esc="day.venue_id.display_name"/></span></a></div><div class="alert alert-info mt-3" t-if="not matchdays">No published match days are visible.</div></div></t></template>
  <template id="portal_my_matchday_detail" name="Match-Day Workspace"><t t-call="portal.portal_layout"><div class="container py-3"><a href="/my/match-days">← Match days</a><h2 class="mt-2"><t t-esc="workspace['matchday'].display_name"/></h2><p class="text-muted"><t t-esc="workspace['matchday'].date"/> · <t t-esc="workspace['matchday'].venue_id.display_name"/> · live official schedule revision <t t-esc="workspace['publication'].version"/></p><div class="table-responsive"><table class="table"><thead><tr><th>Time</th><th>Match</th><th>Court</th><th>Operational status</th><th>Result</th></tr></thead><tbody><tr t-foreach="workspace['matches']" t-as="match"><td><t t-esc="match.date_scheduled"/></td><td><t t-esc="match.display_name"/></td><td><t t-esc="(match.operational_slot_id or match.published_slot_id).display_name"/></td><td><span class="badge text-bg-light"><t t-esc="match.operational_status"/></span></td><td><t t-esc="match.result_state"/></td></tr></tbody></table></div></div></t></template>
  <template id="portal_matchday_operations_page" name="Match-Day Operations"><t t-call="portal.portal_layout"><div class="container-fluid py-3"><a href="/my/match-days">← Match days</a><div class="d-flex justify-content-between align-items-start mt-2"><div><h2><t t-esc="workspace['matchday'].display_name"/></h2><p class="text-muted">Current official schedule revision <t t-esc="workspace['publication'].version"/> · <t t-esc="workspace['publication'].state"/></p></div><span class="badge text-bg-danger" t-if="workspace['session']">Live session</span></div><div class="row g-3"><div class="col-12 col-xl-8"><div class="card"><div class="card-header"><strong>Published matches</strong></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Match</th><th>Published</th><th>Operational</th><th>Status</th></tr></thead><tbody><tr t-foreach="workspace['matches']" t-as="match"><td><t t-esc="match.display_name"/></td><td><t t-esc="match.published_slot_id.display_name"/></td><td><t t-esc="match.operational_slot_id.display_name"/></td><td><t t-esc="match.operational_status"/></td></tr></tbody></table></div></div></div><div class="col-12 col-xl-4"><div class="card mb-3"><div class="card-header"><strong>Courts</strong></div><ul class="list-group list-group-flush"><li t-foreach="workspace['courts']" t-as="court" class="list-group-item"><t t-esc="court.court_id.display_name"/> · <t t-esc="court.state"/></li></ul></div><div class="card"><div class="card-header"><strong>Open incidents</strong></div><ul class="list-group list-group-flush"><li t-foreach="workspace['incidents'].filtered(lambda i: not i.resolved)" t-as="incident" class="list-group-item"><t t-esc="incident.description"/></li></ul></div></div></div></div></t></template>
</odoo>
