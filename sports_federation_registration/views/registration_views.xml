<odoo>
 <record id="registration_window_list" model="ir.ui.view"><field name="name">federation.registration.window.list</field><field name="model">federation.registration.window</field><field name="arch" type="xml"><list decoration-success="state == 'finalized'" decoration-info="state == 'open'"><field name="name"/><field name="edition_id"/><field name="division_id"/><field name="date_open"/><field name="date_close"/><field name="state" widget="badge"/></list></field></record>
 <record id="registration_window_form" model="ir.ui.view"><field name="name">federation.registration.window.form</field><field name="model">federation.registration.window</field><field name="arch" type="xml"><form><header><button name="action_open" type="object" string="Open Registration" class="btn-primary" invisible="state != 'draft'"/><button name="action_close" type="object" string="Close Registration" invisible="state != 'open'"/><button name="action_finalize" type="object" string="Finalize Participants" class="btn-primary" invisible="state != 'closed'"/><field name="state" widget="statusbar" statusbar_visible="draft,open,closed,finalized"/></header><sheet><group><field name="name"/><field name="edition_id"/><field name="division_id" domain="[('edition_id','=',edition_id)]"/><field name="date_open"/><field name="date_close"/><field name="participant_set_id" readonly="1"/></group><notebook><page string="Team Entries"><field name="entry_ids" context="{'default_window_id': id}"><list editable="bottom"><field name="available_team_ids" column_invisible="1"/><field name="team_id" domain="[('id', 'in', available_team_ids)]"/><field name="seed"/><field name="state"/><field name="review_note"/></list></field></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_registration_desk" model="ir.actions.act_window"><field name="name">Registration Desk</field><field name="res_model">federation.registration.window</field><field name="view_mode">list,form</field></record>
</odoo>
