<odoo>
  <record id="matchday_close_wizard_form" model="ir.ui.view">
    <field name="name">federation.matchday.close.wizard.form</field><field name="model">federation.matchday.close.wizard</field>
    <field name="arch" type="xml"><form string="Close Match Day"><sheet><div class="alert alert-warning" role="alert">Normal closure requires all published matches to be completed or cancelled and every incident to be resolved.</div><group><field name="matchday_id"/><field name="force"/><field name="close_note" required="force"/></group></sheet><footer><button name="action_close" type="object" string="Close Match Day" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
  </record>
  <record id="matchday_incident_wizard_form" model="ir.ui.view">
    <field name="name">federation.matchday.incident.wizard.form</field><field name="model">federation.matchday.incident.wizard</field>
    <field name="arch" type="xml"><form string="Report Incident"><sheet><group><field name="matchday_id"/><field name="incident_type"/><field name="description"/></group></sheet><footer><button name="action_report" type="object" string="Report Incident" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
  </record>
  <record id="matchday_court_status_wizard_form" model="ir.ui.view">
    <field name="name">federation.matchday.court.status.wizard.form</field><field name="model">federation.matchday.court.status.wizard</field>
    <field name="arch" type="xml"><form string="Update Court Status"><sheet><group><field name="matchday_id"/><field name="court_id"/><field name="state"/><field name="delay_minutes" invisible="state != 'delayed'"/><field name="note"/></group></sheet><footer><button name="action_apply" type="object" string="Update Court" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
  </record>
  <record id="matchday_deviation_wizard_form" model="ir.ui.view">
    <field name="name">federation.matchday.deviation.wizard.form</field><field name="model">federation.matchday.deviation.wizard</field>
    <field name="arch" type="xml"><form string="Operational Schedule Change"><sheet><div class="alert alert-warning" role="alert">This records an operational deviation. It never changes the approved publication snapshot.</div><group><field name="matchday_id"/><field name="match_id"/><field name="deviation_type"/><field name="new_slot_id" invisible="deviation_type != 'move'" required="deviation_type == 'move'"/><field name="delay_minutes" invisible="deviation_type != 'delay'" required="deviation_type == 'delay'"/><field name="reason"/></group></sheet><footer><button name="action_apply" type="object" string="Record Change" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
  </record>
</odoo>
