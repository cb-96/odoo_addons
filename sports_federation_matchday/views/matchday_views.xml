<odoo>
 <record id="incident_list" model="ir.ui.view"><field name="name">federation.matchday.incident.list</field><field name="model">federation.matchday.incident</field><field name="arch" type="xml"><list decoration-danger="not resolved"><field name="occurred_at"/><field name="matchday_id"/><field name="incident_type"/><field name="description"/><field name="resolved"/></list></field></record>
 <record id="action_matchday_control" model="ir.actions.act_window"><field name="name">Match-Day Control</field><field name="res_model">federation.matchday</field><field name="view_mode">kanban,list,form</field><field name="domain">[('state','in',('scheduled','open'))]</field></record>
 <record id="action_matchday_incidents" model="ir.actions.act_window"><field name="name">Match-Day Incidents</field><field name="res_model">federation.matchday.incident</field><field name="view_mode">list,form</field></record>
</odoo>
