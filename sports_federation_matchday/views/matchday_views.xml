<odoo>
 <record id="incident_list" model="ir.ui.view"><field name="name">federation.matchday.incident.list</field><field name="model">federation.matchday.incident</field><field name="arch" type="xml"><list decoration-danger="not resolved"><field name="occurred_at"/><field name="matchday_id"/><field name="incident_type"/><field name="description"/><field name="resolved"/><field name="resolved_by_id"/></list></field></record>
 <record id="matchday_form_operations" model="ir.ui.view"><field name="name">federation.matchday.form.operations</field><field name="model">federation.matchday</field><field name="inherit_id" ref="sports_federation_calendar.matchday_form"/><field name="arch" type="xml"><xpath expr="//group[1]" position="after"><group string="Published execution"><field name="current_publication_id" readonly="1"/><field name="active_session_id" readonly="1"/></group></xpath></field></record>
 <record id="session_list" model="ir.ui.view"><field name="name">federation.matchday.session.list</field><field name="model">federation.matchday.session</field><field name="arch" type="xml"><list><field name="matchday_id"/><field name="publication_id"/><field name="state" widget="badge"/><field name="opened_at"/><field name="opened_by_id"/><field name="closed_at"/><field name="closed_by_id"/></list></field></record>
 <record id="action_matchday_control" model="ir.actions.act_window"><field name="name">Match-Day Control</field><field name="res_model">federation.matchday</field><field name="view_mode">kanban,list,form</field><field name="domain">[("state","in",("scheduled","open"))]</field></record>
 <record id="action_matchday_incidents" model="ir.actions.act_window"><field name="name">Match-Day Incidents</field><field name="res_model">federation.matchday.incident</field><field name="view_mode">list,form</field></record>
</odoo>
