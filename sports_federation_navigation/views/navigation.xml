<odoo>
  <!--
    Supported backend navigation for the Federation application.

    This file is the single authoritative map of names, parents, ordering and
    group visibility for every menu owned by the addons this module depends
    on. Domain addons keep owning their actions, models, ACLs and menu XML IDs.
    Optional addons that load later (accounting, member services) place their
    own menus in the sections defined here or in sports_federation_base.

    Rules (see docs/user-guide/backend-navigation.md):
    - at most three levels below the app: area > section > item;
    - a menu with children never carries an action (Odoo cannot open it);
    - one menu per screen: no duplicates of the Competition Hub or of forms
      that already open the same records contextually;
    - specialist and raw-record screens require Advanced Federation Tools;
    - audit and technical records are under Administration > System, which is
      only shown in developer mode.

    group_ids always use (6, 0, ...) so upgrades converge on this map instead
    of accumulating groups linked by earlier versions.
  -->

  <!-- ===== Federation > Competitions ===================================== -->
  <record id="sports_federation_base.menu_federation_competitions" model="ir.ui.menu">
    <field name="name">Competitions</field>
    <field name="sequence">10</field>
    <field name="group_ids" eval="[(6, 0, [])]"/>
  </record>
