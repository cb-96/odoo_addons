  <record id="sports_federation_setup_flow.menu_competition_setup_home" model="ir.ui.menu">
    <field name="name">Competitions</field>
    <field name="parent_id" ref="sports_federation_base.menu_federation_competitions"/>
    <field name="sequence">1</field>
    <field name="group_ids" eval="[(6, 0, [])]"/>
  </record>

