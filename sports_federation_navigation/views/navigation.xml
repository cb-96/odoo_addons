    <field name="group_ids" eval="[(6, 0, [ref('sports_federation_base.group_federation_advanced_operator')])]"/>
  </record>
  <record id="sports_federation_tournament.menu_federation_competition_edition" model="ir.ui.menu">
    <field name="group_ids" eval="[(6, 0, [ref('sports_federation_base.group_federation_advanced_operator')])]"/>
