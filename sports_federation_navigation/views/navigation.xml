  <!--
    Ordinary navigation, four nouns: Competition, Division, Game day, Match.
    An ordinary federation manager sees at most fifteen entries. Specialist,
    configuration and recovery screens stay reachable for Advanced Federation
    Tools and from contextual buttons; no action, ACL or model is removed.
  -->
  <record id="sports_federation_tournament.menu_federation_tournament" model="ir.ui.menu">
    <field name="name">Divisions &amp; Matches</field>
  </record>
  <record id="sports_federation_tournament.menu_federation_tournament_list" model="ir.ui.menu">
    <field name="name">Divisions</field>
  </record>
  <record id="sports_federation_matchday.menu_matchday_control" model="ir.ui.menu">
    <field name="name">Game Days</field>
    <field name="sequence">1</field>
  </record>
  <record id="sports_federation_live_workspace.menu_run_court" model="ir.ui.menu">
    <field name="name">Run this court</field>
    <field name="sequence">2</field>
  </record>
  <record id="sports_federation_live_workspace.menu_court_access" model="ir.ui.menu">
    <field name="group_ids" eval="[(6, 0, [ref('sports_federation_base.group_federation_advanced_operator')])]"/>
  </record>
  <record id="sports_federation_live_workspace.menu_court_evidence" model="ir.ui.menu">
    <field name="group_ids" eval="[(6, 0, [ref('sports_federation_base.group_federation_advanced_operator')])]"/>
  </record>
  <record id="sports_federation_people.menu_federation_player_config" model="ir.ui.menu">
