+}
+.o_fed_cw_context_bar {
+    position: sticky;
+    top: 0;
+    z-index: 20;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 1rem;
+    padding: 0.85rem 1rem;
+    border: 1px solid rgba(15, 23, 42, 0.08);
+    border-radius: 1rem;
+    background: rgba(255, 255, 255, 0.96);
+    box-shadow: 0 0.5rem 1.25rem rgba(15, 23, 42, 0.08);
+    backdrop-filter: blur(10px);
+}
+.o_fed_cw_context_bar .o_fed_cw_nav { justify-content: flex-end; }
+.o_fed_cw_context_bar .btn:disabled { opacity: 0.42; }
+.o_fed_cw_step_footer {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    gap: 1rem;
+    margin-top: 1.5rem;
+    padding: 1rem;
+    border-top: 1px solid rgba(15, 23, 42, 0.08);
+}
+@media (max-width: 991.98px) {
+    .o_fed_cw_context_bar { align-items: flex-start; flex-direction: column; }
+    .o_fed_cw_context_bar .o_fed_cw_nav {
+        width: 100%;
+        flex-wrap: nowrap;
+        justify-content: flex-start;
+        overflow-x: auto;
+        padding-bottom: 0.25rem;
+    }
+    .o_fed_cw_context_bar .o_fed_cw_nav .btn { flex: 0 0 auto; }
+    .o_fed_cw_stepper { grid-template-columns: 1fr; }
+}
