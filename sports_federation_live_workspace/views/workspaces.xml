<odoo>
 <record id="action_run_court" model="ir.actions.client"><field name="name">Run this court</field><field name="tag">federation_run_court</field></record>
 <menuitem id="menu_run_court" name="Run this court" parent="sports_federation_base.menu_federation_match_day" action="action_run_court" sequence="1" groups="base.group_user"/>
 <record id="court_access_list" model="ir.ui.view"><field name="name">federation.court.access.list</field><field name="model">federation.court.access</field><field name="arch" type="xml"><list editable="bottom"><field name="matchday_id"/><field name="court_id"/><field name="user_id"/><field name="active"/></list></field></record>
 <record id="action_court_access" model="ir.actions.act_window"><field name="name">Assign court operators</field><field name="res_model">federation.court.access</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_court_access" name="Assign court operators" parent="sports_federation_base.menu_federation_match_day" action="action_court_access" sequence="2" groups="sports_federation_matchday.group_matchday_manager"/>
 <record id="capture_list" model="ir.ui.view"><field name="name">federation.court.capture.list</field><field name="model">federation.court.capture</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="match_id"/><field name="revision"/><field name="submitted"/><field name="review_required"/><field name="closed"/><field name="write_date"/></list></field></record>
 <record id="capture_form" model="ir.ui.view"><field name="name">federation.court.capture.form</field><field name="model">federation.court.capture</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_resolve_exception" type="object" string="Resolve exception"/><button name="action_open_result" type="object" string="Open canonical result review"/></header><sheet><group><field name="match_id"/><field name="revision"/><field name="submitted"/><field name="review_required"/><field name="closed"/><field name="payload"/><field name="previous_payload"/><field name="signature"/></group></sheet></form></field></record>
 <record id="action_court_evidence" model="ir.actions.act_window"><field name="name">Court recovery and exceptions</field><field name="res_model">federation.court.capture</field><field name="view_mode">list,form</field></record>
 <menuitem id="menu_court_evidence" name="Court recovery and exceptions" parent="sports_federation_base.menu_federation_match_day" action="action_court_evidence" sequence="3" groups="sports_federation_matchday.group_matchday_manager"/>
 <record id="schedule_visual_form" model="ir.ui.view"><field name="name">schedule.visual.entry</field><field name="model">federation.schedule</field><field name="inherit_id" ref="sports_federation_scheduling.schedule_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_visual_plan" type="object" string="Visual planning"/></xpath></field></record>
 <record id="edition_scoring_form" model="ir.ui.view"><field name="name">edition.court.scoring</field><field name="model">federation.competition.edition</field><field name="inherit_id" ref="sports_federation_competition_core.competition_edition_form_workflow"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Court scoring"><field name="court_scoring_mode"/><field name="court_set_target" invisible="court_scoring_mode != 'sets'"/><field name="court_max_periods"/></group></xpath></field></record>
 <record id="resolve_exception_form" model="ir.ui.view"><field name="name">court.resolve.form</field><field name="model">federation.court.resolve.wizard</field><field name="arch" type="xml"><form string="Coordinator decision"><group><field name="capture_id"/><field name="expected_revision"/><field name="disposition"/><field name="reason"/></group><footer><button name="action_resolve" type="object" string="Record decision" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
</odoo>
