<?xml version='1.0' encoding='UTF-8'?>
<odoo>
 <template id="mobile_home" name="Mobile match-day work"><t t-call="portal.portal_layout"><main class="container py-3 sf-mobile-matchday">
  <h1>Match-day work</h1><p>Open your assigned court or official assignment. Saved scores, acceptance, check-in requests and confirmed attendance are separate facts.</p>
  <p t-if="success" role="status" class="alert alert-success"><t t-esc="success"/></p><p t-if="error" role="alert" class="alert alert-danger"><t t-esc="error"/></p>
  <nav class="d-flex flex-wrap gap-2 mb-3"><a href="/my/work" class="btn btn-outline-secondary">My work</a><a href="/my/duty-assignments" class="btn btn-outline-secondary">All my assignments</a><a href="/my/notifications" class="btn btn-outline-secondary">Notifications</a></nav>
  <section t-if="courts"><h2 class="h4">Assigned courts</h2><p t-foreach="courts" t-as="court"><strong><t t-esc="court['name']"/></strong></p><a href="/odoo/action-sports_federation_live_workspace.action_run_court" class="btn btn-primary">Run my court</a><p class="small text-muted">A single court opens automatically. Your last authorised court and match are remembered on this device.</p></section>
  <section class="mt-3"><h2 class="h4">My official assignments</h2><p t-if="not assignments">No current assignments in this view.</p><article t-foreach="assignments" t-as="assignment" class="card mb-3"><div class="card-body"><h3 class="h5"><t t-esc="assignment.match_id.display_name"/></h3><p><span t-esc="request.env['federation.event.time'].display(assignment.match_id.coverage_kickoff, assignment.match_id)"/> | <span t-field="assignment.role"/></p><p>Venue: <t t-esc="assignment.publication_id.matchday_id.venue_id.display_name"/></p><p>Accepted: <t t-esc="'Yes' if assignment.coverage_accepted else 'Not current'"/> | Attendance: <t t-esc="'Confirmed' if assignment.coverage_present else 'Not confirmed'"/></p><a t-attf-href="/my/duty-assignments/#{assignment.id}" class="btn btn-primary">Open assignment and venue</a></div></article></section>
  <section t-if="manager" class="mt-3"><h2 class="h4">Organiser coverage and attendance</h2><p>Current scoped view, up to 50 matches. Existing manager permissions and eligibility checks apply.</p><article t-foreach="manager_rows" t-as="row" class="card mb-3"><div class="card-body"><h3 class="h5"><t t-esc="row['match'].display_name"/></h3><p>Officials: <t t-esc="row['coverage']['readiness_label']"/></p><div t-foreach="row['assignments']" t-as="assignment" class="border-top py-2"><p><t t-esc="assignment.referee_id.display_name"/> | <span t-field="assignment.role"/> | <span t-field="assignment.state"/></p><p>Accepted: <t t-esc="'Yes' if assignment.coverage_accepted else 'No'"/> | Eligible: <t t-esc="'Yes' if assignment.coverage_eligible else 'No'"/> | Present: <t t-esc="'Confirmed' if assignment.coverage_present else 'Not confirmed'"/></p><p t-if="assignment.checkin_requested_on">Check-in requested: <span t-field="assignment.checkin_requested_on"/> <t t-if="assignment.checkin_signature != assignment._coverage_signature()">(old context; request again)</t></p>
   <form t-if="assignment.coverage_accepted and assignment.coverage_eligible and not assignment.coverage_present" t-attf-action="/my/matchday-mobile/assignments/#{assignment.id}/present" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="signature" t-att-value="assignment._coverage_signature()"/><button class="btn btn-primary" type="submit">Confirm attendance</button></form>
   <a t-if="assignment.state != 'done' and not assignment.replacement_ids" t-attf-href="/my/matchday-mobile/assignments/#{assignment.id}/replace" class="btn btn-outline-danger mt-2">Replace unavailable official</a>
  </div><a t-attf-href="/odoo/federation.match/#{row['match'].id}" class="btn btn-outline-secondary">Open full coverage record</a></div></article></section>
 </main></t></template>
 <template id="mobile_replacement" name="Mobile official replacement"><t t-call="portal.portal_layout"><main class="container py-3 sf-mobile-matchday"><a href="/my/matchday-mobile" class="btn btn-outline-secondary mb-3">Back to match-day work</a><h1>Replace unavailable official</h1><p><t t-esc="assignment.referee_id.display_name"/> | <t t-esc="assignment.match_id.display_name"/> | <span t-field="assignment.role"/></p><p>The old assignment remains in history. The successor starts unaccepted. Eligibility and conflict checks still apply.</p><p t-if="error" role="alert" class="alert alert-danger"><t t-esc="error"/></p><form t-attf-action="/my/matchday-mobile/assignments/#{assignment.id}/replace" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="wizard_id" t-att-value="wizard.id"/><label for="replacement-referee" class="form-label">Replacement official</label><select id="replacement-referee" name="referee_id" class="form-select mb-3" required="required"><option value="">Choose an official</option><option t-foreach="referees" t-as="referee" t-att-value="referee.id"><t t-esc="referee.display_name"/></option></select><label for="replacement-reason" class="form-label">Reason</label><textarea id="replacement-reason" name="reason" class="form-control mb-3" required="required" maxlength="2000"/><button type="submit" class="btn btn-primary">Record replacement</button></form></main></t></template>
 <template id="mobile_assignment_detail" inherit_id="sports_federation_duty_coverage.assignment_detail"><xpath expr="//h1" position="after"><section class="card mb-3"><div class="card-body"><h2 class="h5">Venue and check-in</h2><p><t t-esc="assignment.publication_id.matchday_id.venue_id.display_name"/></p><p><t t-esc="assignment.publication_id.matchday_id.venue_id.street"/> <t t-esc="assignment.publication_id.matchday_id.venue_id.zip"/> <t t-esc="assignment.publication_id.matchday_id.venue_id.city"/></p><p>Court: <t t-esc="assignment.operational_slot_id.court_id.display_name or assignment.match_id.published_slot_id.court_id.display_name"/></p><p>Attendance: <t t-esc="'Confirmed by organiser' if assignment.coverage_present else 'Not confirmed'"/></p><p t-if="checkin_current">Check-in requested. The organiser still confirms attendance.</p><form t-if="assignment.coverage_accepted and assignment.coverage_eligible and not assignment.coverage_present and not checkin_current" t-attf-action="/my/duty-assignments/#{assignment.id}/checkin" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="signature" t-att-value="assignment._coverage_signature()"/><button type="submit" class="btn btn-primary">Request check-in</button></form><a href="/my/matchday-mobile" class="btn btn-outline-secondary mt-2">Match-day work</a></div></section></xpath></template>
 <template id="mobile_work_entry" inherit_id="sports_federation_portal.role_home"><xpath expr="//h1" position="after"><a href="/my/matchday-mobile" class="btn btn-outline-primary mb-3">Match-day work: court and officials</a></xpath></template>
</odoo>