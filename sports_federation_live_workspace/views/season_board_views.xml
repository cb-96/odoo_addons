<odoo>
  <record id="edition_form_season_board" model="ir.ui.view">
    <field name="name">edition.season.board.button</field>
    <field name="model">federation.competition.edition</field>
    <field name="inherit_id" ref="sports_federation_competition_core.competition_edition_form_workflow"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="action_open_season_board" type="object" class="oe_stat_button" icon="fa-th" string="Match board"/>
      </xpath>
    </field>
  </record>
</odoo>
