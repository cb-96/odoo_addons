<?xml version='1.0' encoding='UTF-8'?>
<templates xml:space="preserve">
<t t-name="sports_federation_live_workspace.Court">
 <main class="sf-live-workspace sf-court-mobile" t-att-data-current-match="state.match ? state.match.match_id : null">
  <h1>Run this court</h1><p t-if="state.board">Venue: <t t-esc="state.board.venue"/> | Court: <t t-esc="state.board.court"/> | <t t-esc="state.board.timezone || 'UTC'"/></p>
  <label>Assigned court <select class="form-select" t-on-change="chooseCourt" t-att-value="state.selected" t-att-disabled="state.courtLoading || state.busy">
   <option value="">Choose your court</option><t t-foreach="state.courts" t-as="court" t-key="court_index"><option t-att-value="court_index"><t t-esc="court.name"/></option></t>
  </select></label>
  <p t-if="!state.courts.length">No court assigned. Ask the match-day manager to assign your account.</p>
  <div t-if="state.error" class="alert alert-danger" role="alert" tabindex="-1" id="court-error"><t t-esc="state.error"/></div>
  <div><p t-if="state.offline || state.contextUnchecked" class="alert alert-warning" role="status">Connection not confirmed. Device drafts are not official results. Reconnect to check server status.</p><p t-if="state.recoveryNotice" class="alert alert-info" role="status"><t t-esc="state.recoveryNotice"/></p><a href="/my/matchday-mobile" class="btn btn-outline-secondary mb-2">Match-day home</a><button t-if="state.board" type="button" class="btn btn-outline-secondary mb-2 ms-2" t-on-click="() =&gt; { this.state.queueOpen = !this.state.queueOpen; }" t-att-aria-expanded="state.queueOpen ? 'true' : 'false'">Match queue</button><button t-if="state.journalBlocked" type="button" class="btn btn-outline-secondary" t-on-click="exportEvidence">Export original journal evidence</button></div><div t-if="state.board" class="sf-columns mt-3" t-att-class="'sf-columns mt-3 ' + (state.match &amp;&amp; !state.queueOpen ? 'sf-single' : '')">
   <aside aria-label="Next-match queue" t-if="!state.match || state.queueOpen"><h2>Next matches</h2>
    <t t-foreach="state.board.queue" t-as="m" t-key="m.id"><div class="sf-card">
     <strong><t t-esc="eventTime(m.start)"/></strong><p><t t-esc="m.home"/> vs <t t-esc="m.away"/></p>
     <p>Result: <t t-esc="m.result_state"/> | Officials: <t t-esc="m.coverage.state"/></p>
     <button class="btn btn-outline-primary" t-on-click="() =&gt; this.openMatch(m.id)" t-att-disabled="state.busy" type="button" t-att-data-match-id="m.id">Open match</button>
    </div></t>
   </aside>
   <section t-if="state.match" aria-label="Court result entry">
    <button t-if="locked" type="button" class="btn btn-outline-primary mb-2" t-on-click="openResultReview" t-att-disabled="state.pending.length || state.dirty">Review or correct result</button><p class="small text-muted">Edit scores before submitting. After submission, request a correction; the official result cannot be overwritten here.</p><h2><t t-esc="state.match.home_team"/> vs <t t-esc="state.match.away_team"/></h2>
    <div class="sf-status" role="status" aria-live="polite" t-att-data-save-state="statusCode"><t t-esc="status"/></div>
    <button type="button" class="btn btn-outline-primary mb-2" t-on-click="refreshStatus" t-att-disabled="state.busy || !state.match">Check server result status</button><p t-if="state.match.review_required" class="alert alert-warning">Coordinator hold: disputed or abandoned evidence must be resolved before submission.</p><p t-if="state.match.closed" class="alert alert-info">Abandonment confirmed. No official score was created.</p><details class="sf-card"><summary>Lineups and officials</summary>
     <p t-if="!state.match.lineups.length">Lineups not checked: no match sheets available. Contact the coordinator.</p>
     <t t-foreach="state.match.lineups" t-as="sheet" t-key="sheet.id"><details><summary><t t-esc="sheet.name"/>: <t t-esc="sheet.state"/></summary><ul><t t-foreach="sheet.players" t-as="player" t-key="player_index"><li><t t-esc="player"/></li></t></ul></details></t>
     <t t-foreach="state.board.queue.filter(m =&gt; m.id === state.match.match_id)" t-as="current" t-key="current.id">
      <p t-if="current.deviation &amp;&amp; current.operational_state !== 'as_published'" class="alert alert-warning" role="status"><strong><t t-esc="current.deviation.type"/></strong>: <t t-esc="current.deviation.reason"/></p><p>Official readiness: <t t-esc="current.coverage.state"/></p>
      <t t-foreach="current.officials" t-as="official" t-key="official_index"><p><t t-esc="official.role"/>: <t t-esc="official.name"/> | Accepted: <t t-esc="official.accepted"/> | Eligible: <t t-esc="official.eligible"/> | Present: <t t-esc="official.present"/></p></t>
     </t>
    </details>
    <fieldset t-att-disabled="locked || state.busy || state.conflict" class="sf-card">
     <legend>Scores</legend><div class="d-flex gap-3 flex-wrap">
      <label>Home<div class="d-flex gap-2"><button class="btn btn-outline-secondary" t-on-click="() =&gt; this.score('home', -1)" t-att-disabled="state.match.mode !== 'aggregate'" aria-label="Decrease home score" type="button">−</button>
       <input type="number" min="0" max="100000" class="sf-score form-control" t-att-value="state.draft.home" t-on-input="onHomeScore" t-att-readonly="state.match.mode !== 'aggregate'" aria-label="Home score" inputmode="numeric" step="1"/>
       <button class="btn btn-outline-secondary" t-on-click="() =&gt; this.score('home', 1)" t-att-disabled="state.match.mode !== 'aggregate'" aria-label="Increase home score" type="button">+</button></div></label>
      <label>Away<div class="d-flex gap-2"><button class="btn btn-outline-secondary" t-on-click="() =&gt; this.score('away', -1)" t-att-disabled="state.match.mode !== 'aggregate'" aria-label="Decrease away score" type="button">−</button>
       <input type="number" min="0" max="100000" class="sf-score form-control" t-att-value="state.draft.away" t-on-input="onAwayScore" t-att-readonly="state.match.mode !== 'aggregate'" aria-label="Away score" inputmode="numeric" step="1"/>
       <button class="btn btn-outline-secondary" t-on-click="() =&gt; this.score('away', 1)" t-att-disabled="state.match.mode !== 'aggregate'" aria-label="Increase away score" type="button">+</button></div></label>
     </div>
     <div t-if="state.match.mode !== 'aggregate'" class="mt-3"><h3>Sets / periods</h3>
      <t t-foreach="state.draft.periods" t-as="period" t-key="period_index"><div class="d-flex gap-2 align-items-center mb-2 flex-wrap">
       <span><t t-esc="period_index + 1"/></span>
       <label>Home<input type="number" min="0" class="form-control" t-att-value="period.home" t-on-change="(ev) =&gt; this.periodScore(period_index, 'home', ev)"/></label>
       <label>Away<input type="number" min="0" class="form-control" t-att-value="period.away" t-on-change="(ev) =&gt; this.periodScore(period_index, 'away', ev)"/></label>
       <button class="btn btn-outline-danger" t-on-click="() =&gt; this.removePeriod(period_index)" t-att-aria-label="'Remove period ' + (period_index + 1)" type="button">Remove</button>
      </div></t><button class="btn btn-outline-primary" t-on-click="addPeriod" t-att-disabled="state.draft.periods.length &gt;= state.match.max_periods" type="button">Add set / period</button>
     </div>
     <label><input type="checkbox" t-model="state.draft.zero_confirmed" t-on-change="edited"/> Confirm intended 0–0 result</label>
    <details class="mt-3"><summary>Exception or correction reason</summary><label class="d-block mt-3">Outcome<select class="form-select" t-model="state.draft.outcome" t-on-change="edited"><option value="normal">Normal</option><option value="interrupted">Interrupted: save for resumption</option><option value="abandoned">Abandoned: coordinator decision required</option><option value="forfeit_home">Home forfeits</option><option value="forfeit_away">Away forfeits</option><option value="disputed">Disputed: coordinator review required</option></select></label>
     <label class="d-block">Reason<textarea class="form-control" maxlength="2000" t-model="state.draft.reason" t-on-input="edited"/></label>
     </details></fieldset>
    <div class="d-flex flex-wrap gap-2">
     <button class="btn btn-outline-secondary" t-on-click="() =&gt; this.command('save')" t-att-disabled="locked || state.busy || state.conflict" type="button">Save draft</button>

     <button class="btn btn-primary" t-on-click="() =&gt; this.command('submit')" t-att-disabled="locked || state.busy || state.conflict || state.match.review_required || ['interrupted','abandoned','disputed'].includes(state.draft.outcome) || state.journalBlocked" type="button">Submit result</button>
     <button t-if="state.pending.length" class="btn btn-outline-primary" t-on-click="sync" t-att-disabled="state.busy || !state.pending.length || state.conflict" type="button">Synchronise queued work</button>

     <button class="btn btn-outline-secondary" t-on-click="nextMatch" t-att-disabled="state.pending.length || state.dirty || state.busy" type="button">Next match</button>
    </div>
    <details t-if="state.match.undo_available || state.pending.length || state.conflict || state.storageFailed || state.journalBlocked" class="sf-disclosure"><summary>Save and recovery options</summary>
     <button class="btn btn-outline-secondary" t-on-click="() =&gt; this.command('undo')" t-att-disabled="locked || state.busy || !state.match.undo_available || state.pending.length || state.conflict" type="button">Undo last server save</button>
     <button class="btn btn-outline-secondary" t-on-click="exportEvidence" type="button">Export recovery evidence</button>
    </details>
    <div t-if="state.conflict" class="sf-card sf-hard mt-3"><h3>Resolve save conflict</h3><p>Keep local evidence. Never merge scores automatically.</p>
     <button class="btn btn-outline-danger" t-on-click="reconcile" type="button">Export local evidence and reload server draft</button>
     <button class="btn btn-outline-primary" t-on-click="acknowledge" t-att-disabled="state.pending.length || locked" type="button">Acknowledge changed context with reason</button>
    </div>
   </section>
  </div>
 </main>
</t>
<t t-name="sports_federation_live_workspace.Plan">
 <main class="sf-live-workspace" t-ref="visualRoot">
  <h1>Visual planning</h1><div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/><button type="button" class="btn btn-outline-danger ms-2" t-on-click="refresh" t-att-disabled="state.busy">Retry loading</button></div>
  <t t-if="state.data">
  <section class="sf-card" data-visual-timeline="1"><h2>Court and time planning</h2><p>Choose a fixture, then select a destination with click, Enter or Space. Arrow keys navigate slots. Dragging uses the same assessed preview; it never applies immediately.</p><div t-if="editable" class="d-flex gap-2 flex-wrap mb-3" aria-label="Unassigned fixtures"><button t-foreach="state.data.unassigned" t-as="fixture" t-key="fixture.id" type="button" class="btn btn-outline-secondary" draggable="true" t-on-dragstart="(event) =&gt; this.dragFixture(event,fixture.id)" t-on-click="() =&gt; this.selectFixture(fixture.id)" t-att-disabled="state.busy" t-att-data-fixture="fixture.id"><t t-esc="fixture.name"/> (unassigned)</button></div><label for="visual-fixture">Fixture to move</label><select id="visual-fixture" class="form-select mb-3" t-att-value="state.fixture" t-on-change="fixtureChanged" t-att-disabled="!editable || state.busy"><option value="">Choose fixture</option><t t-foreach="state.data.fixtures.filter(f =&gt; f.allocated)" t-as="fixture" t-key="fixture.id"><option t-att-value="fixture.id" t-att-selected="fixtureSelected(fixture.id)"><t t-esc="fixture.name"/></option></t></select><div class="sf-timeline" role="region" aria-label="Court and time destinations" tabindex="0"><table class="table"><thead><tr><th>Start (UTC)</th><th t-foreach="courts" t-as="court" t-key="court.id"><t t-esc="court.name"/></th></tr></thead><tbody><tr t-foreach="times" t-as="time" t-key="time"><th><t t-esc="eventTime(time)"/></th><td t-foreach="courts" t-as="court" t-key="court.id" t-on-dragover="dragOver" t-on-drop="(event) =&gt; this.dropFixture(event, this.slotAt(court.id,time))"><t t-set="slot" t-value="slotAt(court.id,time)"/><t t-if="slot"><t t-set="assigned" t-value="assignment(slot)"/><button t-if="assigned" type="button" class="btn btn-outline-secondary w-100 mb-1" t-att-draggable="editable" t-on-dragstart="(event) =&gt; this.dragFixture(event,assigned.fixture_id)" t-on-click="() =&gt; this.selectFixture(assigned.fixture_id)" t-att-disabled="!editable || state.busy" t-att-data-fixture="assigned.fixture_id"><t t-esc="fixtureName(assigned.fixture_id)"/> <span t-if="state.data.methods[assigned.fixture_id] !== 'automatic'">(pinned)</span></button><button type="button" data-destination-button="1" t-att-data-slot="slot.id" t-att-class="'btn w-100 ' + (destination(slot) ? destination(slot).valid ? 'btn-outline-success' : 'btn-outline-danger' : 'btn-outline-secondary')" t-att-aria-disabled="(!editable || !destination(slot) || !destination(slot).valid || state.busy) ? 'true' : 'false'" t-att-aria-label="slotName(slot.id) + ': ' + destinationLabel(slot)" t-on-keydown="slotKey" t-on-click="() =&gt; this.chooseSlot(slot)"><t t-esc="destinationLabel(slot)"/></button></t><t t-else="">No slot</t></td></tr></tbody></table></div><section t-if="state.selectedSlot" class="mt-3" aria-label="Destination explanation"><t t-set="selected" t-value="state.data.slots.find(s =&gt; s.id === state.selectedSlot)"/><t t-set="assessment" t-value="selected &amp;&amp; destination(selected)"/><h3 class="h6"><t t-esc="slotName(state.selectedSlot)"/></h3><t t-if="assessment"><p t-if="assessment.valid">No mandatory violation in this candidate. Missing allocations and publication checks remain separate.</p><div t-foreach="assessment.errors" t-as="issue" t-key="issue_index" class="alert alert-danger"><strong>Mandatory blocker:</strong> <t t-esc="issue.message"/><p><t t-esc="issue.hint"/></p></div><div t-foreach="assessment.warnings" t-as="issue" t-key="issue_index" class="alert alert-warning"><strong>Preference warning:</strong> <t t-esc="issue.message"/><p><t t-esc="issue.hint"/></p></div></t></section><section t-if="state.fixture and selectedFixtureIssues().length" class="alert alert-warning mt-2" aria-label="Selected fixture issues"><h3 class="h6">Selected fixture needs attention</h3><p t-foreach="selectedFixtureIssues()" t-as="issue" t-key="issue_index" t-esc="issue.message"/></section></section><div class="d-flex gap-2 mb-3"><button class="btn btn-outline-secondary" t-on-click="returnRecord" type="button">Return to schedule and review controls</button><button class="btn btn-outline-primary" t-on-click="refresh" t-att-disabled="state.busy" type="button">Refresh</button></div>
   <details class="sf-disclosure" data-planning-settings="1"><summary>Planning settings</summary><p t-if="!state.data.timezone_reviewed" class="alert alert-warning" role="status">This event timezone needs review. A calendar planner can review it from the match-day record.</p><section class="sf-card"><h2 class="h5">Review changes before applying them</h2><p><t t-esc="state.data.governance"/></p><p role="status" aria-live="polite" t-esc="state.announcement"/><p><strong>Event timezone:</strong> <t t-esc="state.data.timezone"/>. All times and rule inputs use this timezone.</p><div class="row"><div class="col-md-6"><h3 class="h6">Mandatory rules: cannot apply a violation</h3><ul><li t-foreach="state.data.hard_rules" t-as="rule" t-key="rule"><t t-esc="rule"/></li></ul></div><div class="col-md-6"><h3 class="h6">Preferences: improve quality, not permission</h3><ul><li t-foreach="state.data.preference_rules" t-as="rule" t-key="rule"><t t-esc="rule"/></li></ul></div></div></section><h2>Competition progression</h2><div class="sf-stages">
    <t t-foreach="state.data.stages" t-as="stage" t-key="stage.id"><section class="sf-card sf-stage"><h3><t t-esc="stage.name"/></h3><p><t t-esc="stage.format"/> | <t t-esc="stage.state"/></p>
     <t t-foreach="stage.next" t-as="next" t-key="next_index"><p>Ranks <t t-esc="next.rank_from"/>–<t t-esc="next.rank_to"/> → <t t-esc="state.data.stages.find(s =&gt; s.id === next.id)?.name || next.id"/></p></t>
     <t t-foreach="state.data.fixtures.filter(f =&gt; f.stage_id === stage.id)" t-as="fixture" t-key="fixture.id"><div class="sf-card"><button class="btn btn-link" t-on-click="() =&gt; this.openFixture(fixture.id)" type="button"><t t-esc="fixture.name"/></button><p>Round <t t-esc="fixture.round"/> | <t t-esc="fixture.state"/></p><p t-if="fixture.home_source">Home: <t t-esc="fixture.home_outcome"/> of <t t-esc="fixtureName(fixture.home_source)"/></p><p t-if="fixture.away_source">Away: <t t-esc="fixture.away_outcome"/> of <t t-esc="fixtureName(fixture.away_source)"/></p></div></t>
    </section></t>
   </div>
   <section class="sf-card mt-3"><h2>Fairness preferences</h2><p>Weights and preferred rest are soft preferences, not hard feasibility constraints. Previews use saved preferences; save changes before generating candidates.</p><t t-foreach="Object.keys(state.data.config)" t-as="setting" t-key="setting"><label class="d-inline-block me-3"><t t-esc="setting.replaceAll('_',' ')"/><input class="form-control" type="number" min="0" t-model.number="state.data.config[setting]" t-att-disabled="!editable"/></label></t><button t-if="editable" class="btn btn-outline-primary" t-on-click="configure" type="button">Save preferences</button></section>
   <section class="sf-card"><h2>Scheduling rules</h2><t t-foreach="state.data.constraints" t-as="c" t-key="c.id"><p><t t-esc="c.name"/> | <t t-esc="constraintName(c.kind)"/> | <t t-esc="eventTime(c.start)"/>–<t t-esc="eventTime(c.end)"/> | <t t-esc="c.minutes"/> min <button t-if="editable" class="btn btn-outline-danger" t-on-click="() =&gt; this.removeConstraint(c.id)" type="button">Remove</button></p></t>
    <fieldset t-if="editable"><legend class="h6">Add a mandatory rule</legend><label>Rule explanation<input class="form-control" t-model="state.constraint.name"/></label><label>Constraint<select class="form-select" t-model="state.constraint.kind"><option value="team_window">Team unavailable</option><option value="court_window">Court unavailable</option><option value="minimum_rest">Mandatory minimum rest for all teams</option></select></label>
     <label t-if="state.constraint.kind === 'team_window'">Team<select class="form-select" t-model="state.constraint.team_id"><option value="">Choose team</option><t t-foreach="state.data.teams" t-as="team" t-key="team.id"><option t-att-value="team.id"><t t-esc="team.name"/></option></t></select></label>
     <label t-if="state.constraint.kind === 'court_window'">Court<select class="form-select" t-model="state.constraint.court_id"><option value="">Choose court</option><t t-foreach="courts" t-as="court" t-key="court.id"><option t-att-value="court.id"><t t-esc="court.name"/></option></t></select></label>
     <label t-if="state.constraint.kind !== 'minimum_rest'">Start (event time)<input type="datetime-local" class="form-control" t-model="state.constraint.start"/></label><label t-if="state.constraint.kind !== 'minimum_rest'">End (event time)<input type="datetime-local" class="form-control" t-model="state.constraint.end"/></label><label t-if="state.constraint.kind === 'minimum_rest'">Rest minutes<input type="number" class="form-control" t-model.number="state.constraint.minutes"/></label><button class="btn btn-primary" t-on-click="addConstraint" type="button">Add constraint</button>
    </fieldset>
   </section>
   </details><p><strong><t t-esc="state.data.schedule.name"/></strong> | <t t-esc="scheduleStateLabel(state.data.schedule.state)"/> | Revision <t t-esc="state.data.schedule.revision"/></p>
   <div t-if="editable" class="d-flex gap-2 mt-3"><button class="btn btn-primary" t-on-click="() =&gt; this.preview('regenerate')" t-att-disabled="state.busy" type="button">Preview automatic schedule</button><button class="btn btn-outline-danger" t-on-click="() =&gt; this.preview('unassign')" t-att-disabled="!state.fixture || state.busy" type="button">Remove selected fixture</button></div>
   <section class="sf-card sf-hard" t-if="state.data.explanation.validation.errors.length"><h2>Blocking issues</h2><t t-foreach="state.data.explanation.validation.errors" t-as="e" t-key="e_index"><p><t t-esc="e.message"/></p></t><p t-if="!state.data.explanation.validation.errors.length">No hard failures in allocated fixtures.</p></section>
   <details class="sf-disclosure" t-if="state.data.explanation.validation.warnings.length"><summary>Scheduling warnings</summary><section class="sf-card sf-warning"><h2>Fairness warnings</h2><t t-foreach="state.data.explanation.validation.warnings" t-as="w" t-key="w_index"><p><t t-esc="w.message"/></p></t><p>Fairness penalty (lower is better): <t t-esc="state.data.explanation.fairness.weighted_score"/></p></section>
   </details><section class="sf-card" t-if="state.data.explanation.unallocated.length"><h2>Why fixtures remain unallocated</h2><t t-foreach="state.data.explanation.unallocated" t-as="u" t-key="u.fixture_id"><details><summary><t t-esc="fixtureName(u.fixture_id)"/></summary><p><t t-esc="u.message"/></p><t t-foreach="u.attempts" t-as="attempt" t-key="attempt.slot_id"><p><t t-esc="attempt.court"/> / <t t-esc="eventTime(attempt.start)"/>: <t t-esc="attempt.errors.map(e =&gt; e.message).join('; ') || 'Feasible manual candidate'"/></p></t></details></t></section>
   <section t-if="state.preview" class="sf-card"><h2 tabindex="-1" data-preview-heading="1">Before / after</h2><section data-visual-impact="1"><h3 class="h5">Affected fixtures and progression</h3><p><t t-esc="state.preview.impact.changed_count"/> fixtures change slots.</p><p><t t-esc="state.preview.impact.note"/></p><details t-foreach="state.preview.impact.groups" t-as="group" t-key="group.kind" open="open"><summary><t t-esc="group.label"/> (<t t-esc="group.fixtures.length"/>)</summary><ul><li t-foreach="group.fixtures" t-as="fixture" t-key="fixture.id"><button type="button" class="btn btn-link" t-on-click="() =&gt; this.openFixture(fixture.id)"><t t-esc="fixture.name"/></button></li></ul></details><p t-if="state.preview.impact.pin_changes.length" class="alert alert-warning">This explicit move changes a pin. Regeneration cannot change pins.</p></section><p>Fairness: <t t-esc="state.preview.before.fairness.weighted_score"/> → <t t-esc="state.preview.after.fairness.weighted_score"/></p><p>Unallocated: <t t-esc="state.preview.before.validation.unassigned_fixture_ids.length"/> → <t t-esc="state.preview.after.validation.unassigned_fixture_ids.length"/></p>
    <t t-foreach="state.preview.changes" t-as="change" t-key="change.fixture_id"><p><t t-esc="fixtureName(change.fixture_id)"/>: <t t-esc="slotName(change.old_slot)"/> → <t t-esc="slotName(change.new_slot)"/></p></t>
    <t t-foreach="state.preview.after.validation.errors" t-as="e" t-key="e_index"><div class="text-danger">Blocked: <t t-esc="e.message"/><p><t t-esc="e.hint"/></p></div></t><t t-foreach="state.preview.after.validation.warnings" t-as="w" t-key="w_index"><div>Warning: <t t-esc="w.message"/><p><t t-esc="w.hint"/></p></div></t>
    <label>Change reason<textarea class="form-control" t-model="state.reason"/></label><button class="btn btn-success" t-on-click="apply" t-att-disabled="!canApply" type="button">Apply exactly this preview</button>
   <details class="mt-3" data-candidate-comparison="1"><summary>Compare alternatives</summary><h3 class="h5">Compare two candidates</h3><button type="button" class="btn btn-outline-primary me-2" t-on-click="rememberCandidate" t-att-disabled="state.busy">Keep this as candidate A</button><button type="button" class="btn btn-outline-primary me-2" t-on-click="compareCandidates" t-att-disabled="state.busy || !canCompare">Compare A with current candidate</button><button type="button" class="btn btn-outline-secondary" t-on-click="chooseCandidateA" t-att-disabled="state.busy || !canCompare">Use candidate A for application</button><p t-if="state.candidateA">Candidate A: preview <t t-esc="state.candidateA.id"/>. Current: <t t-esc="state.preview.id"/>. Both must belong to the same unchanged revision.</p><t t-if="state.comparison"><p>Mandatory blockers: A <t t-esc="state.comparison.first_quality.validation.errors.length"/> / current <t t-esc="state.comparison.second_quality.validation.errors.length"/>. Preference warnings: A <t t-esc="state.comparison.first_quality.validation.warnings.length"/> / current <t t-esc="state.comparison.second_quality.validation.warnings.length"/>.</p><p>Unallocated fixtures: A <t t-esc="state.comparison.first_quality.validation.unassigned_fixture_ids.length"/> / current <t t-esc="state.comparison.second_quality.validation.unassigned_fixture_ids.length"/>. A lower penalty does not make an incomplete schedule publishable.</p><p>Weighted fairness penalty (lower is better): A <t t-esc="state.comparison.first_quality.fairness.weighted_score"/> / current <t t-esc="state.comparison.second_quality.fairness.weighted_score"/>.</p><p t-if="!state.comparison.changes.length">Both candidates have the same slot assignments.</p><p t-foreach="state.comparison.changes" t-as="change" t-key="change.fixture_id"><t t-esc="fixtureName(change.fixture_id)"/>: A <t t-esc="slotName(change.first_slot)"/> / current <t t-esc="slotName(change.second_slot)"/></p></t></details></section>
   <section t-if="state.data.schedule.state === 'published'" class="sf-card"><h2>Published history is protected</h2><p>Create a replacement, then submit for independent review and publication. Live operations must be closed first.</p><label>Amendment reason<textarea class="form-control" t-model="state.reason"/></label><button class="btn btn-primary" t-on-click="amend" t-att-disabled="!state.reason.trim() || state.busy" type="button">Create guided amendment</button></section>
  </t>
 </main>
</t>
</templates>